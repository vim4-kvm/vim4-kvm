From b1345e6b9d08bd72520aec4a38c0e42e9537a9b2 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:03:24 +0800
Subject: [PATCH] ASoC: keep recoverable link loss out of error diagnostics

An HDMI source can disappear after userspace checks readiness but before hw_params. Preserve ENOLINK so recovery remains cancellable, while reporting this normal unplug race at debug level. Keep device, format and I/O failures at error level.
---
 sound/soc/soc-utils.c |  6 ++++-
 sound/soc/test_ret.py | 51 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 sound/soc/test_ret.py

diff --git a/sound/soc/soc-utils.c b/sound/soc/soc-utils.c
index 87e9c86ca4f88..6956501e610f7 100644
--- a/sound/soc/soc-utils.c
+++ b/sound/soc/soc-utils.c
@@ -35,7 +35,11 @@ int snd_soc_ret(const struct device *dev, int ret, const char *fmt, ...)
 		vaf.fmt = fmt;
 		vaf.va = &args;
 
-		dev_err(dev, "ASoC error (%d): %pV", ret, &vaf);
+		/* A disconnected external audio link is recoverable source churn. */
+		if (ret == -ENOLINK)
+			dev_dbg(dev, "ASoC link unavailable (%d): %pV", ret, &vaf);
+		else
+			dev_err(dev, "ASoC error (%d): %pV", ret, &vaf);
 		va_end(args);
 	}
 
diff --git a/sound/soc/test_ret.py b/sound/soc/test_ret.py
new file mode 100644
index 0000000000000..3c94261230da8
--- /dev/null
+++ b/sound/soc/test_ret.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Exercise the actual ASoC return handler across source loss and device faults."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+source = Path(__file__).with_name('soc-utils.c').read_text()
+function = source[source.index('int snd_soc_ret('):source.index('EXPORT_SYMBOL_GPL(snd_soc_ret);')]
+program = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdarg.h>
+#define EPROBE_DEFER 517
+#define ENOTSUPP 524
+struct device { int unused; };
+struct va_format { const char *fmt; va_list *va; };
+static int errors, debug;
+static void dev_err(const struct device *dev, const char *fmt, ...)
+{ (void)dev; (void)fmt; errors++; }
+static void dev_dbg(const struct device *dev, const char *fmt, ...)
+{ (void)dev; (void)fmt; debug++; }
+''' + function + r'''
+int main(void)
+{
+    struct device dev = { 0 };
+    int faults[] = { -EIO, -EINVAL, -ENODEV, -ERANGE, -EAGAIN };
+    unsigned int i;
+
+    /* Repeated unplug/retry preserves errno without flooding error logs. */
+    for (i = 0; i < 100; i++)
+        assert(snd_soc_ret(&dev, -ENOLINK, "hw_params %d", i) == -ENOLINK);
+    assert(errors == 0 && debug == 100);
+    for (i = 0; i < sizeof(faults) / sizeof(faults[0]); i++)
+        assert(snd_soc_ret(&dev, faults[i], "device fault") == faults[i]);
+    assert(errors == 5 && debug == 100);
+    assert(snd_soc_ret(&dev, 0, "success") == 0);
+    assert(snd_soc_ret(&dev, 7, "positive result") == 7);
+    assert(snd_soc_ret(&dev, -EPROBE_DEFER, "probe") == -EPROBE_DEFER);
+    assert(snd_soc_ret(&dev, -ENOTSUPP, "optional") == -ENOTSUPP);
+    assert(snd_soc_ret(&dev, -EOPNOTSUPP, "optional") == -EOPNOTSUPP);
+    assert(errors == 5 && debug == 100);
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    root = Path(directory)
+    (root / 'test.c').write_text(program)
+    subprocess.run(['cc', '-Wall', '-Wextra', '-Werror', str(root / 'test.c'),
+                    '-o', str(root / 'test')], check=True)
+    subprocess.run([str(root / 'test')], check=True)
+print('ASOC_ENOLINK_RETURN_AND_DIAGNOSTICS_PASS')
