 .../platform/amlogic/t7-hdmirx/test_audio.py  | 75 +++++++++++++++----
 sound/soc/soc-utils.c                         |  6 +-
 sound/soc/test_ret.py                         | 55 --------------
 4 files changed, 100 insertions(+), 102 deletions(-)
