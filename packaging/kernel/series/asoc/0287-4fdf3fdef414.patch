-	/* An old PCM must close and renegotiate after loss or a format change. */
-	ret = rx->audio_invalid || !rx->audio_active ? -ENOLINK : 0;
+	ret = t7_hdmirx_audio_prepare_locked(dai);
 	mutex_unlock(&rx->audio_lock);
