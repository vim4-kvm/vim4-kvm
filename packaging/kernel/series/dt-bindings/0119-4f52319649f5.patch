From 4f52319649f5223fecb481323172eadaf22af3b0 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 00:00:00 +0200
Subject: [PATCH] ASoC: dt-bindings: amlogic,g12a-tohdmitx: add T7

The T7 tohdmitx control matches S4.
Add the T7 compatible with the S4 and G12A fallbacks.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../devicetree/bindings/sound/amlogic,g12a-tohdmitx.yaml      | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/amlogic,g12a-tohdmitx.yaml b/Documentation/devicetree/bindings/sound/amlogic,g12a-tohdmitx.yaml
index 016d3cd3eb033..e827b78ea32e0 100644
--- a/Documentation/devicetree/bindings/sound/amlogic,g12a-tohdmitx.yaml
+++ b/Documentation/devicetree/bindings/sound/amlogic,g12a-tohdmitx.yaml
@@ -25,6 +25,10 @@ properties:
               - amlogic,s4-tohdmitx
               - amlogic,sm1-tohdmitx
           - const: amlogic,g12a-tohdmitx
+      - items:
+          - const: amlogic,t7-tohdmitx
+          - const: amlogic,s4-tohdmitx
+          - const: amlogic,g12a-tohdmitx
 
   reg:
     maxItems: 1
