@@ -20,6 +20,13 @@ properties:
   compatible:
     const: amlogic,t7-hdmi-tx
 
+  amlogic,boot-handoff:
+    type: boolean
+    description: |
+      Fixed 1080p firmware handoff. Read TOP/COR through the firmware SMC ABI;
+      do not reset or program TX, PHY, DDC, audio, or clocks. Only valid with
+      the dedicated T7 display-handoff consumer, not normal meson modesetting.
+
   reg:
     items:
       - description: TOP registers
diff --git a/Documentation/devicetree/bindings/display/amlogic,t7-display-handoff.yaml b/Documentation/devicetree/bindings/display/amlogic,t7-display-handoff.yaml
new file mode 100644
index 0000000000000..3c1e919e698d9
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/amlogic,t7-display-handoff.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/amlogic,t7-display-handoff.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic T7 fixed firmware display handoff experiment
+
+maintainers:
+  - localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
+
+description: |
+  Dedicated 1080p60 RGB888 OSD1 handoff. Firmware must have initialized the
+  complete display path and reserved both logo frames at 3f800000/c00000.
+  The normal VPU and simple-framebuffer nodes must remain disabled. VDIN
+  must use disjoint capture resources. Only OSD1 address and VENC interrupt
+  control may be written; clocks, reset, VPP, timing and PHY stay unchanged.
+
+properties:
+  compatible:
+    const: amlogic,t7-display-handoff
+  reg:
+    items:
+      - description: OSD1 control and linear MIF, ff006840/80
+      - description: VENC interrupt and timing readback, ff006db8/108
+  reg-names:
+    items:
+      - const: osd1
+      - const: venc
+  interrupts:
+    maxItems: 1
+  memory-region:
+    maxItems: 1
+    description: Reserved no-map firmware logo frames, 3f800000/c00000
+  clocks:
+    items:
+      - description: VPU interrupt and OSD register gate
+      - description: VPU clock, reference only
+      - description: VAPB clock, reference only
+      - description: TX APB clock
+      - description: HDMI PLL, reference only
+  power-domains:
+    items:
+      - description: VPU HDMI island
+      - description: VI CLK1 island
+      - description: VI CLK2 island
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Firmware-configured HDMI TX bridge input
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - memory-region
+  - clocks
+  - power-domains
+  - port
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/amlogic,t7-vdin-test.yaml b/Documentation/devicetree/bindings/media/amlogic,t7-vdin-test.yaml
index 72e740eed8fed..e396576c95774 100644
--- a/Documentation/devicetree/bindings/media/amlogic,t7-vdin-test.yaml
+++ b/Documentation/devicetree/bindings/media/amlogic,t7-vdin-test.yaml
@@ -4,21 +4,29 @@
 $id: http://devicetree.org/schemas/media/amlogic,t7-vdin-test.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Amlogic T7 exclusive VDIN snapshot experiment
+title: Amlogic T7 VDIN capture experiment
 
 maintainers:
   - localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
 
 description: |
-  Temporary experimental capture node owning the whole VPU register window.
-  The display VPU node must remain disabled. This binding is restricted to the
-  dedicated receiver test DTB, pending a shared VPU and V4L2 capture integration.
+  Experimental capture node describing the complete VPU register window.
+  The normal display VPU must remain disabled.
+  Only the split profile permits the fixed OSD1 display handoff experiment;
+  the display consumer must not touch reset or write-arbitration registers.
 
 properties:
   compatible:
     const: amlogic,t7-vdin-test
   reg:
     maxItems: 1
+  amlogic,split-vcbus:
+    type: boolean
+    description: |
+      Reserve and map only four capture windows inside VCBUS rather than
+      reserving the complete aperture: VDIN0/HDR2 (ff004800/400), VPU_SW_RESET
+      (ff009c80/4), write arbitration (ff009e88/8), and VDIN top/double-write
+      (ff01042c/c). No other capture registers may be accessed in this profile.
   interrupts:
     maxItems: 1
     description: VDIN0 memory write completion
