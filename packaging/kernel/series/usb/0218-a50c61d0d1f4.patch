From a50c61d0d1f4f6da5f171fdc2f136eb9dbaf34b6 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:52:53 +0800
Subject: [PATCH] usb: fix one-direction UAC2 runtime and retire CRG requests
 before unbind

---
 drivers/usb/gadget/function/f_uac2.c          | 16 +--
 .../usb/gadget/function/test_uac2_controls.py | 99 +++++++++++++++++++
 drivers/usb/gadget/function/u_audio.c         |  9 +-
 drivers/usb/gadget/udc/crg/README.md          |  5 +
 drivers/usb/gadget/udc/crg/crg_udc.c          | 19 ++++
 .../usb/gadget/udc/crg/test_probe_failures.py | 22 ++++-
 6 files changed, 156 insertions(+), 14 deletions(-)
 create mode 100644 drivers/usb/gadget/function/test_uac2_controls.py

diff --git a/drivers/usb/gadget/function/f_uac2.c b/drivers/usb/gadget/function/f_uac2.c
index d8cf710085a05..469d563e2ddc8 100644
--- a/drivers/usb/gadget/function/f_uac2.c
+++ b/drivers/usb/gadget/function/f_uac2.c
@@ -1532,21 +1532,23 @@ in_rq_cur(struct usb_function *fn, const struct usb_ctrlrequest *cr)
 	u8 entity_id = (w_index >> 8) & 0xff;
 	u8 control_selector = w_value >> 8;
 	int value = -EOPNOTSUPP;
-	u32 p_srate, c_srate;
-
-	u_audio_get_playback_srate(agdev, &p_srate);
-	u_audio_get_capture_srate(agdev, &c_srate);
+	u32 srate;
 
 	if ((entity_id == USB_IN_CLK_ID) || (entity_id == USB_OUT_CLK_ID)) {
+		/* Disabled directions have no initialized runtime or sample-rate lock. */
+		if ((entity_id == USB_IN_CLK_ID && !opts->p_chmask) ||
+		    (entity_id == USB_OUT_CLK_ID && !opts->c_chmask))
+			return -EOPNOTSUPP;
 		if (control_selector == UAC2_CS_CONTROL_SAM_FREQ) {
 			struct cntrl_cur_lay3 c;
 
 			memset(&c, 0, sizeof(struct cntrl_cur_lay3));
 
 			if (entity_id == USB_IN_CLK_ID)
-				c.dCUR = cpu_to_le32(p_srate);
-			else if (entity_id == USB_OUT_CLK_ID)
-				c.dCUR = cpu_to_le32(c_srate);
+				u_audio_get_playback_srate(agdev, &srate);
+			else
+				u_audio_get_capture_srate(agdev, &srate);
+			c.dCUR = cpu_to_le32(srate);
 
 			value = min_t(unsigned int, w_length, sizeof(c));
 			memcpy(req->buf, &c, value);
diff --git a/drivers/usb/gadget/function/test_uac2_controls.py b/drivers/usb/gadget/function/test_uac2_controls.py
new file mode 100644
index 0000000000000..f5bb3c3acb698
--- /dev/null
+++ b/drivers/usb/gadget/function/test_uac2_controls.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Compile actual UAC2 GET_CUR handling; reject access to disabled runtimes."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+source = Path(__file__).with_name('f_uac2.c').read_text()
+start = source.index('static int\nin_rq_cur(')
+function = source[start:source.index('\n}\n', start) + 3]
+ids = '\n'.join(row for row in source.splitlines()
+                if row.startswith('#define USB_') and '_ID' in row)
+harness = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef int16_t s16;
+typedef uint32_t u32;
+#define le16_to_cpu(x) (x)
+#define cpu_to_le16(x) (x)
+#define cpu_to_le32(x) (x)
+#define min_t(t, a, b) ((t)(a) < (t)(b) ? (t)(a) : (t)(b))
+#define dev_err(...) ((void)0)
+#define FUIN_EN(opts) 0
+#define FUOUT_EN(opts) 0
+#define UAC2_CS_CONTROL_SAM_FREQ 1
+#define UAC2_CS_CONTROL_CLOCK_VALID 2
+#define UAC_FU_MUTE 1
+#define UAC_FU_VOLUME 2
+struct usb_request { void *buf; };
+struct usb_composite_dev { struct usb_request *req; };
+struct usb_configuration { struct usb_composite_dev *cdev; };
+struct usb_function { struct usb_configuration *config; };
+struct usb_ctrlrequest { u16 wLength, wIndex, wValue; };
+struct f_uac2_opts { int p_chmask, c_chmask; };
+struct g_audio { struct f_uac2_opts opts; };
+struct cntrl_cur_lay3 { u32 dCUR; };
+struct cntrl_cur_lay2 { u16 wCUR; };
+static struct { u8 bClockID; } in_clk_src_desc={5}, out_clk_src_desc={6};
+static struct { u8 bUnitID; } in_feature={7}, out_feature={8};
+#define in_feature_unit_desc (&in_feature)
+#define out_feature_unit_desc (&out_feature)
+static struct g_audio audio;
+static unsigned reads;
+static struct g_audio *func_to_g_audio(struct usb_function *fn) { (void)fn; return &audio; }
+static struct f_uac2_opts *g_audio_to_uac2_opts(struct g_audio *a) { return &a->opts; }
+static int u_audio_get_playback_srate(struct g_audio *a, u32 *v) {
+    assert(a->opts.p_chmask); reads++; *v=48000; return 0;
+}
+static int u_audio_get_capture_srate(struct g_audio *a, u32 *v) {
+    assert(a->opts.c_chmask); reads++; *v=44100; return 0;
+}
+static void u_audio_get_mute(struct g_audio *a, unsigned p, unsigned *v) {
+    (void)a; (void)p; (void)v; assert(0);
+}
+static void u_audio_get_volume(struct g_audio *a, unsigned p, s16 *v) {
+    (void)a; (void)p; (void)v; assert(0);
+}
+'''
+checks = r'''
+int main(void) {
+    u8 payload[8];
+    struct usb_request req = {.buf=payload};
+    struct usb_composite_dev cdev = {.req=&req};
+    struct usb_configuration config = {.cdev=&cdev};
+    struct usb_function fn = {.config=&config};
+    for (int playback=0; playback<2; playback++) for (int capture=0; capture<2; capture++) {
+        audio.opts.p_chmask=playback*3; audio.opts.c_chmask=capture*3;
+        for (unsigned direction=0; direction<2; direction++) for (unsigned selector=1; selector<=3; selector++) {
+            const unsigned id=direction ? USB_OUT_CLK_ID : USB_IN_CLK_ID;
+            const int enabled=direction ? capture : playback;
+            struct usb_ctrlrequest cr={.wLength=8, .wIndex=id<<8, .wValue=selector<<8};
+            reads=0; memset(payload, 0xa5, sizeof(payload));
+            int result=in_rq_cur(&fn, &cr);
+            if (!enabled || selector==3) {
+                assert(result==-EOPNOTSUPP && reads==0 && payload[0]==0xa5);
+            } else if (selector==UAC2_CS_CONTROL_SAM_FREQ) {
+                u32 value; memcpy(&value, payload, sizeof(value));
+                assert(result==4 && reads==1 && value==(direction ? 44100u : 48000u));
+                assert(payload[4]==0xa5);
+                cr.wLength=2; memset(payload, 0xa5, sizeof(payload));
+                assert(in_rq_cur(&fn, &cr)==2 && payload[2]==0xa5);
+            } else {
+                assert(result==1 && reads==0 && payload[0]==1 && payload[1]==0xa5);
+            }
+        }
+    }
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='uac2-controls-') as directory:
+    path = Path(directory)
+    (path / 'test.c').write_text(harness + ids + '\n' + function + checks)
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
+print('PASS: playback/capture-only UAC2 rates, disabled clocks and short responses')
diff --git a/drivers/usb/gadget/function/u_audio.c b/drivers/usb/gadget/function/u_audio.c
index f0ee83abcebc7..3d5362153c529 100644
--- a/drivers/usb/gadget/function/u_audio.c
+++ b/drivers/usb/gadget/function/u_audio.c
@@ -1216,6 +1216,11 @@ int g_audio_setup(struct g_audio *g_audio, const char *pcm_name,
 		return -ENOMEM;
 	g_audio->uac = uac;
 	uac->audio_dev = g_audio;
+	/* Both stop paths run on disconnect, including disabled directions. */
+	spin_lock_init(&uac->c_prm.lock);
+	spin_lock_init(&uac->p_prm.lock);
+	uac->c_prm.uac = uac;
+	uac->p_prm.uac = uac;
 
 	params = &g_audio->params;
 	p_chmask = params->p_chmask;
@@ -1224,8 +1229,6 @@ int g_audio_setup(struct g_audio *g_audio, const char *pcm_name,
 	if (c_chmask) {
 		struct uac_rtd_params *prm = &uac->c_prm;
 
-		spin_lock_init(&prm->lock);
-		uac->c_prm.uac = uac;
 		prm->max_psize = g_audio->out_ep_maxpsize;
 		prm->srate = params->c_srates[0];
 
@@ -1248,8 +1251,6 @@ int g_audio_setup(struct g_audio *g_audio, const char *pcm_name,
 	if (p_chmask) {
 		struct uac_rtd_params *prm = &uac->p_prm;
 
-		spin_lock_init(&prm->lock);
-		uac->p_prm.uac = uac;
 		prm->max_psize = g_audio->in_ep_maxpsize;
 		prm->srate = params->p_srates[0];
 
diff --git a/drivers/usb/gadget/udc/crg/README.md b/drivers/usb/gadget/udc/crg/README.md
index 3a7c4e7def952..6ece4f3a8d096 100644
--- a/drivers/usb/gadget/udc/crg/README.md
+++ b/drivers/usb/gadget/udc/crg/README.md
@@ -33,3 +33,8 @@ python3 drivers/usb/gadget/udc/crg/test_probe_failures.py
 The tests compile actual driver functions with controlled completions/allocation
 failures. They cover EP0 ownership across SETUP/reset/unbind, allocation failures
 and IRQ error propagation; they do not emulate the controller or validate DMA.
+
+Disconnect halts DMA and rejects new submissions before retiring outstanding
+requests while function completion contexts still exist. Waiting until
+udc_stop is too late: the gadget core has already unbound the functions then.
+Class-specific EP0 transfers can remain pending without composite setup_pending.
diff --git a/drivers/usb/gadget/udc/crg/crg_udc.c b/drivers/usb/gadget/udc/crg/crg_udc.c
index dd2e553d4229a..ddc9bf498fee1 100644
--- a/drivers/usb/gadget/udc/crg/crg_udc.c
+++ b/drivers/usb/gadget/udc/crg/crg_udc.c
@@ -2107,6 +2107,11 @@ crg_udc_ep_queue(struct usb_ep *_ep, struct usb_request *_req,
 
 	spin_lock_irqsave(&crg_udc->udc_lock, flags);
 
+	if (!crg_udc->pullup_enabled) {
+		spin_unlock_irqrestore(&crg_udc->udc_lock, flags);
+		return -ESHUTDOWN;
+	}
+
 	if (!udc_ep_ptr->first_trb ||
 		!udc_req_ptr->usb_req.complete ||
 		!udc_req_ptr->usb_req.buf ||
@@ -3033,6 +3038,8 @@ static int crg_gadget_pullup(struct usb_gadget *g, int is_on)
 
 	spin_lock_irqsave(&udc->udc_lock, flags);
 	udc->pullup_enabled = !!is_on;
+	if (!is_on)
+		udc->device_state = USB_STATE_ATTACHED;
 	if (is_on) {
 		/* RUN also enables port events when VBUS arrives after binding. */
 		crg_udc_start(udc);
@@ -3040,8 +3047,20 @@ static int crg_gadget_pullup(struct usb_gadget *g, int is_on)
 	}
 	spin_unlock_irqrestore(&udc->udc_lock, flags);
 	if (!is_on) {
+		unsigned int i;
+
 		if (!crg_stop_controller(udc))
 			return -ETIMEDOUT;
+		/*
+		 * The gadget core unbinds functions before udc_stop(). Retire even
+		 * function-owned EP0 transfers here, while their completion context
+		 * still exists, after the controller has stopped accessing DMA.
+		 */
+		spin_lock_irqsave(&udc->udc_lock, flags);
+		for (i = 0; i < ARRAY_SIZE(udc->udc_ep); i++)
+			if (udc->udc_ep[i].desc)
+				nuke(&udc->udc_ep[i], -ESHUTDOWN, flags);
+		spin_unlock_irqrestore(&udc->udc_lock, flags);
 		usb_gadget_set_state(g, USB_STATE_NOTATTACHED);
 	}
 	return 0;
diff --git a/drivers/usb/gadget/udc/crg/test_probe_failures.py b/drivers/usb/gadget/udc/crg/test_probe_failures.py
index 8228899446a6f..1319af5c71933 100644
--- a/drivers/usb/gadget/udc/crg/test_probe_failures.py
+++ b/drivers/usb/gadget/udc/crg/test_probe_failures.py
@@ -32,7 +32,8 @@ typedef uint32_t u32;
 #define CRG_DEBUG(...) do {} while (0)
 #define CRG_ERROR(...) do {} while (0)
 #define container_of(p, t, m) ((t *)((char *)(p) - offsetof(t, m)))
-enum { USB_STATE_NOTATTACHED, USB_STATE_CONFIGURED };
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+enum { USB_STATE_NOTATTACHED, USB_STATE_ATTACHED, USB_STATE_CONFIGURED };
 enum { USB_SPEED_UNKNOWN, USB_SPEED_FULL, USB_SPEED_HIGH,
        USB_SPEED_SUPER, USB_SPEED_SUPER_PLUS };
 struct usb_request { int unused; };
@@ -40,14 +41,16 @@ struct usb_ep { int unused; };
 struct crg_udc_request { struct usb_request usb_req; };
 struct crg_uccr { u32 control, capability, config0; };
 struct usb_gadget { int max_speed, irq, state; };
+struct crg_udc_ep { struct usb_ep usb_ep; bool desc; int pending; };
 struct crg_gadget_dev {
     struct crg_uccr *uccr;
     struct usb_gadget gadget;
-    struct { struct usb_ep usb_ep; } udc_ep[1];
+    struct crg_udc_ep udc_ep[32];
     struct crg_udc_request *status_req;
     int irq;
     int udc_lock;
     bool pullup_enabled;
+    int device_state;
 };
 struct platform_device { int unused; };
 static struct crg_gadget_dev crg_udc_dev;
@@ -55,11 +58,17 @@ static int fail_at, stage, irq_result, request_result, irq_requests;
 static struct crg_udc_request status_request;
 static bool stop_ok = true;
 static int starts;
+static bool halted, unbound;
+static int retired;
 #define spin_lock_irqsave(lock, flags) do { (void)(lock); (flags) = 0; } while (0)
 #define spin_unlock_irqrestore(lock, flags) do { (void)(lock); (void)(flags); } while (0)
 static void crg_udc_start(struct crg_gadget_dev *d) { (void)d; starts++; }
 static int g_dnl_board_usb_cable_connected(void) { return 1; }
-static bool crg_stop_controller(struct crg_gadget_dev *d) { (void)d; return stop_ok; }
+static bool crg_stop_controller(struct crg_gadget_dev *d) { (void)d; halted = stop_ok; return stop_ok; }
+static void nuke(struct crg_udc_ep *ep, int status, unsigned long flags) {
+    (void)flags; assert(status == -ESHUTDOWN && halted && !unbound);
+    retired += ep->pending; ep->pending = 0;
+}
 static void usb_gadget_set_state(struct usb_gadget *g, int state) { g->state = state; }
 static u32 reg_read(u32 *p) { return *p; }
 static void reg_write(u32 *p, u32 v) { *p = v; }
@@ -114,14 +123,21 @@ int main(void)
     request_result = 0;
     assert(crg_gadget_irq_init(&device) == 0 && irq_requests == 2);
     udc.gadget.state = USB_STATE_CONFIGURED;
+    udc.udc_ep[0].desc = udc.udc_ep[2].desc = true;
+    udc.udc_ep[0].pending = 1; /* class transfer not tracked by composite */
+    udc.udc_ep[2].pending = 3;
     assert(crg_gadget_pullup(&udc.gadget, 0) == 0);
     assert(!udc.pullup_enabled && udc.gadget.state == USB_STATE_NOTATTACHED);
+    assert(retired == 4 && !udc.udc_ep[0].pending && !udc.udc_ep[2].pending);
+    assert(udc.device_state == USB_STATE_ATTACHED);
     assert(crg_gadget_pullup(&udc.gadget, 1) == 0);
     assert(udc.pullup_enabled && starts == 1);
     /* Binding again must not expose the previous connection's configured state. */
     assert(udc.gadget.state == USB_STATE_NOTATTACHED);
     stop_ok = false;
+    udc.udc_ep[0].pending = 1;
     assert(crg_gadget_pullup(&udc.gadget, 0) == -ETIMEDOUT);
+    assert(udc.udc_ep[0].pending == 1 && retired == 4);
     puts("CRG allocation and IRQ failure regressions passed");
     return 0;
 }
