From aa2f875bec2fc7c9a4952fccb9dcaa6fbfc4aa64 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:56:27 +0800
Subject: [PATCH] media: wave5: publish isolation metadata before sysfs
 notification

---
 drivers/media/platform/chips-media/wave5/test_isolation.py | 1 +
 drivers/media/platform/chips-media/wave5/wave5-isolation.c | 7 ++++++-
 drivers/media/platform/chips-media/wave5/wave5-vpuapi.h    | 2 +-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/chips-media/wave5/test_isolation.py b/drivers/media/platform/chips-media/wave5/test_isolation.py
index 49964767ed1ac..68985db19eda8 100644
--- a/drivers/media/platform/chips-media/wave5/test_isolation.py
+++ b/drivers/media/platform/chips-media/wave5/test_isolation.py
@@ -26,6 +26,7 @@ typedef uint32_t u32;
 typedef uint64_t u64;
 #define READ_ONCE(v) (v)
 #define WRITE_ONCE(v, x) ((v) = (x))
+#define smp_store_release(p, value) (*(p) = (value))
 #define cmpxchg(p, old, value) ({ unsigned _was = *(p); if (_was == (old)) *(p) = (value); _was; })
 #define container_of(p, type, member) ((type *)((char *)(p) - offsetof(type, member)))
 #define WAVE5_JOB_TIMEOUT_MS 5000
diff --git a/drivers/media/platform/chips-media/wave5/wave5-isolation.c b/drivers/media/platform/chips-media/wave5/wave5-isolation.c
index c3dbdfcbcf843..d9634863e6f07 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-isolation.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-isolation.c
@@ -41,6 +41,8 @@ void wave5_vpu_isolate(struct vpu_device *dev, const char *reason, u32 command)
 	get_device(dev->dev);
 	if (dev->irq >= 0)
 		disable_irq_nosync(dev->irq);
+	/* DMA guards see state 1 immediately; sysfs publishes complete metadata. */
+	smp_store_release(&dev->isolated, 2);
 	schedule_work(&dev->isolation_work);
 }
 
@@ -134,7 +136,10 @@ void wave5_vpu_isolation_init(struct vpu_device *dev)
 
 static ssize_t isolated_show(struct device *device, struct device_attribute *attr, char *buf)
 {
-	return sysfs_emit(buf, "%u\n", wave5_vpu_isolated(dev_get_drvdata(device)));
+	struct vpu_device *dev = dev_get_drvdata(device);
+
+	/* Pair with publication so readers can subsequently fetch reason/time. */
+	return sysfs_emit(buf, "%u\n", smp_load_acquire(&dev->isolated) == 2);
 }
 static DEVICE_ATTR_RO(isolated);
 
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
index 33f0c33e56fb9..90b3000b84264 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
@@ -778,7 +778,7 @@ struct vpu_device {
 	struct semaphore irq_sem; /* signal to irq_thread when interrupt happens*/
 	struct reset_control *resets;
 	spinlock_t irq_spinlock; /* protect instances list */
-	/* Quarantine is irreversible until the next boot. */
+	/* 0: normal, 1: claimed, 2: metadata published; irreversible until boot. */
 	unsigned int isolated;
 	u32 isolation_command;
 	u32 last_command;
