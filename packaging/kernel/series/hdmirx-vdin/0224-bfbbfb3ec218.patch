From bfbbfb3ec21845019d9e07503d67276952fabb27 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:01:53 -0700
Subject: [PATCH] media: reselect the active HDMI input when reenabling DDC

---
 drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c |  9 ++++++++-
 drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py | 12 ++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index f717d253ac847..87ecb1bacef48 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -349,6 +349,7 @@ static int t7_hdmirx_ddc_start(struct t7_hdmirx *rx, const u8 *edid, size_t size
 	unsigned int base = T7_RX_EDID_BASE + rx->port * T7_RX_EDID_CAPACITY;
 	unsigned int i;
 	u8 expected;
+	u32 port_sel;
 	int ret;
 
 	ret = t7_hdmirx_validate_edid(edid, size);
@@ -380,7 +381,13 @@ static int t7_hdmirx_ddc_start(struct t7_hdmirx *rx, const u8 *edid, size_t size
 	readl(rx->top + T7_RX_TOP_SW_RESET);
 	usleep_range(1000, 2000);
 	/* Enable the TOP port path used by T7's receiver initialization. */
-	writel(rx->saved_port_sel | BIT(4), rx->top + T7_RX_TOP_PORT_SEL);
+	/* A runtime DDC disable restores the pre-probe port snapshot. An active
+	 * core must reselect its PHY input as well as enabling the EDID path.
+	 */
+	port_sel = rx->saved_port_sel | BIT(4);
+	if (rx->core_active)
+		port_sel = (port_sel & ~GENMASK(2, 0)) | BIT(rx->port);
+	writel(port_sel, rx->top + T7_RX_TOP_PORT_SEL);
 	memcpy(rx->edid, edid, size);
 	rx->edid_blob.data = rx->edid;
 	rx->edid_blob.size = size;
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py b/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py
index 5bcef32339e1e..43c00d784e7dd 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py
@@ -146,6 +146,18 @@ int main(void)
         t7_hdmirx_ddc_stop(&receiver);
         assert(register_writes == writes);
     }
+    /* A running core survives DDC disable/re-enable. Reconnect must select
+     * exactly its PHY port, even after stop restored the pre-probe snapshot.
+     */
+    reset(); make_edid(data, 2); receiver.core_active=true; receiver.uhd60=true;
+    for (i=0;i<2;i++) {
+        written=verified=hpd_high=delay_calls=0;
+        assert(!t7_hdmirx_ddc_start(&receiver,data,256));
+        assert((readl(memory+T7_RX_TOP_PORT_SEL)&GENMASK(2,0))==BIT(receiver.port));
+        assert(!hpd_high);
+        t7_hdmirx_ddc_stop(&receiver);
+        assert(readl(memory+T7_RX_TOP_PORT_SEL)==0xa5a5a5a5);
+    }
     reset(); make_edid(data, 2); corrupt = true;
     assert(t7_hdmirx_ddc_start(&receiver, data, 256) == -EIO);
     assert(!receiver.ddc_active && !receiver.edid_blob.size && !hpd_high);
