From 02bc3c48e6d7eccfbf7c62a736e01c0e76d10d44 Mon Sep 17 00:00:00 2001
From: deepdream <deepdream@deepdremsMinim4.lan>
Date: Tue, 20 Oct 2026 21:25:50 -0700
Subject: [PATCH] media: t7-hdmirx: read positive sync widths from high
 counters

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 33 +++++++++++--------
 .../platform/amlogic/t7-hdmirx/test_core.py   |  8 ++---
 .../amlogic/t7-hdmirx/test_timings.py         | 13 +++++---
 3 files changed, 31 insertions(+), 23 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index 3fa81a9392c61..0d490d7c65f49 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -109,10 +109,10 @@
 #define T7_RX_COR_FRAME_TICKS	0x1888
 #define T7_RX_COR_WIDTH		0x188c
 #define T7_RX_COR_HEIGHT		0x188e
-#define T7_RX_COR_HSYNC		0x1890
-#define T7_RX_COR_HFRONT_BACK	0x1892
-#define T7_RX_COR_VSYNC		0x1898
-#define T7_RX_COR_VFRONT_BACK	0x189a
+#define T7_RX_COR_HSYNC_LOW	0x1890
+#define T7_RX_COR_HSYNC_HIGH	0x1892
+#define T7_RX_COR_VSYNC_LOW	0x1898
+#define T7_RX_COR_VSYNC_HIGH	0x189a
 #define T7_RX_COR_DPLL_CONFIG	0x1f15
 #define T7_RX_COR_DPLL_HDMI2	0x1f52
 #define T7_RX_COR_PHY_CLOCK1	0x20a3
@@ -669,10 +669,10 @@ static int t7_hdmirx_video_status(struct t7_hdmirx *rx)
 		return -ERANGE;
 	if (t7_hdmirx_core_read16(rx, T7_RX_COR_WIDTH) != (rx->uhd60 ? 3840 : 1920) ||
 	    t7_hdmirx_core_read16(rx, T7_RX_COR_HEIGHT) != (rx->uhd60 ? 2160 : 1080) ||
-	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC) +
-	    t7_hdmirx_core_read16(rx, T7_RX_COR_HFRONT_BACK) != (rx->uhd60 ? 4400 : 2200) ||
-	    t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC) +
-	    t7_hdmirx_core_read16(rx, T7_RX_COR_VFRONT_BACK) != (rx->uhd60 ? 2250 : 1125))
+	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_LOW) +
+	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH) != (rx->uhd60 ? 4400 : 2200) ||
+	    t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_LOW) +
+	    t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_HIGH) != (rx->uhd60 ? 2250 : 1125))
 		return -ERANGE;
 	ticks = t7_hdmirx_core_read16(rx, T7_RX_COR_FRAME_TICKS) |
 		(readb(rx->cor + T7_RX_COR_FRAME_TICKS + 2) << 16);
@@ -742,8 +742,11 @@ int t7_hdmirx_query_timings(struct device *dev, struct v4l2_dv_timings *timings,
 		return -ERANGE;
 	mode = rx->uhd60 ? (struct v4l2_dv_timings)V4L2_DV_BT_CEA_3840X2160P60 :
 			  (struct v4l2_dv_timings)V4L2_DV_BT_CEA_1920X1080P60;
-	hsync = t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC);
-	vsync = t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC);
+	/* Both qualified CEA modes use positive sync pulses. The low-level count
+	 * includes the active picture and porches, not the sync pulse width.
+	 */
+	hsync = t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH);
+	vsync = t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_HIGH);
 	/* Only these CEA profiles have qualified porch/polarity settings. Do not
 	 * fabricate DV timings for arbitrary modes with the same active area.
 	 */
@@ -1097,10 +1100,12 @@ static int t7_hdmirx_status(struct seq_file *s, void *unused)
 		seq_printf(s, "color_depth_code: %#x\n", readb(rx->cor + T7_RX_COR_COLOR_DEPTH));
 		seq_printf(s, "width: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_WIDTH));
 		seq_printf(s, "height: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HEIGHT));
-		seq_printf(s, "htotal: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC) +
-			   t7_hdmirx_core_read16(rx, T7_RX_COR_HFRONT_BACK));
-		seq_printf(s, "vtotal: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC) +
-			   t7_hdmirx_core_read16(rx, T7_RX_COR_VFRONT_BACK));
+		seq_printf(s, "htotal: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_LOW) +
+			   t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH));
+		seq_printf(s, "vtotal: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_LOW) +
+			   t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_HIGH));
+		seq_printf(s, "hsync_high: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH));
+		seq_printf(s, "vsync_high: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_HIGH));
 		seq_printf(s, "frame_ticks: %u\n", ticks);
 		seq_printf(s, "audio_n: %u\n", t7_hdmirx_audio_word(rx, T7_RX_COR_N));
 		seq_printf(s, "audio_cts: %u\n", t7_hdmirx_audio_word(rx, T7_RX_COR_CTS));
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
index 6552d08397966..d5207e209acbb 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
@@ -92,8 +92,8 @@ static void timing(void)
     memcpy(top + T7_RX_TOP_HPD_PWR5V, &value, 4);
     value = 1; memcpy(top + T7_RX_TOP_TMDS_ALIGN_STAT, &value, 4);
     word(0x188c, 1920); word(0x188e, 1080);
-    word(0x1890, 44); word(0x1892, 2156);
-    word(0x1898, 5); word(0x189a, 1120);
+    word(0x1890, 2156); word(0x1892, 44);
+    word(0x1898, 1120); word(0x189a, 5);
     word(0x1888, 2777780 & 0xffff); core[0x188a] = 2777780 >> 16;
     core[0x1881] = 3;
 }
@@ -154,8 +154,8 @@ int main(void)
     rx.core_active = true; timing(); rx.uhd60 = true;
     assert(t7_hdmirx_check_video(&dev) == -ERANGE);
     word(0x188c, 3840); word(0x188e, 2160);
-    word(0x1890, 88); word(0x1892, 4312);
-    word(0x1898, 10); word(0x189a, 2240);
+    word(0x1890, 4312); word(0x1892, 88);
+    word(0x1898, 2240); word(0x189a, 10);
     assert(!t7_hdmirx_check_video(&dev));
     word(0x188e, 1080);
     assert(t7_hdmirx_check_video(&dev) == -ERANGE);
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
index 103ba699575d0..3984aaf7f546b 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
@@ -77,10 +77,11 @@ static void setup(bool uhd, unsigned int ticks) {
     value = T7_RX_PHY_PLL_LOCK; memcpy(phy + T7_RX_PHY_APLL0,&value,4);
     word(T7_RX_COR_WIDTH, uhd ? 3840 : 1920);
     word(T7_RX_COR_HEIGHT, uhd ? 2160 : 1080);
-    word(T7_RX_COR_HSYNC, uhd ? 88 : 44);
-    word(T7_RX_COR_HFRONT_BACK, uhd ? 4312 : 2156);
-    word(T7_RX_COR_VSYNC, uhd ? 10 : 5);
-    word(T7_RX_COR_VFRONT_BACK, uhd ? 2240 : 1120);
+    /* Byte layout observed on hardware: positive pulse is the HIGH count. */
+    word(T7_RX_COR_HSYNC_LOW, uhd ? 4312 : 2156);
+    word(T7_RX_COR_HSYNC_HIGH, uhd ? 88 : 44);
+    word(T7_RX_COR_VSYNC_LOW, uhd ? 2240 : 1120);
+    word(T7_RX_COR_VSYNC_HIGH, uhd ? 10 : 5);
     period(ticks); period_reads = change_read = 0; lose_signal = false;
 }
 int main(void) {
@@ -127,7 +128,9 @@ int main(void) {
     assert(t7_vdin_query_dv_timings(&file,NULL,&timing)==-ERANGE);
     setup(true,2777778); core[T7_RX_COR_COLOR_DEPTH]=5;
     assert(t7_vdin_query_dv_timings(&file,NULL,&timing)==-ERANGE);
-    setup(true,2777778); word(T7_RX_COR_HSYNC,80); word(T7_RX_COR_HFRONT_BACK,4320);
+    setup(true,2777778); word(T7_RX_COR_HSYNC_HIGH,80); word(T7_RX_COR_HSYNC_LOW,4320);
+    assert(t7_vdin_query_dv_timings(&file,NULL,&timing)==-ERANGE);
+    setup(true,2777778); word(T7_RX_COR_HSYNC_HIGH,4312); word(T7_RX_COR_HSYNC_LOW,88);
     assert(t7_vdin_query_dv_timings(&file,NULL,&timing)==-ERANGE);
     setup(true,2777778); link.ready=false;
     assert(t7_vdin_get_parm(&file,NULL,&parm)==-ENOLINK);
