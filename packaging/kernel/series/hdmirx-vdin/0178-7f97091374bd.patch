From 7f97091374bd8f02909e5c2934a4cc19809cfa9b Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 12:56:22 +0800
Subject: [PATCH] media: amlogic: restore receiver state across snapshot
 reloads

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 58 +++++++++++++------
 .../platform/amlogic/t7-hdmirx/test_core.py   | 12 +++-
 .../platform/amlogic/t7-hdmirx/test_phy.py    | 11 +++-
 3 files changed, 59 insertions(+), 22 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index 5d36c19f5aef8..45bc6e32f9d4e 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -150,6 +150,10 @@ struct t7_hdmirx {
 	bool phy_active;
 	bool core_active;
 	unsigned long core_smc_result;
+	u8 core_saved_aon_reset;
+	u8 core_saved_power;
+	u8 core_saved_sys;
+	u8 core_saved_phyck[3];
 	u32 phy_top_saved[ARRAY_SIZE(t7_hdmirx_phy_top_regs)];
 	u32 cable_hz;
 	u8 edid[T7_RX_EDID_CAPACITY];
@@ -358,7 +362,8 @@ static int t7_hdmirx_wait_cable(struct t7_hdmirx *rx, unsigned long reference_hz
 	u32 previous = 0, sample_hz, status;
 	unsigned int i, stable = 0;
 
-	for (i = 0; i < 150; i++) {
+	/* EDID reconnects on the source can outlast the initial three seconds. */
+	for (i = 0; i < 500; i++) {
 		if (!(readl(rx->top + T7_RX_TOP_HPD_PWR5V) & BIT(20 + rx->port)))
 			return -ENOLINK;
 		status = readl(rx->top + T7_RX_TOP_METER_CABLE_STAT);
@@ -437,14 +442,27 @@ static void t7_hdmirx_core_stop(void *data)
 	writeb(0x1a, rx->cor + 0x1005);
 	writeb(1, rx->cor + T7_RX_COR_AON_RESET);
 	writeb(1, rx->cor + T7_RX_COR_POWER_CTRL);
-	writeb(0, rx->cor + T7_RX_COR_SYS_CTRL);
-	writeb(0, rx->cor + T7_RX_COR_PHY_CLOCK1);
-	writeb(0, rx->cor + T7_RX_COR_PHY_CLOCK2);
-	writeb(0, rx->cor + T7_RX_COR_PHY_CLOCK3);
+	/* Restore firmware isolation/clock state for a later PHY-only trial. */
+	writeb(rx->core_saved_sys, rx->cor + T7_RX_COR_SYS_CTRL);
+	writeb(rx->core_saved_phyck[0], rx->cor + T7_RX_COR_PHY_CLOCK1);
+	writeb(rx->core_saved_phyck[1], rx->cor + T7_RX_COR_PHY_CLOCK2);
+	writeb(rx->core_saved_phyck[2], rx->cor + T7_RX_COR_PHY_CLOCK3);
+	writeb(rx->core_saved_power, rx->cor + T7_RX_COR_POWER_CTRL);
+	writeb(rx->core_saved_aon_reset, rx->cor + T7_RX_COR_AON_RESET);
 	readb(rx->cor + T7_RX_COR_PHY_CLOCK3);
 	rx->core_active = false;
 }
 
+static void t7_hdmirx_reset_pcs(struct t7_hdmirx *rx)
+{
+	/* Re-align the PCS after the input PLL and equalizer have settled. */
+	writel(BIT(13) | BIT(7), rx->top + T7_RX_TOP_SW_RESET);
+	readl(rx->top + T7_RX_TOP_SW_RESET);
+	usleep_range(1, 5);
+	writel(0, rx->top + T7_RX_TOP_SW_RESET);
+	readl(rx->top + T7_RX_TOP_SW_RESET);
+}
+
 static int t7_hdmirx_core_start(struct t7_hdmirx *rx)
 {
 	struct arm_smccc_res res;
@@ -454,6 +472,12 @@ static int t7_hdmirx_core_start(struct t7_hdmirx *rx)
 	rx->core_smc_result = res.a0;
 	if (res.a0)
 		return -EIO;
+	rx->core_saved_aon_reset = readb(rx->cor + T7_RX_COR_AON_RESET);
+	rx->core_saved_power = readb(rx->cor + T7_RX_COR_POWER_CTRL);
+	rx->core_saved_sys = readb(rx->cor + T7_RX_COR_SYS_CTRL);
+	rx->core_saved_phyck[0] = readb(rx->cor + T7_RX_COR_PHY_CLOCK1);
+	rx->core_saved_phyck[1] = readb(rx->cor + T7_RX_COR_PHY_CLOCK2);
+	rx->core_saved_phyck[2] = readb(rx->cor + T7_RX_COR_PHY_CLOCK3);
 	rx->core_active = true;
 	/* Hold AON reset while removing TMDS isolation and selecting PHY lanes. */
 	writeb(1, rx->cor + T7_RX_COR_AON_RESET);
@@ -493,11 +517,6 @@ static int t7_hdmirx_core_start(struct t7_hdmirx *rx)
 	writel(BIT(21) | BIT(20) | BIT(7), rx->top + T7_RX_TOP_VID_CNTL);
 	writel(0x0a, rx->top + T7_RX_TOP_VID_CNTL2);
 	writel(0, rx->top + T7_RX_TOP_OUTPUT_OVERRIDE);
-	/* Re-align the PCS after lane and video setup; lock alone is insufficient. */
-	writel(BIT(13) | BIT(7), rx->top + T7_RX_TOP_SW_RESET);
-	readl(rx->top + T7_RX_TOP_SW_RESET);
-	usleep_range(1, 5);
-	writel(0, rx->top + T7_RX_TOP_SW_RESET);
 	if (readb(rx->cor + T7_RX_COR_SYS_CTRL) != 3 ||
 	    readb(rx->cor + T7_RX_COR_PHY_CLOCK1) != 0xff)
 		return -EIO;
@@ -704,6 +723,15 @@ static int t7_hdmirx_probe(struct platform_device *pdev)
 		if (ret)
 			return ret;
 		t7_hdmirx_phy_prepare(rx);
+		if (core_test) {
+			ret = devm_add_action_or_reset(dev, t7_hdmirx_core_stop, rx);
+			if (ret)
+				return ret;
+			/* Core isolation must be removed before cable clock qualification. */
+			ret = t7_hdmirx_core_start(rx);
+			if (ret)
+				return dev_err_probe(dev, ret, "Cannot initialize receiver core\n");
+		}
 		ret = t7_hdmirx_wait_cable(rx, clk_get_rate(rx->clocks[T7_RX_METER].clk));
 		if (!ret)
 			ret = t7_hdmirx_phy_pll(rx);
@@ -711,14 +739,8 @@ static int t7_hdmirx_probe(struct platform_device *pdev)
 			return dev_err_probe(dev, ret, "PHY trial failed, cable %u Hz, APLL %#x\n",
 					     rx->cable_hz, readl(rx->phy + T7_RX_PHY_APLL0));
 		t7_hdmirx_phy_equalize(rx);
-	}
-	if (core_test) {
-		ret = devm_add_action_or_reset(dev, t7_hdmirx_core_stop, rx);
-		if (ret)
-			return ret;
-		ret = t7_hdmirx_core_start(rx);
-		if (ret)
-			return dev_err_probe(dev, ret, "Cannot initialize receiver core\n");
+		if (core_test)
+			t7_hdmirx_reset_pcs(rx);
 	}
 	debugfs = debugfs_create_dir(dev_name(dev), NULL);
 	if (IS_ERR(debugfs))
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
index 10c57c88a9a88..c6ac646e8f717 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
@@ -100,7 +100,9 @@ int main(void)
     assert(t7_hdmirx_core_start(&rx) == -EIO);
     t7_hdmirx_core_stop(&rx); readback_error = false;
     assert(!t7_hdmirx_core_start(&rx)); timing();
-    assert(pcs_resets == 2 && !readl(top + T7_RX_TOP_SW_RESET));
+    assert(!pcs_resets);
+    t7_hdmirx_reset_pcs(&rx);
+    assert(pcs_resets == 1 && !readl(top + T7_RX_TOP_SW_RESET));
     assert(rx.core_active && !t7_hdmirx_check_1080p(&dev));
     core[T7_RX_COR_COLOR_DEPTH] = 5;
     assert(t7_hdmirx_check_1080p(&dev) == -ERANGE);
@@ -121,6 +123,14 @@ int main(void)
     t7_hdmirx_core_stop(&rx); before = writes;
     assert(!rx.core_active && !core[0x20a3] && !core[0x20a4] && !core[0x20a5]);
     t7_hdmirx_core_stop(&rx); assert(writes == before);
+    core[T7_RX_COR_SYS_CTRL] = 3;
+    core[T7_RX_COR_PHY_CLOCK1] = 255;
+    core[T7_RX_COR_PHY_CLOCK2] = 63;
+    core[T7_RX_COR_PHY_CLOCK3] = 1;
+    assert(!t7_hdmirx_core_start(&rx));
+    t7_hdmirx_core_stop(&rx);
+    assert(core[T7_RX_COR_SYS_CTRL] == 3 && core[T7_RX_COR_PHY_CLOCK1] == 255);
+    assert(core[T7_RX_COR_PHY_CLOCK2] == 63 && core[T7_RX_COR_PHY_CLOCK3] == 1);
     puts("Core access, stable progressive timing, signal loss and idempotent cleanup passed");
 }
 '''
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_phy.py b/drivers/media/platform/amlogic/t7-hdmirx/test_phy.py
index 5491fe7b5cb3c..12b48bd5364ad 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_phy.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_phy.py
@@ -38,7 +38,7 @@ struct debugfs_blob_wrapper { void *data; unsigned long size; };
 mmio = r'''
 static u8 top[0x4000], phy[0x50];
 static struct t7_hdmirx receiver;
-static bool lock_pll, jitter;
+static bool lock_pll, jitter, delayed_source;
 static unsigned int delays, meter_reads, pll_attempts, writes;
 static u32 raw_read(void *address)
 {
@@ -57,6 +57,7 @@ static u32 readl(void *address)
     assert(bounded(address));
     if (address == top + T7_RX_TOP_METER_CABLE_STAT) {
         meter_reads++;
+        if (delayed_source && meter_reads <= 200) return 0;
         if (jitter) return BIT(31) | (meter_reads % 2 ? 50500 : 50800);
     }
     if (address == phy + T7_RX_PHY_APLL0 && lock_pll &&
@@ -88,7 +89,7 @@ static void reset(void)
     memset(top, 0, sizeof(top));
     memset(phy, 0, sizeof(phy));
     receiver = (struct t7_hdmirx) { .top = top, .phy = phy, .port = 1 };
-    lock_pll = jitter = false;
+    lock_pll = jitter = delayed_source = false;
     delays = meter_reads = pll_attempts = writes = 0;
     writel(BIT(21) | BIT(1), top + T7_RX_TOP_HPD_PWR5V);
 }
@@ -144,7 +145,11 @@ int main(void)
     /* A valid-looking but unstable input must never reach PLL programming. */
     reset(); jitter = true;
     assert(t7_hdmirx_wait_cable(&receiver, 24000000) == -ETIMEDOUT);
-    assert(meter_reads == 150 && !pll_attempts);
+    assert(meter_reads == 500 && !pll_attempts);
+    /* Source reconnection may take more than three seconds after HPD. */
+    reset(); delayed_source = true;
+    writel(BIT(31) | 50688, top + T7_RX_TOP_METER_CABLE_STAT);
+    assert(!t7_hdmirx_wait_cable(&receiver, 24000000) && meter_reads == 204);
     reset(); writel(BIT(31) | 101376, top + T7_RX_TOP_METER_CABLE_STAT);
     assert(t7_hdmirx_wait_cable(&receiver, 24000000) == -ETIMEDOUT);
     assert(receiver.cable_hz == 297000000 && !pll_attempts);
