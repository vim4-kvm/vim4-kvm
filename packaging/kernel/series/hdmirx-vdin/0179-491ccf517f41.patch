+    pthread_cond_broadcast(&changed); pthread_mutex_unlock(&gate);
+}
+static void vb2_queue_error(struct vb2_queue *q) {
+    pthread_mutex_lock(&gate); q->error=true; pthread_cond_broadcast(&changed);
