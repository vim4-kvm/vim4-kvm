+static int t7_vdin_capture(struct t7_vdin *v) {
+    pthread_mutex_lock(&gate); unsigned int n=++entered;
+    pthread_cond_broadcast(&changed);
+    while (permits<n) pthread_cond_wait(&changed,&gate);
