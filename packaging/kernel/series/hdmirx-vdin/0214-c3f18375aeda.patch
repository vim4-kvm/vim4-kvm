 stubs = r'''
 static bool t7_hdmirx_hdr_input(struct t7_hdmirx *rx) { (void)rx; return false; }
+static bool t7_hdmirx_sdr420_input(struct t7_hdmirx *rx) { (void)rx; return false; }
