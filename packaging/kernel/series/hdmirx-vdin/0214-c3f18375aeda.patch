diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py b/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
index eca2077010929..2411aec3adc01 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
@@ -57,8 +57,9 @@ static struct t7_vdin_buffer *t7_vdin_next_buffer(struct t7_vdin *vdin)
 { assert(!vdin->direct_dma); return NULL; }
 static unsigned int pins, requests, timing_checks, receiver_users;
 static unsigned int pq_writes, gain_writes, oetf_writes;
-static bool hdr_input;
