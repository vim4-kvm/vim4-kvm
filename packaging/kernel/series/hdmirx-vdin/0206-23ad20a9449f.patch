From 23ad20a9449fb19e5d949823ff423c7e39a942ff Mon Sep 17 00:00:00 2001
From: deepdream <deepdream@deepdremsMinim4.lan>
Date: Tue, 20 Oct 2026 21:19:32 -0700
Subject: [PATCH] media: t7-hdmirx: expose measured input timings through V4L2

---
 .../platform/amlogic/t7-hdmirx/README.md      |  12 ++
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    |  51 ++++++
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.h    |   6 +
 .../platform/amlogic/t7-hdmirx/t7-vdin-test.c |  31 ++++
 .../platform/amlogic/t7-hdmirx/test_core.py   |   2 +-
 .../amlogic/t7-hdmirx/test_timings.py         | 145 ++++++++++++++++++
 6 files changed, 246 insertions(+), 1 deletion(-)
