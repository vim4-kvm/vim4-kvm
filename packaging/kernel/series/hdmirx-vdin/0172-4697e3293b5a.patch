 # T7 HDMI receiver bring-up
 
 The initial driver owns the receiver TOP MMIO window, HDMIRX power domain and
-pclk/CFG/METER/2M/5M clocks. It reads source 5V and the HPD request register through
-`/sys/kernel/debug/fe398000.hdmi-receiver/status`. It does not initialize the PHY,
-program EDID/HPD, request interrupts or start VDIN DMA. No capture device is exposed.
+pclk/sys/CFG/METER/2M/5M clocks. It reads source 5V and the HPD request register through
+`/sys/kernel/debug/fe398000.hdmi-receiver/status`. No capture device is exposed;
+PHY tuning, receive interrupts and VDIN DMA still require implementation.
 The normal VIM4 DTB leaves the receiver disabled; use the dedicated hdmirx-test
-DTB for bring-up. Its port 1 detect pin is muxed without changing HPD/DDC pins.
+DTB for bring-up. Its port 1 detect, HPD and DDC pins are muxed for the receiver.
+
+With no parameters, the driver only monitors resources. To publish a dedicated
+test EDID, install it under `/lib/firmware` and load the module with
+`edid_firmware=directory/file.bin`. Only complete, checksummed 128..512 byte EDIDs
+whose extension count matches the size are accepted. The selected port's RAM is
+written and read back before HPD is asserted. Unload drops HPD and restores TOP
+reset/port state before releasing clocks and power. The read-only debugfs `edid`
+file contains the verified published bytes; `status` also reports the DDC state.
+There is no live EDID replacement API at this stage; changing a test EDID requires
+unloading and reloading the module, which disconnects the source.
 
 Hardware access is permitted only after runtime power and all clocks are held.
 Managed cleanup removes debugfs before callback storage and clocks are released,
@@ -13,7 +23,13 @@ then drops the power-domain reference. The status file is diagnostic, not a
 stable userspace ABI. `source_5v` indicates cable power, not TMDS/PHY lock.
 `hpd_request` is a register value, not proof of the physical HPD voltage.
 
-Next stages are EDID/DDC/HPD, T7 PHY tuning and signal lock, then an independent
+Run `python3 test_ddc.py` for the actual validation/publication code with fake MMIO.
+It checks malformed inputs, HPD ordering, port-bank isolation and readback failure.
+Source-side hardware validation must compare at least two distinct EDIDs to avoid
+treating cached display metadata as a new DDC read. It does not validate every
+advertised display mode or establish physical HPD voltage/timing.
+
+Next stages are T7 PHY tuning and signal lock, then an independent
 VDIN capture path using completed frames and explicit DMA buffer ownership.
 Existing 5.15 TVIN/VFM/codec_mm interfaces must be replaced or explicitly adapted;
 the Synopsys rk3588 capture driver is not a drop-in T7 frontend.
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index 80ff37a8d9df4..cfa3e43a44674 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -3,6 +3,8 @@
 #include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
 #include <linux/io.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
@@ -15,11 +17,26 @@
 #define T7_RX_TOP_CLK_CNTL	(0x001 * 4)
 #define T7_RX_TOP_HPD_PWR5V	(0x002 * 4)
 #define T7_RX_TOP_PORT_SEL	(0x003 * 4)
+#define T7_RX_TOP_EDID_GEN_CNTL	(0x004 * 4)
+#define T7_RX_TOP_EDID_GEN_STAT	(0x008 * 4)
+#define T7_RX_TOP_INTR_MASKN	(0x009 * 4)
+#define T7_RX_TOP_INFILTER_I2C0	(0x02d * 4)
 #define T7_RX_TOP_5V_MASK		GENMASK(22, 20)
 #define T7_RX_TOP_HPD_MASK	GENMASK(2, 0)
+#define T7_RX_TOP_HPD_OVERRIDE	BIT(4)
+#define T7_RX_TOP_HPD_REVERSE	BIT(5)
+#define T7_RX_TOP_EDID_RESET	BIT(1)
+#define T7_RX_EDID_BASE		0x1000
+#define T7_RX_EDID_CAPACITY	512
+#define T7_RX_EDID_BLOCK_SIZE	128
+
+static char *edid_firmware;
+module_param(edid_firmware, charp, 0400);
+MODULE_PARM_DESC(edid_firmware, "Optional validated EDID file in /lib/firmware for DDC bring-up");
 
 enum t7_hdmirx_clock {
 	T7_RX_PCLK,
+	T7_RX_SYS,
 	T7_RX_CFG,
 	T7_RX_METER,
 	T7_RX_2M,
@@ -31,8 +48,107 @@ struct t7_hdmirx {
 	void __iomem *top;
 	struct clk_bulk_data clocks[T7_RX_NUM_CLOCKS];
 	u32 port;
+	u32 saved_reset;
+	u32 saved_port_sel;
+	bool ddc_active;
+	u8 edid[T7_RX_EDID_CAPACITY];
+	struct debugfs_blob_wrapper edid_blob;
 };
 
+static int t7_hdmirx_validate_edid(const u8 *edid, size_t size)
+{
+	static const u8 header[] = { 0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0 };
+	unsigned int block, i;
+	u8 sum;
+
+	if (size > T7_RX_EDID_CAPACITY)
+		return -E2BIG;
+	if (size < T7_RX_EDID_BLOCK_SIZE || size % T7_RX_EDID_BLOCK_SIZE)
+		return -EINVAL;
+	if (memcmp(edid, header, sizeof(header)) ||
+	    edid[126] != size / T7_RX_EDID_BLOCK_SIZE - 1)
+		return -EINVAL;
+	for (block = 0; block < size; block += T7_RX_EDID_BLOCK_SIZE) {
+		sum = 0;
+		for (i = 0; i < T7_RX_EDID_BLOCK_SIZE; i++)
+			sum += edid[block + i];
+		if (sum)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+static void t7_hdmirx_set_hpd(struct t7_hdmirx *rx, bool high)
+{
+	u32 value = readl(rx->top + T7_RX_TOP_HPD_PWR5V);
+
+	/* T7's pin control uses the same override/reverse polarity as the RX TOP. */
+	value |= T7_RX_TOP_HPD_OVERRIDE | T7_RX_TOP_HPD_REVERSE;
+	value &= ~BIT(rx->port);
+	if (high)
+		value |= BIT(rx->port);
+	writel(value, rx->top + T7_RX_TOP_HPD_PWR5V);
+	readl(rx->top + T7_RX_TOP_HPD_PWR5V);
+}
+
+static void t7_hdmirx_ddc_stop(void *data)
+{
+	struct t7_hdmirx *rx = data;
+
+	if (!rx->ddc_active)
+		return;
+	t7_hdmirx_set_hpd(rx, false);
+	writel(rx->saved_port_sel, rx->top + T7_RX_TOP_PORT_SEL);
+	writel(rx->saved_reset, rx->top + T7_RX_TOP_SW_RESET);
+	readl(rx->top + T7_RX_TOP_SW_RESET);
+	rx->edid_blob.size = 0;
+	rx->ddc_active = false;
+}
+
+static int t7_hdmirx_ddc_start(struct t7_hdmirx *rx, const u8 *edid, size_t size)
+{
+	unsigned int base = T7_RX_EDID_BASE + rx->port * T7_RX_EDID_CAPACITY;
+	unsigned int i;
+	u8 expected;
+	int ret;
+
+	ret = t7_hdmirx_validate_edid(edid, size);
+	if (ret)
+		return ret;
+	rx->saved_reset = readl(rx->top + T7_RX_TOP_SW_RESET);
+	rx->saved_port_sel = readl(rx->top + T7_RX_TOP_PORT_SEL);
+	rx->ddc_active = true;
+	t7_hdmirx_set_hpd(rx, false);
+	/* Give the source a real disconnect interval before replacing its EDID. */
+	msleep(120);
+	writel(0, rx->top + T7_RX_TOP_INTR_MASKN);
+	writel(rx->saved_reset | T7_RX_TOP_EDID_RESET, rx->top + T7_RX_TOP_SW_RESET);
+	writel(GENMASK(16, 13) | 9, rx->top + T7_RX_TOP_EDID_GEN_CNTL);
+	writel(BIT(29) | BIT(16) | BIT(13) | BIT(0),
+	       rx->top + T7_RX_TOP_INFILTER_I2C0 + rx->port * 4);
+	/* EDID RAM is byte-addressed, unlike the word-indexed TOP registers. */
+	for (i = 0; i < T7_RX_EDID_CAPACITY; i++)
+		writeb(i < size ? edid[i] : 0, rx->top + base + i);
+	for (i = 0; i < T7_RX_EDID_CAPACITY; i++) {
+		expected = i < size ? edid[i] : 0;
+		if (readb(rx->top + base + i) != expected) {
+			t7_hdmirx_ddc_stop(rx);
+			return -EIO;
+		}
+	}
+	/* T7 DDC requires the TOP reset bank released, as in the hardware init. */
+	writel(0, rx->top + T7_RX_TOP_SW_RESET);
+	readl(rx->top + T7_RX_TOP_SW_RESET);
+	usleep_range(1000, 2000);
+	/* Enable the TOP port path used by T7's receiver initialization. */
+	writel(rx->saved_port_sel | BIT(4), rx->top + T7_RX_TOP_PORT_SEL);
+	memcpy(rx->edid, edid, size);
+	rx->edid_blob.data = rx->edid;
+	rx->edid_blob.size = size;
+	t7_hdmirx_set_hpd(rx, true);
+	return 0;
+}
+
 static int t7_hdmirx_status(struct seq_file *s, void *unused)
 {
 	struct device *dev = s->private;
@@ -53,6 +169,9 @@ static int t7_hdmirx_status(struct seq_file *s, void *unused)
 		   readl(rx->top + T7_RX_TOP_CLK_CNTL));
 	seq_printf(s, "top_port_sel: %#010x\n",
 		   readl(rx->top + T7_RX_TOP_PORT_SEL));
+	seq_printf(s, "edid_bytes: %lu\n", rx->edid_blob.size);
+	seq_printf(s, "top_edid_gen_stat: %#010x\n",
+		   readl(rx->top + T7_RX_TOP_EDID_GEN_STAT));
 	for (i = 0; i < ARRAY_SIZE(rx->clocks); i++)
 		seq_printf(s, "%s_hz: %lu\n", rx->clocks[i].id,
 			   clk_get_rate(rx->clocks[i].clk));
@@ -78,11 +197,12 @@ static void t7_hdmirx_debugfs_remove(void *data)
 
 static int t7_hdmirx_probe(struct platform_device *pdev)
 {
-	static const char * const names[] = { "pclk", "cfg", "meter", "2m", "5m" };
-	static const unsigned long rates[] = { 0, 50000000, 24000000, 2000000, 5000000 };
+	static const char * const names[] = { "pclk", "sys", "cfg", "meter", "2m", "5m" };
+	static const unsigned long rates[] = { 0, 0, 50000000, 24000000, 2000000, 5000000 };
 	struct device *dev = &pdev->dev;
 	struct dentry *debugfs;
 	struct t7_hdmirx *rx;
+	const struct firmware *firmware;
 	unsigned int i;
 	int ret;
 
@@ -123,11 +243,23 @@ static int t7_hdmirx_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 	platform_set_drvdata(pdev, rx);
-	/* Read-only bring-up: keep HPD, EDID, IRQ and DMA state untouched. */
+	ret = devm_add_action_or_reset(dev, t7_hdmirx_ddc_stop, rx);
+	if (ret)
+		return ret;
+	if (edid_firmware) {
+		ret = request_firmware(&firmware, edid_firmware, dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "Cannot load EDID firmware\n");
+		ret = t7_hdmirx_ddc_start(rx, firmware->data, firmware->size);
+		release_firmware(firmware);
+		if (ret)
+			return dev_err_probe(dev, ret, "Cannot publish EDID\n");
+	}
 	debugfs = debugfs_create_dir(dev_name(dev), NULL);
 	if (IS_ERR(debugfs))
 		return PTR_ERR(debugfs);
 	debugfs_create_devm_seqfile(dev, "status", debugfs, t7_hdmirx_status);
+	debugfs_create_blob("edid", 0400, debugfs, &rx->edid_blob);
 	/* Remove files before their managed callback context or clocks disappear. */
 	ret = devm_add_action_or_reset(dev, t7_hdmirx_debugfs_remove, debugfs);
 	if (ret)
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py b/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py
new file mode 100644
index 0000000000000..c7985d2da2779
--- /dev/null
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_ddc.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Compile the actual EDID/DDC functions with bounded fake MMIO and failures."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+source = Path(__file__).with_name('t7-hdmirx.c').read_text()
+
+
+def function(signature):
+    start = source.index(signature)
+    return source[start:source.index('\n}\n', start) + 3]
+
+
+defines = '\n'.join(line for line in source.splitlines() if line.startswith('#define T7_RX_'))
+types = source[source.index('enum t7_hdmirx_clock'):source.index('static int t7_hdmirx_validate_edid')]
+functions = '\n'.join(function(name) for name in [
+    'static int t7_hdmirx_validate_edid(', 'static void t7_hdmirx_set_hpd(',
+    'static void t7_hdmirx_ddc_stop(', 'static int t7_hdmirx_ddc_start('])
+prefix = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+#define __iomem
+#define BIT(n) (1U << (n))
+#define GENMASK(h, l) ((~0U >> (31 - (h))) & (~0U << (l)))
+struct clk_bulk_data { int unused; };
+struct debugfs_blob_wrapper { void *data; unsigned long size; };
+'''
+mmio = r'''
+static u8 memory[0x4000];
+static struct t7_hdmirx receiver;
+static unsigned int written, verified, hpd_high, register_writes, delay_calls;
+static bool corrupt;
+static u32 readl(void *address)
+{
+    u32 value;
+    assert((u8 *)address >= memory && (u8 *)address + 4 <= memory + sizeof(memory));
+    memcpy(&value, address, sizeof(value));
+    return value;
+}
+static void writel(u32 value, void *address)
+{
+    if ((u8 *)address == memory + T7_RX_TOP_HPD_PWR5V && (value & BIT(receiver.port))) {
+        /* Source must never see HPD before the whole bank has been verified. */
+        assert(written == T7_RX_EDID_CAPACITY && verified == T7_RX_EDID_CAPACITY);
+        assert(delay_calls == 1 && receiver.edid_blob.size != 0);
+        hpd_high++;
+    }
+    assert((u8 *)address >= memory && (u8 *)address + 4 <= memory + sizeof(memory));
+    memcpy(address, &value, sizeof(value));
+    register_writes++;
+}
+static void writeb(u8 value, void *address)
+{
+    unsigned int base = T7_RX_EDID_BASE + receiver.port * T7_RX_EDID_CAPACITY;
+    assert((u8 *)address >= memory + base &&
+           (u8 *)address < memory + base + T7_RX_EDID_CAPACITY);
+    assert(!(readl(memory + T7_RX_TOP_HPD_PWR5V) & BIT(receiver.port)));
+    *(u8 *)address = value;
+    written++;
+}
+static u8 readb(void *address)
+{
+    verified++;
+    return *(u8 *)address ^ (corrupt && verified == 100 ? 1 : 0);
+}
+static void msleep(unsigned int delay) { assert(delay >= 100); delay_calls++; }
+static void usleep_range(unsigned int low, unsigned int high) { assert(low >= 1000 && high >= low); }
+'''
+checks = r'''
+static void checksum(u8 *data)
+{
+    unsigned int i;
+    u8 sum = 0;
+    data[127] = 0;
+    for (i = 0; i < 127; i++) sum += data[i];
+    data[127] = -sum;
+}
+static void make_edid(u8 *data, unsigned int blocks)
+{
+    unsigned int i;
+    memset(data, 0, T7_RX_EDID_CAPACITY);
+    memset(data + 1, 0xff, 6);
+    data[18] = 1; data[19] = 4; data[126] = blocks - 1;
+    for (i = 1; i < blocks; i++) data[i * 128] = 2;
+    for (i = 0; i < blocks; i++) checksum(data + i * 128);
+}
+static void reset(void)
+{
+    u32 saved_reset = 0xffff, status = (2U << 20) | BIT(0) | BIT(2);
+    memset(memory, 0xa5, sizeof(memory));
+    receiver = (struct t7_hdmirx) { .top = memory, .port = 1 };
+    memcpy(memory + T7_RX_TOP_SW_RESET, &saved_reset, 4);
+    memcpy(memory + T7_RX_TOP_HPD_PWR5V, &status, 4);
+    written = verified = hpd_high = register_writes = delay_calls = 0;
+    corrupt = false;
+}
+int main(void)
+{
+    u8 data[T7_RX_EDID_CAPACITY], before[sizeof(memory)];
+    unsigned int blocks, i, writes;
+    for (blocks = 1; blocks <= 4; blocks++) {
+        make_edid(data, blocks);
+        assert(!t7_hdmirx_validate_edid(data, blocks * 128));
+        data[blocks * 128 - 1]++;
+        assert(t7_hdmirx_validate_edid(data, blocks * 128) == -EINVAL);
+    }
+    make_edid(data, 1);
+    assert(t7_hdmirx_validate_edid(data, 0) == -EINVAL);
+    assert(t7_hdmirx_validate_edid(data, 127) == -EINVAL);
+    assert(t7_hdmirx_validate_edid(data, 129) == -EINVAL);
+    assert(t7_hdmirx_validate_edid(data, 513) == -E2BIG);
+    assert(t7_hdmirx_validate_edid(data, 10000) == -E2BIG);
+    data[1] = 0; checksum(data);
+    assert(t7_hdmirx_validate_edid(data, 128) == -EINVAL);
+    make_edid(data, 1);
+    data[126] = 2; checksum(data);
+    reset(); memcpy(before, memory, sizeof(memory));
+    assert(t7_hdmirx_ddc_start(&receiver, data, 128) == -EINVAL);
+    assert(!memcmp(before, memory, sizeof(memory)) && !receiver.ddc_active);
+    for (blocks = 1; blocks <= 4; blocks++) {
+        reset(); make_edid(data, blocks);
+        assert(!t7_hdmirx_ddc_start(&receiver, data, blocks * 128));
+        assert(receiver.ddc_active && hpd_high == 1);
+        assert((readl(memory + T7_RX_TOP_HPD_PWR5V) & 7) == 7);
+        assert(!memcmp(receiver.edid, data, blocks * 128));
+        for (i = 0; i < 512; i++) {
+            assert(memory[T7_RX_EDID_BASE + i] == 0xa5);
+            assert(memory[T7_RX_EDID_BASE + 1024 + i] == 0xa5);
+        }
+        t7_hdmirx_ddc_stop(&receiver);
+        assert(!receiver.ddc_active && !receiver.edid_blob.size);
+        assert((readl(memory + T7_RX_TOP_HPD_PWR5V) & 7) == 5);
+        assert(readl(memory + T7_RX_TOP_SW_RESET) == 0xffff);
+        assert(readl(memory + T7_RX_TOP_PORT_SEL) == 0xa5a5a5a5);
+        writes = register_writes;
