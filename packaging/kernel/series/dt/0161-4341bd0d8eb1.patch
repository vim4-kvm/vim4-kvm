From 4341bd0d8eb1f3fc046d09440e4a819643ce1aa4 Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Wed, 14 Oct 2026 07:22:16 +0000
Subject: [PATCH] arm64: dts: amlogic: s4: khadas-vim1s: enable HDMI audio

Give the S4 HDMI transmitter one sound DAI cell, to select its I2S or
SPDIF input. Link the TOHDMITX outputs to the HDMI transmitter on
Khadas VIM1S.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../amlogic/meson-s4-s905y4-khadas-vim1s.dts   | 18 ++++++++++++++++++
 arch/arm64/boot/dts/amlogic/meson-s4.dtsi      |  2 +-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts b/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
index e2559667b4971..471eb00f33ac3 100644
--- a/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
@@ -462,6 +462,24 @@ codec {
 				sound-dai = <&acodec>;
 			};
 		};
+
+		/* hdmi glue */
+		dai-link-13 {
+			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx 0>;
+			};
+		};
+
+		/* hdmi glue, compressed */
+		dai-link-14 {
+			sound-dai = <&tohdmitx TOHDMITX_SPDIF_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx 1>;
+			};
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
index 781e362942745..936002420bf89 100644
--- a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
@@ -315,7 +315,7 @@ hdmi_tx: hdmi-tx@300000 {
 				clock-names = "isfr", "iahb", "venci";
 				#address-cells = <1>;
 				#size-cells = <0>;
-				#sound-dai-cells = <0>;
+				#sound-dai-cells = <1>;
 				status = "disabled";
 
 				/* VPU VENC Input */
