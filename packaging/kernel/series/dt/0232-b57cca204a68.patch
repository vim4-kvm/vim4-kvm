From b57cca204a686c92a5502e6a340478d765c86a77 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:51:15 +0800
Subject: [PATCH] Enable VIM4 GPU devfreq at firmware voltage

Connect the existing VDDGPU PWM supply and describe the five rates used by the T7 GPU DVFS table. Leave voltages unspecified because the vendor clock scaling path retains firmware voltage and its placeholder voltage fields do not provide a validated DVFS voltage table.
---
 .../amlogic/amlogic-t7-a311d2-khadas-vim4.dts | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
index d7dc6f614184c..14779b33f9e24 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
@@ -55,6 +55,31 @@ pcie_dma_pool: pcie-dma-pool {
 		};
 	};
 
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		/* Keep the firmware's PWM voltage: no validated DVFS voltages. */
+		opp-250000000 {
+			opp-hz = /bits/ 64 <250000000>;
+		};
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+		};
+
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+		};
+
+		opp-666666666 {
+			opp-hz = /bits/ 64 <666666666>;
+		};
+
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+		};
+	};
+
 	dc_in: regulator-dc-in {
 		compatible = "regulator-fixed";
 		regulator-name = "DC_IN";
@@ -819,6 +844,8 @@ bluetooth {
 };
 
 &gpu {
+	mali-supply = <&vdd_gpu>;
+	operating-points-v2 = <&gpu_opp_table>;
 	status = "okay";
 };
 
