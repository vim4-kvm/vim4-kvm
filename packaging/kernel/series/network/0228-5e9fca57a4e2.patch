+			goto fail_disable;
+		}
+		p2p_ifp->vif = p2p_vif;
+		p2p_vif->ifp = p2p_ifp;
+		goto ready;
+	}
 
 	brcmf_cfg80211_arm_vif_event(p2p->cfg, p2p_vif);
 	brcmf_fweh_p2pdev_setup(pri_ifp, true);
