 static T7_SYS_PCLK(sys_rsa,		SYS_CLK_EN0_REG2, 18,	0);
@@ -1303,6 +1304,7 @@ static struct clk_hw *t7_peripherals_hw_clks[] = {
 	[CLKID_HDMIRX_METER_SEL]		= &t7_hdmirx_meter_sel.hw,
