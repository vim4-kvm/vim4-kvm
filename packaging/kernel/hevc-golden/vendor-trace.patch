+static unsigned int hevc_golden_current_phase;
+
+void hevc_golden_event(char op, unsigned long reg, unsigned int value)
+{
+	if (unlikely(READ_ONCE(hevc_golden_trace)))
+		trace_printk("HGT p=%u op=%c reg=%04lx val=%08x\n",
+			     READ_ONCE(hevc_golden_current_phase), op, reg, value);
+}
+EXPORT_SYMBOL_GPL(hevc_golden_event);
+
+void hevc_golden_phase(unsigned int phase)
+{
+	WRITE_ONCE(hevc_golden_current_phase, phase);
+	hevc_golden_event('E', 0, phase);
+}
+EXPORT_SYMBOL_GPL(hevc_golden_phase);
+
+static void hevc_golden_access(char op, unsigned long reg, unsigned int value)
+{
+	if ((reg >= 0x3000 && reg < 0x3f00) || (reg >= 0x3f33 && reg <= 0x3f35))
+		hevc_golden_event(op, reg, value);
+}
