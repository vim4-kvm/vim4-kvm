diff --git a/drivers/media/platform/amlogic/vdec/aml_vdec_hw.c b/drivers/media/platform/amlogic/vdec/aml_vdec_hw.c
index da05257f1ea91..7fa13c537d868 100644
--- a/drivers/media/platform/amlogic/vdec/aml_vdec_hw.c
+++ b/drivers/media/platform/amlogic/vdec/aml_vdec_hw.c
@@ -20,6 +20,31 @@
 #include "aml_vdec_drv.h"
 #include "aml_vdec_hw.h"
 #include "aml_vdec_platform.h"
+#include "hevc_golden.h"
+
+static bool hevc_golden_trace;
+module_param(hevc_golden_trace, bool, 0644);
+static unsigned int hevc_golden_current_phase;
+
+void aml_hevc_golden_event(char op, u32 reg, u32 value)
+{
+	if (unlikely(READ_ONCE(hevc_golden_trace)))
+		trace_printk("HGT p=%u op=%c reg=%04x val=%08x\n",
+			     READ_ONCE(hevc_golden_current_phase), op, reg, value);
+}
+
+void aml_hevc_golden_phase(unsigned int phase)
+{
+	WRITE_ONCE(hevc_golden_current_phase, phase);
+	aml_hevc_golden_event('E', 0, phase);
+}
+
+void aml_hevc_golden_access(char op, u32 reg, u32 value)
+{
+	reg >>= 2;
+	if ((reg >= 0x3000 && reg < 0x3f00) || (reg >= 0x3f33 && reg <= 0x3f35))
+		aml_hevc_golden_event(op, reg, value);
+}
 
 #define MHz     (1000000)
 #define MC_SIZE (4096 * 16)
@@ -38,7 +63,8 @@ u32 read_dos_reg(struct aml_vdec_hw *hw, u32 addr)
 {
 	u32 ret_val;
 
-	regmap_read(hw->map[DOS_BUS], addr, &ret_val);
+	if (!regmap_read(hw->map[DOS_BUS], addr, &ret_val))
+		aml_hevc_golden_access('R', addr, ret_val);
 
 	return ret_val;
 }
@@ -1240,6 +1266,7 @@ static int t7_hevc_stop(struct aml_vdec_hw *hw)
 	unsigned int i;
 	int ret;
 
+	aml_hevc_golden_phase(8);
 	ret = regmap_write(map, HEVC_ASSIST_MBOX0_MASK, 0);
 	if (hw->hevc_irq_enabled) {
 		disable_irq(hw->hevc_irq);
@@ -1299,6 +1326,7 @@ static int t7_hevc_reset(struct aml_vdec_hw *hw)
 	u32 value;
 	int ret;
 
+	aml_hevc_golden_phase(9);
 	/* AXI is isolated by t7_hevc_stop; never cycle shared-domain memories. */
 	ret = regmap_write(map, HEVC_STREAM_CONTROL, 0);
 	if (ret)
@@ -1330,6 +1358,7 @@ int aml_hevc_prepare_hw(struct aml_vdec_hw *hw)
 	struct arm_smccc_res result;
 	int ret;
 
+	aml_hevc_golden_phase(1);
 	ret = t7_hevc_power_on(hw);
 	if (ret)
 		return ret;
@@ -1347,7 +1376,10 @@ int aml_hevc_prepare_hw(struct aml_vdec_hw *hw)
 	if (hw->hevc_fw_loaded)
 		return 0;
 	/* HEVC_MMU, legacy core routing: secure firmware selects its HEVC target. */
+	aml_hevc_golden_phase(2);
+	aml_hevc_golden_event('L', 17, 0);
 	arm_smccc_smc(0xb200000f, 17, 0, 0, 0, 0, 0, 0, &result);
+	aml_hevc_golden_event('F', 0, result.a0);
 	dev_info(hw->dev, "HEVC secure firmware load: a0=%#lx\n", result.a0);
 	if (result.a0)
 		return -EIO;
diff --git a/drivers/media/platform/amlogic/vdec/hevc.c b/drivers/media/platform/amlogic/vdec/hevc.c
index 5982786b44a3e..1ba20ea82ea60 100644
--- a/drivers/media/platform/amlogic/vdec/hevc.c
+++ b/drivers/media/platform/amlogic/vdec/hevc.c
@@ -33,6 +33,7 @@
 #include "aml_vdec.h"
 #include "aml_vdec_hw.h"
 #include "hevc_priv.h"
+#include "hevc_golden.h"
 
 /* Workspace, the reference's amvh265_workbuff_spec[1] (4096x2048). */
 #define H265_IPP_SIZE		0x4000
@@ -90,7 +91,8 @@ static const u16 h265_parser_cmd[] = {
 
 static void wr(struct aml_vdec_hw *hw, u32 reg, u32 val)
 {
-	regmap_write(hw->map[DOS_BUS], reg, val);
+	if (!regmap_write(hw->map[DOS_BUS], reg, val))
+		aml_hevc_golden_access('W', reg, val);
 }
 
 /* ---------------------------------------------------------------- */
@@ -403,6 +405,8 @@ static void h265_prot_init(struct aml_hevc_ctx *h)
 {
 	struct aml_vdec_hw *hw = h->hw;
 
+	aml_hevc_golden_phase(3);
+
 	h265_config_workspace(h);
 	h265_init_decoder(h);
 
@@ -441,6 +445,7 @@ static int h265_feed(struct aml_hevc_ctx *h, const void *data, size_t size)
 		h->stream_size = want;
 	}
 
+	aml_hevc_golden_phase(4);
 	memcpy(h->stream_v, data, size);
 	memset(h->stream_v + size, 0, h->stream_size - size);
 	h->payload = size;
@@ -1375,6 +1380,8 @@ static irqreturn_t h265_irq_thread(int irq, void *priv)
 	u32 status = hw->hevc_irq_status;
 	u32 st = status & 0xff;
 
+	aml_hevc_golden_event('I', 0x30c0, status);
+
 	dev_dbg(hw->dev, "hevc: irq status=%08x pc=%08x shift=%08x\n",
 		status, read_dos_reg(hw, HEVC_MPC_E), read_dos_reg(hw, HEVC_SHIFT_BYTE_COUNT));
 	if (h->finished)
@@ -1452,6 +1459,7 @@ static irqreturn_t h265_irq_thread(int irq, void *priv)
 		return IRQ_HANDLED;
 	}
 	case H265_DECPIC_DATA_DONE:
+		aml_hevc_golden_phase(7);
 		h265_picture_done(h);
 		h265_finish(h, h->have_picture ? VB2_BUF_STATE_DONE : VB2_BUF_STATE_ERROR);
 		return IRQ_HANDLED;
@@ -1573,6 +1581,7 @@ int aml_hevc_dec_run(void *priv)
 		goto stop;
 
 	wr(hw, HEVC_ASSIST_MBOX0_CLR_REG, 1);
+	aml_hevc_golden_phase(5);
 	/* Publish the initial command before resetting and releasing the CPUs. */
 	wr(hw, HEVC_DEC_STATUS_REG, H265_ACTION_DONE);
 	h265_dump_start(hw, "before-reset");
