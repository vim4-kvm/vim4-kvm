# Decoder validation only. Merge onto kernel.config, run olddefconfig, then
# lock the resulting full config in a private candidate lock for build.sh.
# Keep the accepted production configuration and its release unchanged.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DMA_API_DEBUG=y
