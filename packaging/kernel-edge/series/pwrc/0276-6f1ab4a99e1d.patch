From 6f1ab4a99e1d407679a2c82aeb6f1f59cd645231 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:19:55 +0800
Subject: [PATCH] pmdomain: amlogic: verify T7 Wave power transitions

Poll secure power status for the dedicated DOS_WAVE domain before reporting a successful transition. A dispatched SET does not prove the domain reached the requested state. Keep other domain behavior unchanged.

Signed-off-by: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
---
 drivers/pmdomain/amlogic/meson-secure-pwrc.c | 35 +++++++-
 drivers/pmdomain/amlogic/test_secure_pwrc.py | 91 ++++++++++++++++++++
 2 files changed, 123 insertions(+), 3 deletions(-)
 create mode 100644 drivers/pmdomain/amlogic/test_secure_pwrc.py

diff --git a/drivers/pmdomain/amlogic/meson-secure-pwrc.c b/drivers/pmdomain/amlogic/meson-secure-pwrc.c
index da34543e1911d..b0a51c3f98749 100644
--- a/drivers/pmdomain/amlogic/meson-secure-pwrc.c
+++ b/drivers/pmdomain/amlogic/meson-secure-pwrc.c
@@ -23,6 +23,7 @@
 #include <linux/arm-smccc.h>
 #include <linux/firmware/meson/meson_sm.h>
 #include <linux/module.h>
+#include <linux/iopoll.h>
 
 #define PWRC_ON		1
 #define PWRC_OFF	0
@@ -33,6 +34,7 @@ struct meson_secure_pwrc_domain {
 	unsigned int index;
 	unsigned int parent;
 	struct meson_secure_pwrc *pwrc;
+	bool verify_state;
 };
 
 struct meson_secure_pwrc {
@@ -47,6 +49,7 @@ struct meson_secure_pwrc_domain_desc {
 	unsigned int flags;
 	char *name;
 	bool (*is_off)(struct meson_secure_pwrc_domain *pwrc_domain);
+	bool verify_state;
 };
 
 struct meson_secure_pwrc_domain_data {
@@ -65,6 +68,25 @@ static bool pwrc_secure_is_off(struct meson_secure_pwrc_domain *pwrc_domain)
 	return is_off;
 }
 
+static int meson_secure_pwrc_wait(struct meson_secure_pwrc_domain *domain, bool off)
+{
+	int ret, status;
+	s32 is_off;
+
+	if (!domain->verify_state)
+		return 0;
+	/* SET only acknowledges dispatch; GET reports whether power was removed. */
+	ret = read_poll_timeout(meson_sm_call, status,
+				status < 0 || is_off < 0 || is_off == off,
+				10, 10000, false, domain->pwrc->fw, SM_A1_PWRC_GET,
+				&is_off, domain->index, 0, 0, 0, 0);
+	if (ret)
+		return ret;
+	if (status < 0)
+		return status;
+	return is_off < 0 ? -EIO : 0;
+}
+
 static int meson_secure_pwrc_off(struct generic_pm_domain *domain)
 {
 	int ret = 0;
@@ -77,7 +99,7 @@ static int meson_secure_pwrc_off(struct generic_pm_domain *domain)
 		ret = -EINVAL;
 	}
 
-	return ret;
+	return ret ?: meson_secure_pwrc_wait(pwrc_domain, true);
 }
 
 static int meson_secure_pwrc_on(struct generic_pm_domain *domain)
@@ -92,7 +114,7 @@ static int meson_secure_pwrc_on(struct generic_pm_domain *domain)
 		ret = -EINVAL;
 	}
 
-	return ret;
+	return ret ?: meson_secure_pwrc_wait(pwrc_domain, false);
 }
 
 #define SEC_PD(__name, __flag)			\
@@ -335,7 +357,13 @@ static const struct meson_secure_pwrc_domain_desc t7_pwrc_domains[] = {
 	TOP_PD(T7_DOS_HCODEC,	0, PWRC_T7_NIC3_ID),
 	TOP_PD(T7_DOS_HEVC,	0, PWRC_T7_NIC3_ID),
 	TOP_PD(T7_DOS_VDEC,	0, PWRC_T7_NIC3_ID),
-	TOP_PD(T7_DOS_WAVE,	0, PWRC_T7_NIC3_ID),
+	[PWRC_T7_DOS_WAVE_ID] = {
+		.name = "T7_DOS_WAVE",
+		.index = PWRC_T7_DOS_WAVE_ID,
+		.parent = PWRC_T7_NIC3_ID,
+		.is_off = pwrc_secure_is_off,
+		.verify_state = true,
+	},
 	/* VPU domains: the VPU keeps state in all three, keep them on */
 	SEC_PD(T7_VPU_HDMI,	GENPD_FLAG_ALWAYS_ON),
 	/* USB, SDIO and eMMC hosts do not recover from a power cycle */
@@ -447,6 +475,7 @@ static int meson_secure_pwrc_probe(struct platform_device *pdev)
 		dom->pwrc = pwrc;
 		dom->index = match->domains[i].index;
 		dom->parent = match->domains[i].parent;
+		dom->verify_state = match->domains[i].verify_state;
 		dom->base.name = match->domains[i].name;
 		dom->base.flags = match->domains[i].flags;
 		dom->base.power_on = meson_secure_pwrc_on;
diff --git a/drivers/pmdomain/amlogic/test_secure_pwrc.py b/drivers/pmdomain/amlogic/test_secure_pwrc.py
new file mode 100644
index 0000000000000..26210ffa1c38f
--- /dev/null
+++ b/drivers/pmdomain/amlogic/test_secure_pwrc.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Fault the actual secure-domain transition callbacks and polling macro."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parent
+source = (root / 'meson-secure-pwrc.c').read_text()
+functions = source[source.index('static int meson_secure_pwrc_wait('):source.index('#define SEC_PD(')]
+prefix = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+typedef int32_t s32;
+typedef int64_t ktime_t;
+typedef uint64_t u64;
+#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+#define SM_A1_PWRC_SET 1
+#define SM_A1_PWRC_GET 2
+#define PWRC_OFF 0
+#define PWRC_ON 1
+#define pr_err(...) ((void)0)
+#define barrier() ((void)0)
+#define cpu_relax() ((void)0)
+#define might_sleep_if(x) ((void)(x))
+static ktime_t now;
+static ktime_t ktime_get(void) { return ++now; }
+static ktime_t ktime_add_us(ktime_t t, u64 us) { return t+us; }
+static int ktime_compare(ktime_t a, ktime_t b) { return (a>b)-(a<b); }
+static void usleep_range(unsigned a, unsigned b) { (void)b; now+=a; }
+struct generic_pm_domain { int unused; };
+struct meson_secure_pwrc { void *fw; };
+struct meson_secure_pwrc_domain {
+    struct generic_pm_domain base;
+    struct meson_secure_pwrc *pwrc;
+    unsigned index;
+    bool verify_state;
+};
+static unsigned sets, gets, target, mode;
+static int meson_sm_call(void *fw, unsigned cmd, s32 *value, unsigned index,
+                        unsigned state, unsigned a, unsigned b, unsigned c)
+{
+    (void)fw; (void)a; (void)b; (void)c; assert(index==5);
+    if (cmd==SM_A1_PWRC_SET) {
+        sets++; target=!state;
+        return mode==1 ? -EINVAL : 0;
+    }
+    assert(cmd==SM_A1_PWRC_GET); gets++;
+    if (mode==2) return -EINVAL;
+    if (mode==3) *value=-1;
+    else if (mode==4) *value=!target;
+    else if (mode==5) *value=2; /* malformed secure response */
+    else *value=gets<3 ? !target : target;
+    return 0;
+}
+'''
+checks = r'''
+int main(void)
+{
+    struct meson_secure_pwrc controller={};
+    struct meson_secure_pwrc_domain domain={.index=5,.pwrc=&controller,.verify_state=true};
+    const int expected[]={0,-EINVAL,-EINVAL,-EIO,-ETIMEDOUT,-ETIMEDOUT};
+    for (unsigned off=0; off<2; off++) {
+        for (mode=0; mode<6; mode++) {
+            sets=gets=0; now=0;
+            int ret=off ? meson_secure_pwrc_off(&domain.base) : meson_secure_pwrc_on(&domain.base);
+            assert(ret==expected[mode] && sets==1 && now<10100);
+            if (mode==1) assert(!gets);
+            if (mode==0) assert(gets==3);
+        }
+    }
+    domain.verify_state=false; mode=4; sets=gets=0;
+    assert(!meson_secure_pwrc_off(&domain.base) && sets==1 && !gets);
+    puts("Secure PWRC: 12 transition/failure cases and unmodified-domain behavior passed");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='secure-pwrc-') as directory:
+    path = Path(directory)
+    (path / 'linux').mkdir()
+    for name in ('kernel', 'types', 'ktime', 'delay', 'io'):
+        (path / 'linux' / f'{name}.h').write_text('/* supplied by harness */\n')
+    poll = root.parents[2] / 'include/linux/iopoll.h'
+    (path / 'pwrc.c').write_text(prefix + f'\n#include "{poll}"\n' + functions + checks)
+    subprocess.run(['cc', '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', '-I', str(path),
+                    str(path / 'pwrc.c'), '-o', str(path / 'pwrc')], check=True)
+    subprocess.run([str(path / 'pwrc')], check=True, timeout=10)
