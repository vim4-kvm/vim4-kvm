From b63f497e6f78132447e139d5a3ad70aa432ed47f Mon Sep 17 00:00:00 2001
From: Igor Pecovnik <igor@armbian.com>
Date: Tue, 13 Oct 2026 00:00:00 +0200
Subject: [PATCH] dt-bindings: clock: amlogic,axg-audio-clkc: add T7

The T7 audio clock controller has the S4 register layout.
Add the T7 compatible with the S4 fallback.

Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../bindings/clock/amlogic,axg-audio-clkc.yaml     | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/amlogic,axg-audio-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,axg-audio-clkc.yaml
index e296a97f5ce54..e3df512639fe9 100644
--- a/Documentation/devicetree/bindings/clock/amlogic,axg-audio-clkc.yaml
+++ b/Documentation/devicetree/bindings/clock/amlogic,axg-audio-clkc.yaml
@@ -17,11 +17,15 @@ description:
 
 properties:
   compatible:
-    enum:
-      - amlogic,axg-audio-clkc
-      - amlogic,g12a-audio-clkc
-      - amlogic,s4-audio-clkc
-      - amlogic,sm1-audio-clkc
+    oneOf:
+      - enum:
+          - amlogic,axg-audio-clkc
+          - amlogic,g12a-audio-clkc
+          - amlogic,s4-audio-clkc
+          - amlogic,sm1-audio-clkc
+      - items:
+          - const: amlogic,t7-audio-clkc
+          - const: amlogic,s4-audio-clkc
 
   '#clock-cells':
     const: 1
