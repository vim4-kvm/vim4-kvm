From 56db9a4d73ae99e81edd089c8ac8365ca6625e5f Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:39:37 -0700
Subject: [PATCH] media: capture limited BT709 YUV444 SDR with shared legacy
 EDID

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 32 +++++++++++++++----
 .../platform/amlogic/t7-hdmirx/test_core.py   | 16 +++++++++-
 .../platform/amlogic/t7-hdmirx/test_link.py   |  1 +
 3 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index fd7b7dd96e124..64f854b9e36ce 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -232,6 +232,7 @@ struct t7_hdmirx {
 	bool hdr_capture;
 	bool lease_hdr;
 	bool lease_yuv;
+	bool lease_420;
 	unsigned long long drm_received_ns;
 	u8 saved_unrec_ctrl, saved_unrec_type;
 	u8 saved_packet_irq_mode;
@@ -789,10 +790,27 @@ static bool t7_hdmirx_sdr420_input(struct t7_hdmirx *rx)
 		!(avi[8] & 0xc0) && avi[7] == 97;
 }
 
+static bool t7_hdmirx_sdr444_input(struct t7_hdmirx *rx)
+{
+	u8 avi[17], again[17];
+	unsigned int i;
+
+	/* A zero GCP depth code means unspecified, which is also legal for 8-bit. */
+	if (readb(rx->cor + T7_RX_COR_COLOR_DEPTH) > 4)
+		return false;
+	for (i = 0; i < sizeof(avi); i++)
+		avi[i] = readb(rx->cor + T7_RX_COR_AVI_PACKET + i);
+	for (i = 0; i < sizeof(again); i++)
+		again[i] = readb(rx->cor + T7_RX_COR_AVI_PACKET + i);
+	return !memcmp(avi, again, sizeof(avi)) &&
+		t7_hdmirx_packet_valid(avi, 0x82, 2, 13) &&
+		(avi[4] >> 5) == 2 && (avi[5] >> 6) == 2 && !(avi[8] & 0xc0);
+}
+
 static int t7_hdmirx_video_status(struct t7_hdmirx *rx)
 {
 	u32 ticks, reference;
-	bool hdr, yuv;
+	bool hdr, yuv, yuv420;
 
 	if (!rx || !rx->core_active)
 		return -ENOLINK;
@@ -807,17 +825,18 @@ static int t7_hdmirx_video_status(struct t7_hdmirx *rx)
 	if (readb(rx->cor + T7_RX_COR_FRAME_STATUS) & BIT(2))
 		return -ERANGE;
 	hdr = t7_hdmirx_hdr_input(rx);
-	yuv = hdr || t7_hdmirx_sdr420_input(rx);
+	yuv420 = hdr || t7_hdmirx_sdr420_input(rx);
+	yuv = yuv420 || t7_hdmirx_sdr444_input(rx);
 	if (!yuv && (readl(rx->top + T7_RX_TOP_VID_STAT) & GENMASK(23, 20) ||
 	    readb(rx->cor + T7_RX_COR_COLOR_DEPTH) > 4))
 		return -ERANGE;
 	if (rx->link && rx->link->users &&
-	    (hdr != rx->lease_hdr || yuv != rx->lease_yuv))
+	    (hdr != rx->lease_hdr || yuv != rx->lease_yuv || yuv420 != rx->lease_420))
 		return -ENOLINK;
-	if (t7_hdmirx_core_read16(rx, T7_RX_COR_WIDTH) != (yuv ? 1920 : rx->uhd60 ? 3840 : 1920) ||
+	if (t7_hdmirx_core_read16(rx, T7_RX_COR_WIDTH) != (yuv420 ? 1920 : rx->uhd60 ? 3840 : 1920) ||
 	    t7_hdmirx_core_read16(rx, T7_RX_COR_HEIGHT) != (rx->uhd60 ? 2160 : 1080) ||
 	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_LOW) +
-	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH) != (yuv ? 2200 : rx->uhd60 ? 4400 : 2200) ||
+	    t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_HIGH) != (yuv420 ? 2200 : rx->uhd60 ? 4400 : 2200) ||
 	    t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_LOW) +
 	    t7_hdmirx_core_read16(rx, T7_RX_COR_VSYNC_HIGH) != (rx->uhd60 ? 2250 : 1125))
 		return -ERANGE;
@@ -1226,7 +1245,8 @@ int t7_hdmirx_stream_get(struct device *dev, unsigned int width, unsigned int he
 		ret = -EPIPE;
 	if (!ret) {
 		rx->lease_hdr = t7_hdmirx_hdr_input(rx);
-		rx->lease_yuv = rx->lease_hdr || t7_hdmirx_sdr420_input(rx);
+		rx->lease_420 = rx->lease_hdr || t7_hdmirx_sdr420_input(rx);
+		rx->lease_yuv = rx->lease_420 || t7_hdmirx_sdr444_input(rx);
 		rx->link->users++;
 	}
 	mutex_unlock(&rx->link->lock);
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
index a87c16d561328..c29d84e10d24f 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
@@ -216,10 +216,24 @@ int main(void)
     assert(t7_hdmirx_sdr420_input(&rx) && !t7_hdmirx_video_status(&rx));
     struct t7_hdmirx_link lease={.users=1};
     u32 pll=T7_RX_PHY_PLL_LOCK;rx.phy=core;memcpy(core+T7_RX_PHY_APLL0,&pll,4);
-    rx.link=&lease;rx.lease_yuv=true;rx.lease_hdr=true;
+    rx.link=&lease;rx.lease_yuv=true;rx.lease_hdr=true;rx.lease_420=true;
     assert(t7_hdmirx_video_status(&rx)==-ENOLINK); /* HDR -> SDR, same geometry */
     rx.lease_hdr=false;assert(!t7_hdmirx_video_status(&rx));
     rx.lease_yuv=false;assert(t7_hdmirx_video_status(&rx)==-ENOLINK);
+    unsigned char sdr444[17]={0x82,2,13,0x14,0x52,0xa8,0,0x61};
+    memcpy(core+0x1140,sdr444,sizeof(sdr444));core[T7_RX_COR_COLOR_DEPTH]=0;
+    word(T7_RX_COR_WIDTH,3840);word(T7_RX_COR_HSYNC_LOW,4312);word(T7_RX_COR_HSYNC_HIGH,88);
+    assert(t7_hdmirx_sdr444_input(&rx));
+    rx.lease_yuv=true;assert(t7_hdmirx_video_status(&rx)==-ENOLINK); /* 420 -> 444 */
+    rx.lease_420=false;assert(!t7_hdmirx_video_status(&rx));
+    core[T7_RX_COR_COLOR_DEPTH]=5;assert(!t7_hdmirx_sdr444_input(&rx));
+    core[T7_RX_COR_COLOR_DEPTH]=4;assert(t7_hdmirx_sdr444_input(&rx));
+    core[0x1140+8]=0x40;core[0x1140+3]-=0x40;
+    assert(!t7_hdmirx_sdr444_input(&rx)); /* full-range YCbCr needs a different matrix */
+    memcpy(core+0x1140,sdr444,sizeof(sdr444));core[0x1140+3]^=1;
+    assert(!t7_hdmirx_sdr444_input(&rx)); /* corrupt AVI */
+    word(T7_RX_COR_WIDTH,1920);word(T7_RX_COR_HSYNC_LOW,2156);word(T7_RX_COR_HSYNC_HIGH,44);
+    core[T7_RX_COR_COLOR_DEPTH]=5;
     rx.link=NULL;memcpy(core+0x1140,avi,sizeof(avi));
     core[0x1134]=BIT(4);t7_hdmirx_update_drm(&rx);
     core[0x1140+3]^=1;assert(!t7_hdmirx_hdr_input(&rx));
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_link.py b/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
index 18d2fb63d0c60..0fd36762efb5d 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
@@ -46,6 +46,7 @@ struct device { void *data; };
 stubs = r'''
 static bool t7_hdmirx_hdr_input(struct t7_hdmirx *rx) { (void)rx; return false; }
 static bool t7_hdmirx_sdr420_input(struct t7_hdmirx *rx) { (void)rx; return false; }
+static bool t7_hdmirx_sdr444_input(struct t7_hdmirx *rx) { (void)rx; return false; }
 static void t7_hdmirx_update_drm(struct t7_hdmirx *rx) { (void)rx; }
 static bool signal_valid, source_present, hdmi2 = true, pll_fail, late_alignment, lose_during_wait;
 static bool unsupported_signal;
