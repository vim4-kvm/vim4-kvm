From ff950620e8753f212998ee7a246ff768643a1e83 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Thu, 22 Oct 2026 14:33:29 +0800
Subject: [PATCH] Apply PQ tone mapping after native YUV transport
 normalization

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c     | 18 +++++++++++++-----
 .../platform/amlogic/t7-hdmirx/test_timings.py | 17 +++++++++++++++++
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index c4e3798a5d74e..cbe545b54614f 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -813,6 +813,7 @@ static bool t7_hdmirx_hdr_input(struct t7_hdmirx *rx)
 {
 	u8 avi[17], again[17];
 	u64 received = READ_ONCE(rx->drm_received_ns);
+	u8 depth = readb(rx->cor + T7_RX_COR_COLOR_DEPTH);
 	unsigned int i;
 
 	if (!rx->hdr_capture || !received || ktime_get_ns() - received > 1000000000ULL)
@@ -821,11 +822,18 @@ static bool t7_hdmirx_hdr_input(struct t7_hdmirx *rx)
 		avi[i] = readb(rx->cor + 0x1140 + i);
 	for (i = 0; i < sizeof(again); i++)
 		again[i] = readb(rx->cor + 0x1140 + i);
-	return !memcmp(avi, again, sizeof(avi)) &&
-		t7_hdmirx_packet_valid(avi, 0x82, 2, 13) &&
-		(avi[4] >> 5) == 3 && (avi[5] >> 6) == 3 &&
-		((avi[6] >> 4) & 7) == 6 && !(avi[8] & 0xc0) &&
-		avi[7] == 97 && readb(rx->cor + T7_RX_COR_COLOR_DEPTH) == 5;
+	if (memcmp(avi, again, sizeof(avi)) ||
+	    !t7_hdmirx_packet_valid(avi, 0x82, 2, 13) ||
+	    (avi[5] >> 6) != 3 || ((avi[6] >> 4) & 7) != 6 || (avi[8] & 0xc0))
+		return false;
+	/* HDR2 receives normalized Y/Cb/Cr after TOP's unpacker for each YUV
+	 * transport. Its PQ/2020 matrices and LUTs are independent of timing.
+	 * RGB/2020 needs a different input matrix and remains unsupported.
+	 */
+	if (rx->dynamic_modes)
+		return (avi[4] >> 5) >= 1 && (avi[4] >> 5) <= 3 &&
+			(depth == 0 || depth == 4 || depth == 5 || depth == 6);
+	return (avi[4] >> 5) == 3 && avi[7] == 97 && depth == 5;
 }
 
 /* macOS can keep the same 420/10-bit transport when HDR is disabled. Its
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
index 0c72f4133cc96..3afe8aa6ec0fe 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
@@ -237,6 +237,23 @@ int main(void) {
     struct t7_hdmirx_color color;
     assert(t7_hdmirx_read_color(&rx,&color)==-ERANGE); /* Unmapped HLG/2020. */
     avi[5]^=1; assert(t7_hdmirx_read_color(&rx,&color)==-ERANGE);
+    /* PQ/2020 HDR2 follows normalized YUV, including 422's fixed transport
+     * container with an unspecified GCP depth. Fresh metadata is mandatory.
+     */
+    rx.hdr_capture=true;rx.drm_received_ns=1000000000ULL;
+    for (unsigned int space=1;space<4;space++) {
+        memset(avi,0,17);avi[0]=0x82;avi[1]=2;avi[2]=13;
+        avi[4]=space<<5;avi[5]=3<<6;avi[6]=6<<4;
+        for (unsigned int j=0;j<17;j++)if(j!=3)avi[3]-=avi[j];
+        u32 top_color=space<<20;memcpy(top+T7_RX_TOP_VID_STAT,&top_color,4);
+        core[T7_RX_COR_COLOR_DEPTH]=space==1?0:6;
+        assert(t7_hdmirx_hdr_input(&rx));
+        assert(!t7_hdmirx_read_color(&rx,&color));
+        rx.drm_received_ns=0;
+        assert(!t7_hdmirx_hdr_input(&rx));
+        assert(t7_hdmirx_read_color(&rx,&color)==-ERANGE);
+        rx.drm_received_ns=1000000000ULL;
+    }
     puts("RGB/444/422/420, 8/10/12-bit, range/601/709 and unsupported HDR guards passed");
     puts("Measured timing ioctls: UHD/FHD, fractional rate, torn counter, loss, unsupported modes passed");
 }
