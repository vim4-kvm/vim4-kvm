From 5a2f2262cdadad59a38a94f12311da35df362811 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 22:32:37 +0800
Subject: [PATCH] media: t7-vdin: scale capture independently of HDMI timing

---
 .../platform/amlogic/t7-hdmirx/t7-vdin-test.c | 97 ++++++++++++++++---
 .../amlogic/t7-hdmirx/test_ioctl_locks.py     | 11 +++
 .../platform/amlogic/t7-hdmirx/test_stream.py |  2 +
 .../platform/amlogic/t7-hdmirx/test_vdin.py   | 17 ++++
 4 files changed, 116 insertions(+), 11 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
index e5e0e315577de..e1aa290df1bb2 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
@@ -39,12 +39,16 @@ module_param(direct_dma, bool, 0400);
 MODULE_PARM_DESC(direct_dma, "Capture into leased coherent vb2 buffers without a CPU frame copy");
 
 /* VCBUS word indices; the accessors alone convert them to byte offsets. */
+#define VDIN_SCALE_COEF_IDX	0x1200
+#define VDIN_SCALE_COEF		0x1201
 #define VDIN_COM_CTRL0		0x1202
 #define VDIN_ACTIVE_PIXELS	0x1203
 #define VDIN_LCNT_STATUS		0x1204
 #define VDIN_ASFIFO_CTRL1		0x1209
 #define VDIN_WIDTHS		0x120a
 #define VDIN_SC_MISC_CTRL		0x120b
+#define VDIN_HSC_PHASE_STEP	0x120c
+#define VDIN_HSC_INI_CTRL		0x120d
 #define VDIN_MATRIX_CTRL		0x1210
 #define VDIN_LFIFO_CTRL		0x121a
 #define VDIN_GCLK_CTRL		0x121b
@@ -53,6 +57,10 @@ MODULE_PARM_DESC(direct_dma, "Capture into leased coherent vb2 buffers without a
 #define VDIN_WR_CTRL		0x1220
 #define VDIN_WR_H_WIN		0x1221
 #define VDIN_WR_V_WIN		0x1222
+#define VDIN_VSC_PHASE_STEP	0x1223
+#define VDIN_VSC_INI_CTRL		0x1224
+#define VDIN_SCIN_HEIGHT		0x1225
+#define VDIN_DUMMY_DATA		0x1226
 #define VDIN_WR_URGENT		0x1257
 #define VDIN_WR_STATUS		0x1258
 #define VDIN_GCLK_CTRL2		0x1270
@@ -105,6 +113,8 @@ struct t7_vdin_snapshot {
 
 struct t7_vdin {
 	unsigned int width, height, stride, frame_size, allocation_size, frame_capacity;
+	/* Source lease geometry is independent of the downscaled DMA image. */
+	unsigned int input_width, input_height;
 	u32 pixel_format;
 	bool nv12;
 	bool direct_dma;
@@ -313,6 +323,39 @@ static int t7_vdin_stop_dma(struct t7_vdin *vdin)
 	return ret;
 }
 
+static void t7_vdin_configure_scale(struct t7_vdin *vdin)
+{
+	static const u32 bicubic[] = {
+		0x00800000, 0x007f0100, 0xff7f0200, 0xfe7f0300, 0xfd7e0500,
+		0xfc7e0600, 0xfb7d0800, 0xfb7c0900, 0xfa7b0b00, 0xfa7a0dff,
+		0xf9790fff, 0xf97711ff, 0xf87613ff, 0xf87416fe, 0xf87218fe,
+		0xf8701afe, 0xf76f1dfd, 0xf76d1ffd, 0xf76b21fd, 0xf76824fd,
+		0xf76627fc, 0xf76429fc, 0xf7612cfc, 0xf75f2ffb, 0xf75d31fb,
+		0xf75a34fb, 0xf75837fa, 0xf7553afa, 0xf8523cfa, 0xf8503ff9,
+		0xf84d42f9, 0xf84a45f9, 0xf84848f8,
+	};
+	unsigned int i;
+
+	t7_vdin_write(vdin, VDIN_SC_MISC_CTRL, 0);
+	t7_vdin_write(vdin, VDIN_VSC_INI_CTRL, 0);
+	if (vdin->width != vdin->input_width) {
+		t7_vdin_write(vdin, VDIN_SCALE_COEF_IDX, 0x100);
+		for (i = 0; i < ARRAY_SIZE(bicubic); i++)
+			t7_vdin_write(vdin, VDIN_SCALE_COEF, bicubic[i]);
+		t7_vdin_write(vdin, VDIN_HSC_PHASE_STEP,
+			      ((u64)vdin->input_width << 24) / vdin->width);
+		t7_vdin_write(vdin, VDIN_HSC_INI_CTRL, BIT(29) | (4 << 24));
+		t7_vdin_write(vdin, VDIN_SC_MISC_CTRL, BIT(6) | BIT(5) | BIT(4) | 4);
+	}
+	if (vdin->height != vdin->input_height) {
+		t7_vdin_write(vdin, VDIN_VSC_PHASE_STEP,
+			      ((u64)vdin->input_height << 20) / vdin->height);
+		t7_vdin_write(vdin, VDIN_SCIN_HEIGHT, vdin->input_height - 1);
+		t7_vdin_write(vdin, VDIN_DUMMY_DATA, 0x008080);
+		t7_vdin_write(vdin, VDIN_VSC_INI_CTRL, BIT(23) | 0x8000);
+	}
+}
+
 static void t7_vdin_configure(struct t7_vdin *vdin)
 {
 	t7_vdin_write(vdin, VDIN_WR_CTRL, 0);
@@ -326,9 +369,9 @@ static void t7_vdin_configure(struct t7_vdin *vdin)
 	t7_vdin_write(vdin, VDIN_ASFIFO_CTRL1, 0xe40000);
 	t7_vdin_update(vdin, VPU_SW_RESET, BIT(26), BIT(26));
 	t7_vdin_update(vdin, VPU_SW_RESET, BIT(26), 0);
-	t7_vdin_write(vdin, VDIN_WIDTHS, ((vdin->width - 1) << 16) | (vdin->width - 1));
-	t7_vdin_write(vdin, VDIN_INTF_WIDTH, vdin->width - 1);
-	t7_vdin_write(vdin, VDIN_SC_MISC_CTRL, 0);
+	t7_vdin_write(vdin, VDIN_WIDTHS, ((vdin->input_width - 1) << 16) | (vdin->width - 1));
+	t7_vdin_write(vdin, VDIN_INTF_WIDTH, vdin->input_width - 1);
+	t7_vdin_configure_scale(vdin);
 	t7_vdin_write(vdin, VDIN_VSHRK_CTRL, 0);
 	t7_vdin_write(vdin, VDIN_MATRIX_CTRL, 0);
 	t7_vdin_write(vdin, VDIN_HDR_CTRL, 0);
@@ -393,7 +436,7 @@ static int t7_vdin_capture(struct t7_vdin *vdin)
 
 	if (vdin->faulted)
 		return -EIO;
-	ret = t7_hdmirx_stream_get(vdin->receiver, vdin->width, vdin->height);
+	ret = t7_hdmirx_stream_get(vdin->receiver, vdin->input_width, vdin->input_height);
 	if (ret)
 		return ret;
 	if (!vdin->nv12 && t7_hdmirx_stream_is_yuv(vdin->receiver)) {
@@ -822,7 +865,7 @@ static int t7_vdin_start_streaming(struct vb2_queue *queue, unsigned int count)
 
 	mutex_lock(&vdin->lock);
 	ret = vdin->faulted ? -EIO :
-		t7_hdmirx_stream_get(vdin->receiver, vdin->width, vdin->height);
+		t7_hdmirx_stream_get(vdin->receiver, vdin->input_width, vdin->input_height);
 	if (!ret && !vdin->nv12 && t7_hdmirx_stream_is_yuv(vdin->receiver)) {
 		t7_hdmirx_stream_put(vdin->receiver);
 		ret = -EOPNOTSUPP;
@@ -955,23 +998,51 @@ static int t7_vdin_get_fmt(struct file *file, void *priv, struct v4l2_format *fm
 	return 0;
 }
 
-static int t7_vdin_try_fmt(struct file *file, void *priv, struct v4l2_format *fmt)
+static int t7_vdin_negotiate_fmt(struct t7_vdin *vdin, struct v4l2_format *fmt,
+				struct v4l2_dv_timings *timings)
 {
-	struct t7_vdin *vdin = video_drvdata(file);
-	struct v4l2_dv_timings timings;
 	struct v4l2_fract interval;
+	unsigned int width = fmt->fmt.pix.width, height = fmt->fmt.pix.height;
 	int ret;
 
-	ret = t7_hdmirx_query_timings(vdin->receiver, &timings, &interval);
+	ret = t7_hdmirx_query_timings(vdin->receiver, timings, &interval);
 	if (ret)
 		return ret;
-	t7_vdin_fill_fmt(vdin, fmt, timings.bt.width, timings.bt.height);
+	if (timings->bt.width > 3840 || timings->bt.height > 2160)
+		return -ERANGE;
+	if (!vdin->nv12 || !width || !height) {
+		width = timings->bt.width;
+		height = timings->bt.height;
+	} else {
+		/* MIF strides are 16-byte units; NV12 chroma needs even height.
+		 * Keep downscale ratios within the scaler's phase-step range.
+		 */
+		if (width < 320)
+			width = 320;
+		if (height < 180)
+			height = 180;
+		if (width > timings->bt.width)
+			width = timings->bt.width;
+		if (height > timings->bt.height)
+			height = timings->bt.height;
+		width &= ~15U;
+		height &= ~1U;
+	}
+	t7_vdin_fill_fmt(vdin, fmt, width, height);
 	return 0;
 }
 
+static int t7_vdin_try_fmt(struct file *file, void *priv, struct v4l2_format *fmt)
+{
+	struct v4l2_dv_timings timings;
+
+	return t7_vdin_negotiate_fmt(video_drvdata(file), fmt, &timings);
+}
+
 static int t7_vdin_set_fmt(struct file *file, void *priv, struct v4l2_format *fmt)
 {
 	struct t7_vdin *vdin = video_drvdata(file);
+	struct v4l2_dv_timings timings;
 	int ret;
 
 	/* The core holds video_lock here. Disconnect takes queue_mutex first;
@@ -982,7 +1053,7 @@ static int t7_vdin_set_fmt(struct file *file, void *priv, struct v4l2_format *fm
 	ret = -EBUSY;
 	if (vb2_is_busy(&vdin->queue) || !mutex_trylock(&vdin->lock))
 		goto unlock_queue;
-	ret = vdin->faulted ? -EIO : t7_vdin_try_fmt(file, priv, fmt);
+	ret = vdin->faulted ? -EIO : t7_vdin_negotiate_fmt(vdin, fmt, &timings);
 	if (!ret) {
 		unsigned int frame_size = fmt->fmt.pix.bytesperline * fmt->fmt.pix.height;
 
@@ -991,6 +1062,8 @@ static int t7_vdin_set_fmt(struct file *file, void *priv, struct v4l2_format *fm
 		if (frame_size > vdin->frame_capacity) {
 			ret = -ERANGE;
 		} else {
+			vdin->input_width = timings.bt.width;
+			vdin->input_height = timings.bt.height;
 			vdin->width = fmt->fmt.pix.width;
 			vdin->height = fmt->fmt.pix.height;
 			vdin->stride = fmt->fmt.pix.bytesperline;
@@ -1368,6 +1441,8 @@ static int t7_vdin_probe(struct platform_device *pdev)
 		return ret;
 	vdin->nv12 = nv12;
 	vdin->pixel_format = nv12 ? V4L2_PIX_FMT_NV12 : V4L2_PIX_FMT_RGB24;
+	vdin->input_width = vdin->width;
+	vdin->input_height = vdin->height;
 	vdin->stride = vdin->width * (nv12 ? 1 : 3);
 	vdin->frame_size = vdin->stride * vdin->height;
 	if (nv12)
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_ioctl_locks.py b/drivers/media/platform/amlogic/t7-hdmirx/test_ioctl_locks.py
index 93a7147e9328e..0e9d4861e650f 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_ioctl_locks.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_ioctl_locks.py
@@ -65,6 +65,7 @@ struct t7_vdin {
     struct video_device video; struct vb2_queue queue;
     struct device *dev,*receiver; struct v4l2_device v4l2; unsigned int ref;
     unsigned int width,height,pixel_format,stride,allocation_size,frame_capacity,frame_size;
+    unsigned int input_width,input_height;
     bool nv12,faulted;
 };
 struct file { struct t7_vdin *data; };
@@ -221,6 +222,15 @@ int main(void) {
     assert(independent && query.result==-ENOLINK && format.result==-EBUSY);
     struct v4l2_format fmt={0}; input_locked=true;
     assert(!dispatch(VIDIOC_S_FMT,&fmt) && fmt.fmt.pix.width==3840);
+    assert(capture.input_width==3840 && capture.input_height==2160);
+    fmt.fmt.pix.width=1280; fmt.fmt.pix.height=720;
+    struct file format_file={.data=&capture};
+    assert(!t7_vdin_try_fmt(&format_file,NULL,&fmt));
+    assert(fmt.fmt.pix.width==1280 && fmt.fmt.pix.height==720);
+    assert(!dispatch(VIDIOC_S_FMT,&fmt) && capture.width==1280);
+    assert(capture.input_width==3840 && capture.frame_size==1280*720*3/2);
+    fmt.fmt.pix.width=3840; fmt.fmt.pix.height=2160;
+    assert(!dispatch(VIDIOC_S_FMT,&fmt));
     capture.queue.busy=true; assert(dispatch(VIDIOC_S_FMT,&fmt)==-EBUSY);
     capture.queue.busy=false;
     input_width=1920; input_height=1080;
@@ -234,6 +244,7 @@ int main(void) {
     input_width=5000; input_height=3000;
     assert(dispatch(VIDIOC_S_FMT,&fmt)==-ERANGE && capture.width==1920);
     input_width=3840; input_height=2160;
+    fmt.fmt.pix.width=3840; fmt.fmt.pix.height=2160;
     assert(!dispatch(VIDIOC_S_FMT,&fmt) && capture.width==3840);
     /* A query already using RX must finish before removal clears registration. */
     pause_query=true; query_entered=query_done=false; capture.queue.owner=&capture;
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py b/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
index 5557781013812..55dd7f47dc686 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
@@ -33,6 +33,7 @@ typedef int irqreturn_t;
 #define MODULE_PARM_DESC(...)
 #define __iomem
 #define BIT(n) (1U<<(n))
+#define ARRAY_SIZE(a) (sizeof(a)/sizeof((a)[0]))
 #define GENMASK(h,l) ((~0U>>(31-(h))) & (~0U<<(l)))
 #define IRQ_HANDLED 1
 #define THIS_MODULE NULL
@@ -265,6 +266,7 @@ static void setup(struct t7_vdin_buffer b[4]) {
     receiver.queued.next=receiver.queued.prev=&receiver.queued;
     receiver.queue.priv=&receiver; receiver.queue.mem_ops=&mem_ops; receiver.regs=registers;
     receiver.width=1920; receiver.height=1080; receiver.stride=5760;
+    receiver.input_width=1920; receiver.input_height=1080;
     receiver.frame_size=VDIN_FRAME_SIZE;
     receiver.allocation_size=VDIN_FRAME_SIZE;
     started=entered=permits=completed=pins=stop_waiting=0;
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py b/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
index 2411aec3adc01..76e68db48367b 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_vdin.py
@@ -27,6 +27,7 @@ typedef int irqreturn_t;
 #define VDIN_STRIDE (1920U*3U)
 #define __iomem
 #define BIT(n) (1U << (n))
+#define ARRAY_SIZE(a) (sizeof(a)/sizeof((a)[0]))
 #define GENMASK(h, l) ((~0U >> (31 - (h))) & (~0U << (l)))
 #define IRQ_HANDLED 1
 #define THIS_MODULE ((void *)0)
@@ -111,6 +112,7 @@ static int t7_hdmirx_check_video(struct device *dev)
 }
 static int t7_hdmirx_stream_get(struct device *dev, unsigned int width, unsigned int height)
 {
+    assert(width==receiver.input_width && height==receiver.input_height);
     int ret = t7_hdmirx_check_video(dev);
     if (!ret) receiver_users++;
     return ret;
@@ -153,6 +155,7 @@ static void reset(void)
     memset(frame, 0xa5, sizeof(frame));
     receiver = (struct t7_vdin) { .regs = registers, .frame = frame,
                                .frame_dma = 0x10000000, .width = 1920, .height = 1080,
+                               .input_width = 1920, .input_height = 1080,
                                .stride = VDIN_STRIDE, .frame_size = VDIN_FRAME_SIZE };
     pins = requests = timing_checks = receiver_users = 0;
     timeout = busy = bad_timing = change_timing = false;
@@ -170,6 +173,7 @@ int main(void)
     assert(!t7_vdin_capture(&receiver) && receiver.snapshots == 2);
     reset(); receiver.nv12 = true;
     receiver.width = 3840; receiver.height = 2160; receiver.stride = 3840;
+    receiver.input_width = 3840; receiver.input_height = 2160;
     receiver.frame_size = 3840U * 2160U * 3U / 2;
     assert(!t7_vdin_capture(&receiver));
     assert(frame[receiver.frame_size - 1] == 0x5a && frame[receiver.frame_size] == 0xa5);
@@ -177,6 +181,19 @@ int main(void)
     assert((readl(registers + VDIN_LFIFO_CTRL * 4) & 0x3fff) == 0x780);
     assert((readl(registers + VDIN_WR_CTRL * 4) >> 12 & 3) == 2);
     assert(readl(registers + VDIN_WR_CHROMA_STRIDE * 4) == 3840U / 16);
+    /* Full HDMI input feeds a smaller DMA image; switching back disables scaling. */
+    receiver.width=1920; receiver.height=1080; receiver.stride=1920;
+    receiver.frame_size=1920U*1080U*3/2;
+    assert(!t7_vdin_capture(&receiver));
+    assert(readl(registers+VDIN_WIDTHS*4)==((3839U<<16)|1919));
+    assert(readl(registers+VDIN_HSC_PHASE_STEP*4)==2U<<24);
+    assert(readl(registers+VDIN_VSC_PHASE_STEP*4)==2U<<20);
+    assert(readl(registers+VDIN_VSC_INI_CTRL*4)&BIT(23));
+    receiver.width=3840; receiver.height=2160; receiver.stride=3840;
+    receiver.frame_size=3840U*2160U*3/2;
+    assert(!t7_vdin_capture(&receiver));
+    assert(!readl(registers+VDIN_SC_MISC_CTRL*4));
+    assert(!readl(registers+VDIN_VSC_INI_CTRL*4));
     reset(); receiver.nv12=true;hdr_input=true;
     t7_vdin_configure(&receiver);
     assert(pq_writes==143 && gain_writes==75 && oetf_writes==75);
