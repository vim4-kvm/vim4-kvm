From 1aec254af6e47784ea18331bcb137926247d72f2 Mon Sep 17 00:00:00 2001
From: deepdream <deepdream@deepdremsMinim4.lan>
Date: Wed, 21 Oct 2026 00:31:22 -0700
Subject: [PATCH] media: t7-hdmirx: add guarded HDR link observation

---
 .../platform/amlogic/t7-hdmirx/README.md      | 10 ++++
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 58 ++++++++++++++++++-
 .../platform/amlogic/t7-hdmirx/test_core.py   | 14 ++++-
 .../platform/amlogic/t7-hdmirx/test_link.py   | 24 ++++++++
 4 files changed, 104 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/README.md b/drivers/media/platform/amlogic/t7-hdmirx/README.md
index 0323cf72be9bd..d182f11f3ba7f 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/README.md
+++ b/drivers/media/platform/amlogic/t7-hdmirx/README.md
@@ -9,6 +9,16 @@ rewrite EDID. `uhd60` selects the fixed profile by default. With the additional
 `dynamic_modes=1`, the stable cable clock and SCDC ratio select RGB8 1080p60 or
 UHD60 automatically. Other resolutions/rates/formats are rejected.
 
+`hdr_probe=1` additionally allows the 92.8125 MHz reference of a 371.25 MHz
+HDMI 2.0 character clock to lock for metadata observation. It requires the
+dynamic mode experiment and still boots with its validated SDR EDID. The PHY
+coefficients/dividers match the UHD profile; an aligned unsupported signal is
+kept intact rather than repeatedly reset. The unrecognized-packet bank selects
+DRM type 0x87 without enabling packet DMA, and is restored on core shutdown.
+Debugfs exposes raw AVI/DRM candidates, without a freshness or HDR-readiness
+claim. YCbCr/deep-colour frames remain rejected before a capture lease is
+acquired. This is receiver characterization, not HDR capture or tone mapping.
+
 `VIDIOC_QUERY_DV_TIMINGS` and `VIDIOC_G_PARM` report a live measurement for the
 qualified profile, including fractional rates near 60 Hz. Frame period comes
 from the RX reference-clock counter, not from the capture buffer dimensions.
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index 465abe76b78a5..047a5118488e2 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -133,6 +133,10 @@
 #define T7_RX_COR_AUDIO_MCLK	0x1401
 #define T7_RX_COR_AUDIO_TDM1	0x1440
 #define T7_RX_COR_AUDIO_TDM2	0x1441
+#define T7_RX_COR_AVI_PACKET	0x1140
+#define T7_RX_COR_UNREC_CTRL	0x115e
+#define T7_RX_COR_UNREC_TYPE	0x115f
+#define T7_RX_COR_UNREC_PACKET	0x11c0
 
 static char *edid_firmware;
 module_param(edid_firmware, charp, 0400);
@@ -154,6 +158,10 @@ static bool dynamic_modes;
 module_param(dynamic_modes, bool, 0400);
 MODULE_PARM_DESC(dynamic_modes, "Automatically select RGB8 1080p60/UHD60; requires uhd60=1");
 
+static bool hdr_probe;
+module_param(hdr_probe, bool, 0400);
+MODULE_PARM_DESC(hdr_probe, "Lock the 371.25 MHz HDR trial link for packet observation; HDR capture remains disabled");
+
 static bool audio_test;
 module_param(audio_test, bool, 0400);
 MODULE_PARM_DESC(audio_test, "Opt-in stereo LPCM ALSA capture codec for the dedicated audio DTB");
@@ -215,6 +223,8 @@ struct t7_hdmirx {
 	struct t7_hdmirx_link *link;
 	bool uhd60;
 	bool dynamic_modes;
+	bool hdr_probe;
+	u8 saved_unrec_ctrl, saved_unrec_type;
 	struct mutex audio_lock;
 	u8 saved_ddc_switch, saved_sink_version, saved_tmds_config;
 	void __iomem *top;
@@ -575,6 +585,10 @@ static void t7_hdmirx_core_stop(void *data)
 	writeb(rx->saved_ddc_switch, rx->cor + T7_RX_COR_DDC_SWITCH);
 	writeb(rx->saved_sink_version, rx->cor + T7_RX_COR_SINK_VERSION);
 	writeb(rx->saved_tmds_config, rx->cor + T7_RX_COR_TMDS_CONFIG);
+	if (rx->hdr_probe) {
+		writeb(rx->saved_unrec_type, rx->cor + T7_RX_COR_UNREC_TYPE);
+		writeb(rx->saved_unrec_ctrl, rx->cor + T7_RX_COR_UNREC_CTRL);
+	}
 	rx->core_active = false;
 }
 
@@ -606,6 +620,10 @@ static int t7_hdmirx_core_start(struct t7_hdmirx *rx)
 	rx->core_saved_phyck[0] = readb(rx->cor + T7_RX_COR_PHY_CLOCK1);
 	rx->core_saved_phyck[1] = readb(rx->cor + T7_RX_COR_PHY_CLOCK2);
 	rx->core_saved_phyck[2] = readb(rx->cor + T7_RX_COR_PHY_CLOCK3);
+	if (rx->hdr_probe) {
+		rx->saved_unrec_ctrl = readb(rx->cor + T7_RX_COR_UNREC_CTRL);
+		rx->saved_unrec_type = readb(rx->cor + T7_RX_COR_UNREC_TYPE);
+	}
 	rx->core_active = true;
 	/* Hold AON reset while removing TMDS isolation and selecting PHY lanes. */
 	writeb(1, rx->cor + T7_RX_COR_AON_RESET);
@@ -652,6 +670,11 @@ static int t7_hdmirx_core_start(struct t7_hdmirx *rx)
 	if (readb(rx->cor + T7_RX_COR_SYS_CTRL) != 3 ||
 	    readb(rx->cor + T7_RX_COR_PHY_CLOCK1) != 0xff)
 		return -EIO;
+	if (rx->hdr_probe) {
+		/* Capture static metadata in the byte register bank, without packet DMA. */
+		writeb(0x87, rx->cor + T7_RX_COR_UNREC_TYPE);
+		writeb(1, rx->cor + T7_RX_COR_UNREC_CTRL);
+	}
 	if (rx->uhd60)
 		t7_hdmirx_set_hpd(rx, true);
 	return 0;
@@ -1036,6 +1059,18 @@ void t7_hdmirx_stream_put(struct device *dev)
 }
 EXPORT_SYMBOL_GPL(t7_hdmirx_stream_put);
 
+static bool t7_hdmirx_cable_supported(struct t7_hdmirx *rx, u32 cable, bool hdmi2)
+{
+	if (cable >= 146500000 && cable <= 150500000)
+		return true;
+	/* 4K60 YCbCr420 10-bit uses a 371.25 MHz character clock at 1:40.
+	 * Its PHY_BW_4 coefficients and PLL divider match the UHD RGB8 trial.
+	 * Admission here only permits PHY observation; video_status still rejects
+	 * YCbCr/deep-colour input before any capture lease can be acquired.
+	 */
+	return rx->hdr_probe && hdmi2 && cable >= 90812500 && cable <= 94812500;
+}
+
 static void t7_hdmirx_link_work(struct work_struct *work)
 {
 	struct t7_hdmirx_link *link = container_of(to_delayed_work(work),
@@ -1059,12 +1094,19 @@ static void t7_hdmirx_link_work(struct work_struct *work)
 	/* A live or quarantined MIF owns its receiver until DMA is safe. */
 	if (link->users)
 		goto out;
+	/* Keep an unsupported but aligned probe signal intact for packet reads.
+	 * Repeated PLL/PCS resets would otherwise destroy the metadata under test.
+	 */
+	if (rx->hdr_probe && ret == -ERANGE && link->configured &&
+	    (readl(rx->phy + T7_RX_PHY_APLL0) & T7_RX_PHY_PLL_LOCK) &&
+	    (readl(rx->top + T7_RX_TOP_TMDS_ALIGN_STAT) & BIT(0)))
+		goto out;
 	cable = t7_hdmirx_sample_cable(rx, clk_get_rate(rx->clocks[T7_RX_METER].clk));
 	rx->cable_hz = cable;
 	next_uhd = !!(readb(rx->cor + T7_RX_COR_TMDS_CONFIG) & BIT(1));
 	if (!(readl(rx->top + T7_RX_TOP_HPD_PWR5V) & BIT(20 + rx->port)) ||
 	    (!rx->dynamic_modes && next_uhd != rx->uhd60) ||
-	    cable < 146500000 || cable > 150500000) {
+	    !t7_hdmirx_cable_supported(rx, cable, next_uhd)) {
 		link->stable_samples = 0;
 		link->previous_cable = 0;
 		link->configured = false;
@@ -1145,6 +1187,7 @@ static int t7_hdmirx_status(struct seq_file *s, void *unused)
 		   readl(rx->top + T7_RX_TOP_EDID_GEN_STAT));
 	seq_printf(s, "phy_active: %u\n", rx->phy_active);
 	seq_printf(s, "dynamic_modes: %u\n", rx->dynamic_modes);
+	seq_printf(s, "hdr_probe: %u\n", rx->hdr_probe);
 	seq_printf(s, "selected_uhd: %u\n", READ_ONCE(rx->uhd60));
 	seq_printf(s, "core_active: %u\n", rx->core_active);
 	if (rx->link) {
@@ -1152,6 +1195,7 @@ static int t7_hdmirx_status(struct seq_file *s, void *unused)
 		seq_printf(s, "capture_users: %u\n", READ_ONCE(rx->link->users));
 	}
 	if (rx->core_active) {
+		u8 avi[17], unrec[31];
 		u32 ticks = t7_hdmirx_core_read16(rx, T7_RX_COR_FRAME_TICKS) |
 			    (readb(rx->cor + T7_RX_COR_FRAME_TICKS + 2) << 16);
 
@@ -1162,6 +1206,15 @@ static int t7_hdmirx_status(struct seq_file *s, void *unused)
 		seq_printf(s, "core_aon_reset: %#x\n", readb(rx->cor + T7_RX_COR_AON_RESET));
 		seq_printf(s, "core_fdet: %#x\n", readb(rx->cor + T7_RX_COR_FRAME_STATUS));
 		seq_printf(s, "color_depth_code: %#x\n", readb(rx->cor + T7_RX_COR_COLOR_DEPTH));
+		/* Raw diagnostic snapshots; no claim of packet freshness or HDR readiness. */
+		for (i = 0; i < ARRAY_SIZE(avi); i++)
+			avi[i] = readb(rx->cor + T7_RX_COR_AVI_PACKET + i);
+		seq_printf(s, "avi_packet: %*phN\n", (int)sizeof(avi), avi);
+		if (rx->hdr_probe) {
+			for (i = 0; i < ARRAY_SIZE(unrec); i++)
+				unrec[i] = readb(rx->cor + T7_RX_COR_UNREC_PACKET + i);
+			seq_printf(s, "drm_candidate: %*phN\n", (int)sizeof(unrec), unrec);
+		}
 		seq_printf(s, "width: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_WIDTH));
 		seq_printf(s, "height: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HEIGHT));
 		seq_printf(s, "htotal: %u\n", t7_hdmirx_core_read16(rx, T7_RX_COR_HSYNC_LOW) +
@@ -1233,6 +1286,8 @@ static int t7_hdmirx_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, -EINVAL, "PHY trial requires an EDID firmware\n");
 	if (core_test && !phy_test)
 		return dev_err_probe(dev, -EINVAL, "Core trial requires PHY initialization\n");
+	if (hdr_probe && !dynamic_modes)
+		return dev_err_probe(dev, -EINVAL, "HDR observation requires dynamic_modes=1\n");
 	rx = devm_kzalloc(dev, sizeof(*rx), GFP_KERNEL);
 	if (!rx)
 		return -ENOMEM;
@@ -1243,6 +1298,7 @@ static int t7_hdmirx_probe(struct platform_device *pdev)
 	if (dynamic_modes && !uhd60)
 		return -EINVAL;
 	rx->dynamic_modes = dynamic_modes;
+	rx->hdr_probe = hdr_probe;
 	mutex_init(&rx->audio_lock);
 	rx->top = devm_platform_ioremap_resource_byname(pdev, "top");
 	if (IS_ERR(rx->top))
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
index d5207e209acbb..c9a46b02d87e9 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_core.py
@@ -74,7 +74,7 @@ static void arm_smccc_smc(unsigned long cmd, unsigned long reg, unsigned long va
 }
 static void t7_hdmirx_set_hpd(struct t7_hdmirx *rx, bool high)
 {
-    (void)rx; assert(!high);
+    assert(!high || rx->uhd60);
 }
 static void usleep_range(unsigned int low, unsigned int high)
 {
@@ -184,6 +184,18 @@ int main(void)
     changed = true;
     assert(t7_hdmirx_check_video(&dev) == -ERANGE);
     assert(stability_waits == before + 1);
+    changed=false;t7_hdmirx_core_stop(&rx);
+    core[T7_RX_COR_UNREC_CTRL]=0x34;core[T7_RX_COR_UNREC_TYPE]=0x55;
+    rx.hdr_probe=true;
+    assert(!t7_hdmirx_core_start(&rx));
+    assert(core[T7_RX_COR_UNREC_CTRL]==1 && core[T7_RX_COR_UNREC_TYPE]==0x87);
+    core[T7_RX_COR_COLOR_DEPTH]=5;
+    assert(t7_hdmirx_check_video(&dev)==-ERANGE);
+    core[T7_RX_COR_COLOR_DEPTH]=4;
+    writel(BIT(20),top+T7_RX_TOP_VID_STAT);
+    assert(t7_hdmirx_check_video(&dev)==-ERANGE);
+    t7_hdmirx_core_stop(&rx);
+    assert(core[T7_RX_COR_UNREC_CTRL]==0x34 && core[T7_RX_COR_UNREC_TYPE]==0x55);
     puts("Core lifecycle, stable start qualification and nonblocking status loss/recovery passed");
 }
 '''
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_link.py b/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
index 2ee6579437376..910263ff8bda8 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_link.py
@@ -45,6 +45,7 @@ struct device { void *data; };
 '''
 stubs = r'''
 static bool signal_valid, source_present, hdmi2 = true, pll_fail, late_alignment, lose_during_wait;
+static bool unsupported_signal;
 static unsigned int pll_calls, pcs_calls, queued, canceled, last_delay, meter_resets;
 static unsigned int profile_changes;
 static u32 meter_reset;
@@ -55,6 +56,7 @@ static void mutex_lock(struct mutex *lock) { assert(!lock->held); lock->held = t
 static void mutex_unlock(struct mutex *lock) { assert(lock->held); lock->held = false; }
 static int t7_hdmirx_video_status(struct t7_hdmirx *rx)
 {
+    if (unsupported_signal) return -ERANGE;
     return signal_valid && (!rx->dynamic_modes || rx->uhd60==hdmi2) ? 0 : -ENOLINK;
 }
 static int t7_hdmirx_check_video(struct device *dev)
@@ -64,6 +66,8 @@ static int t7_hdmirx_check_video(struct device *dev)
 }
 static u32 readl(void *address)
 {
+    if (address == receiver.phy + T7_RX_PHY_APLL0) return T7_RX_PHY_PLL_LOCK;
+    if (address == receiver.top + T7_RX_TOP_TMDS_ALIGN_STAT) return BIT(0);
     if (address == receiver.top + T7_RX_TOP_SW_RESET) return meter_reset;
     if (address == receiver.top + T7_RX_TOP_HPD_PWR5V)
         return source_present ? BIT(20 + receiver.port) : 0;
@@ -161,6 +165,26 @@ int main(void)
     assert(link.ready && receiver.uhd60 && profile_changes==2);
     memcpy(&audio_div,phy+T7_RX_AUD_PLL3,4); assert(audio_div==0);
     assert(t7_hdmirx_stream_get(&dev,1920,1080)==-EPIPE && !link.users);
+    /* Observing an HDR cable must not enable capture or reset a locked link
+     * on each polling tick. Disabled probes still reject the extra clock.
+     */
+    assert(!t7_hdmirx_cable_supported(&receiver,92812500,true));
+    receiver.hdr_probe=true;
+    assert(t7_hdmirx_cable_supported(&receiver,92812500,true));
+    assert(!t7_hdmirx_cable_supported(&receiver,92812500,false));
+    assert(!t7_hdmirx_cable_supported(&receiver,90812499,true));
+    assert(!t7_hdmirx_cable_supported(&receiver,94812501,true));
+    assert(!t7_hdmirx_cable_supported(&receiver,0,true));
+    assert(!t7_hdmirx_cable_supported(&receiver,297000000,true));
+    cable_hz=92812500; unsupported_signal=true; link.configured=false;
+    link.stable_samples=0; link.previous_cable=0;
+    unsigned int before_probe=pll_calls;
+    tick(&link,4);
+    assert(link.configured && !link.ready && pll_calls==before_probe+1);
+    tick(&link,100);
+    assert(!link.ready && pll_calls==before_probe+1);
+    assert(t7_hdmirx_stream_get(&dev,3840,2160)==-ENOLINK && !link.users);
+    unsupported_signal=false; tick(&link,1); assert(link.ready);
     t7_hdmirx_link_stop(&link);
     assert(canceled == 1 && !link.ready);
     puts("Receiver recovery: absent/delayed source, DMA leases, PLL failure and late alignment passed");
