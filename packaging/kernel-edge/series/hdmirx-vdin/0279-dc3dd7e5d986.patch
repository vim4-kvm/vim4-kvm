From dc3dd7e5d986668e1aa8b9dd4feb1a4876bcfbbf Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 16:02:33 +0800
Subject: [PATCH] media: t7-hdmirx: discard transient invalid FDET frames under
 a lease

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    |  8 +++++++
 .../platform/amlogic/t7-hdmirx/t7-vdin-test.c |  4 ++++
 .../amlogic/t7-hdmirx/test_timings.py         | 22 +++++++++++++++++++
 3 files changed, 34 insertions(+)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index f51058a305107..94da6dd4e34e9 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -1061,6 +1061,14 @@ static int t7_hdmirx_video_status_reason(struct t7_hdmirx *rx, const char **reas
 		return t7_hdmirx_video_error(reason, "lease-encoding", -ENOLINK);
 	if (rx->dynamic_modes) {
 		ret = t7_hdmirx_measure(rx, yuv420, &measured);
+		/* An aligned FDET can briefly saturate at 0xffffff or report zero
+		 * height even when both reads agree. Discard that frame under a
+		 * live lease. The link worker bounds EAGAIN to one second before
+		 * clearing ready; genuine loss and valid mode changes still stop
+		 * capture immediately, and no malformed frame is published.
+		 */
+		if (ret == -ERANGE && rx->link && READ_ONCE(rx->link->users))
+			ret = -EAGAIN;
 		if (!ret && rx->link && rx->link->users &&
 		    !t7_hdmirx_same_measurement(&measured, &rx->lease_mode))
 			return t7_hdmirx_video_error(reason, "lease-timing", -ENOLINK);
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
index c750a5d8f4fc7..eec98627d5689 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
@@ -167,6 +167,7 @@ struct t7_vdin {
 	u64 copied_bytes;
 	/* Last failed worker remains visible across close and the next STREAMON. */
 	u32 stream_stops, last_stop_sequence;
+	u64 invalid_frames;
 	int last_stop_error;
 	const char *last_stop_reason;
 	u32 hdr_gain[149], hdr_oetf[149];
@@ -794,6 +795,8 @@ static int t7_vdin_thread(void *data)
 		/* A torn RX measurement invalidates this frame, not the stream.
 		 * Persistent instability is bounded by the receiver recovery worker.
 		 */
+		if (ret == -EAGAIN)
+			vdin->invalid_frames++;
 		if (ret && ret != -EAGAIN) {
 			unsigned long flags;
 
@@ -1359,6 +1362,7 @@ static int t7_vdin_status(struct seq_file *s, void *unused)
 	seq_printf(s, "stream_pauses: %u\n", vdin->ring_pauses);
 	seq_printf(s, "stream_error: %d\n", vdin->ring_error);
 	seq_printf(s, "stream_stops: %u\n", READ_ONCE(vdin->stream_stops));
+	seq_printf(s, "invalid_frames: %llu\n", READ_ONCE(vdin->invalid_frames));
 	seq_printf(s, "last_stop_error: %d\n", READ_ONCE(vdin->last_stop_error));
 	seq_printf(s, "last_stop_reason: %s\n", vdin->last_stop_reason ?: "none");
 	seq_printf(s, "last_stop_sequence: %u\n", READ_ONCE(vdin->last_stop_sequence));
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
index afcdcd02119ec..ac59c7270b3af 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_timings.py
@@ -197,6 +197,28 @@ int main(void) {
         printf("Measured mode %ux%u pixelclock=%llu passed\n",b->width,b->height,
                (unsigned long long)b->pixelclock);
     }
+    /* A coherent but invalid FDET during a lease drops a frame. It must
+     * never become a timing result, hide physical loss, or poison the next
+     * valid frame. Valid clock changes remain a lease violation.
+     */
+    measured_mode(&modes[0]); link.users=1;
+    t7_hdmirx_read_measurement(&rx,&rx.lease_mode);
+    assert(!t7_hdmirx_read_color(&rx,&rx.lease_color));
+    period(0xffffff);
+    assert(t7_hdmirx_check_video_now(&dev)==-EAGAIN);
+    timing=untouched;
+    assert(t7_hdmirx_query_timings(&dev,&timing,&interval)==-EAGAIN);
+    assert(!memcmp(&timing,&untouched,sizeof(timing)));
+    measured_mode(&modes[0]); word(T7_RX_COR_HEIGHT,0); period(0xffffff);
+    assert(t7_hdmirx_check_video_now(&dev)==-EAGAIN);
+    link.ready=false;
+    assert(t7_hdmirx_check_video_now(&dev)==-ENOLINK);
+    link.ready=true; measured_mode(&modes[0]);
+    assert(!t7_hdmirx_check_video_now(&dev));
+    measured_mode(&modes[1]);
+    assert(t7_hdmirx_check_video_now(&dev)==-ENOLINK);
+    link.users=0; measured_mode(&modes[0]); period(0xffffff);
+    assert(t7_hdmirx_check_video_now(&dev)==-ERANGE);
     measured_mode(&modes[0]); word(T7_RX_COR_HBACK,1);
     assert(t7_hdmirx_query_timings(&dev,&timing,&interval)==-ERANGE);
     measured_mode(&modes[0]); core[T7_RX_COR_FRAME_STATUS]|=BIT(2);
