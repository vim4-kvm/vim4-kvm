+static const u32 t7_hdr_gain[149] = {
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
+	3153, 3153, 3153, 3153, 3153, 3153, 3153, 3153,
