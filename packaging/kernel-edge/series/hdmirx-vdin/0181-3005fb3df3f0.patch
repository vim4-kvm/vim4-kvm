From 3005fb3df3f082323a820b808916954dbbad7b97 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 14:24:14 +0800
Subject: [PATCH] media: t7-vdin: export contiguous coherent capture buffers

---
 drivers/media/platform/amlogic/t7-hdmirx/Kconfig        | 5 +++--
 drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c | 7 +++++--
 drivers/media/platform/amlogic/t7-hdmirx/test_stream.py | 1 +
 3 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/Kconfig b/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
index b7028a4a6b9d8..c6b9e27944301 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
+++ b/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
@@ -18,10 +18,11 @@ config VIDEO_MESON_T7_VDIN_TEST
 	tristate "Amlogic T7 VDIN capture experiment"
 	depends on VIDEO_MESON_T7_HDMIRX
 	depends on VIDEO_DEV && OF && HAS_DMA
-	select VIDEOBUF2_VMALLOC
+	select VIDEOBUF2_DMA_CONTIG
 	help
 	  Exclusive 1080p60 RGB capture experiment for the dedicated VIM4
 	  receiver DTB. Owns the VPU register window while DRM is disabled.
-	  Exposes debugfs snapshots and a V4L2 MMAP queue. Stream buffers are
+	  Exposes debugfs snapshots and a V4L2 MMAP queue with DMA-buf export.
+	  Physically contiguous, coherent output buffers are
 	  copied from a private cached DMA ring with explicit CPU/device
 	  synchronization. This is not a production capture driver.
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
index c4aa25949feb9..041df0ed408cb 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
@@ -23,7 +23,7 @@
 #include <media/v4l2-device.h>
 #include <media/v4l2-fh.h>
 #include <media/v4l2-ioctl.h>
-#include <media/videobuf2-vmalloc.h>
+#include <media/videobuf2-dma-contig.h>
 
 #include "t7-hdmirx.h"
 
@@ -555,6 +555,8 @@ static int t7_vdin_thread(void *data)
 			/* Hardware never addresses vb2 memory, even on a stop timeout. */
 			memcpy(vb2_plane_vaddr(&buffer->vb.vb2_buf, 0),
 			       slot->data, VDIN_FRAME_SIZE);
+			/* Publish CPU writes to the coherent output before handing it off. */
+			dma_wmb();
 			ret = t7_hdmirx_check_1080p_now(vdin->receiver);
 			buffer->vb.vb2_buf.timestamp = slot->timestamp;
 			buffer->vb.sequence = slot->sequence;
@@ -739,6 +741,7 @@ static const struct v4l2_ioctl_ops t7_vdin_ioctl_ops = {
 	.vidioc_create_bufs = vb2_ioctl_create_bufs,
 	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
 	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
 	.vidioc_qbuf = vb2_ioctl_qbuf,
 	.vidioc_dqbuf = vb2_ioctl_dqbuf,
 	.vidioc_streamon = vb2_ioctl_streamon,
@@ -793,7 +796,7 @@ static int t7_vdin_video_register(struct t7_vdin *vdin)
 	queue->drv_priv = vdin;
 	queue->buf_struct_size = sizeof(struct t7_vdin_buffer);
 	queue->ops = &t7_vdin_queue_ops;
-	queue->mem_ops = &vb2_vmalloc_memops;
+	queue->mem_ops = &vb2_dma_contig_memops;
 	queue->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
 				 V4L2_BUF_FLAG_TSTAMP_SRC_EOF;
 	queue->min_queued_buffers = 2;
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py b/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
index 95426e6a0bf1e..0f906466a7f79 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_stream.py
@@ -44,6 +44,7 @@ struct mutex { pthread_mutex_t native; };
 #define dev_err(...) ((void)0)
 #define msecs_to_jiffies(x) (x)
 #define DMA_FROM_DEVICE 1
+#define dma_wmb() ((void)0)
 #define V4L2_FIELD_NONE 1
 typedef struct { pthread_mutex_t lock; pthread_cond_t cond; unsigned long generation; } wait_queue_head_t;
 static bool expire;
