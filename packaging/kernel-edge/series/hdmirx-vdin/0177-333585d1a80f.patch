 .../media/platform/amlogic/t7-hdmirx/Kconfig  |  15 +-
 .../media/platform/amlogic/t7-hdmirx/Makefile |   1 +
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 219 ++++++++-
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.h    |  10 +
 .../platform/amlogic/t7-hdmirx/t7-vdin-test.c | 458 ++++++++++++++++++
 .../platform/amlogic/t7-hdmirx/test_core.py   | 133 +++++
 .../platform/amlogic/t7-hdmirx/test_phy.py    |   2 +-
 .../platform/amlogic/t7-hdmirx/test_vdin.py   | 145 ++++++
 10 files changed, 1001 insertions(+), 6 deletions(-)
