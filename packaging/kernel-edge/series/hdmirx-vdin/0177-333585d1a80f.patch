+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
@@ -1961,8 +1961,9 @@ hdmirx: hdmi-receiver@398000 {
 		compatible = "amlogic,t7-hdmirx";
 		amlogic,input-port = <0>;
 		reg = <0x0 0x398000 0x0 0x4000>,
-		      <0x0 0x39c000 0x0 0x50>;
-		reg-names = "top", "phy";
+		      <0x0 0x39c000 0x0 0x50>,
+		      <0x0 0x3a0000 0x0 0x8000>;
+		reg-names = "top", "phy", "cor";
 		power-domains = <&pwrc PWRC_T7_HDMIRX_ID>;
 		clocks = <&clkc_periphs CLKID_SYS_HDMIRX_PCLK>,
 			 <&clkc_periphs CLKID_SYS_HDMIRX>,
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/Kconfig b/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
index 2dc81d5c210c7..2d4cab901b68f 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
+++ b/drivers/media/platform/amlogic/t7-hdmirx/Kconfig
@@ -7,7 +7,18 @@ config VIDEO_MESON_T7_HDMIRX
 	  Manage the T7 HDMI receiver power domain and clocks, and expose
 	  read-only cable and register status through debugfs. This initial
 	  driver supports resource, cable detection and firmware EDID/DDC/HPD
-	  bring-up, plus an opt-in fixed-rate input PLL trial. Automatic PHY
-	  tuning and VDIN capture require further implementation.
+	  bring-up, plus opt-in fixed-rate PHY and TMDS core initialization.
+	  Automatic PHY tuning and production V4L2 capture need further work;
+	  the separate VDIN experiment can obtain progressive 1080p60 snapshots.
 
 	  To compile this driver as a module, choose M here.
+
+config VIDEO_MESON_T7_VDIN_TEST
+	tristate "Amlogic T7 VDIN snapshot experiment"
+	depends on VIDEO_MESON_T7_HDMIRX
+	depends on OF && HAS_DMA
+	help
+	  Exclusive 1080p60 RGB snapshot experiment for the dedicated VIM4
+	  receiver DTB. Owns the VPU register window while DRM is disabled.
+	  Exposes a read-only debugfs frame after write completion and DMA idle;
+	  this is not a production V4L2 capture interface.
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/Makefile b/drivers/media/platform/amlogic/t7-hdmirx/Makefile
index 178b6ff7ccb08..c45731bb78c5e 100644
