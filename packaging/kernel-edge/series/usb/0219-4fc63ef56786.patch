From 4fc63ef56786a5874aa56e6503e8625f1d57192f Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:41:38 -0700
Subject: [PATCH] usb: gadget: hid: release idle GET_REPORT requests when
 unbinding

---
 drivers/usb/gadget/function/f_hid.c           | 14 +++-
 .../function/test_hid_request_lifecycle.py    | 71 +++++++++++++++++++
 2 files changed, 83 insertions(+), 2 deletions(-)
 create mode 100644 drivers/usb/gadget/function/test_hid_request_lifecycle.py

diff --git a/drivers/usb/gadget/function/f_hid.c b/drivers/usb/gadget/function/f_hid.c
index 3c6b43d06a6d1..0ad10650bd9ee 100644
--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -1163,8 +1163,10 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 	/* maybe allocate device-global string IDs, and patch descriptors */
 	us = usb_gstrings_attach(c->cdev, ct_func_strings,
 				 ARRAY_SIZE(ct_func_string_defs));
-	if (IS_ERR(us))
-		return PTR_ERR(us);
+	if (IS_ERR(us)) {
+		status = PTR_ERR(us);
+		goto fail;
+	}
 	hidg_interface_desc.iInterface = us[CT_FUNC_HID_IDX].id;
 
 	/* allocate instance-specific interface IDs, and patch descriptors */
@@ -1588,6 +1590,14 @@ static void hidg_unbind(struct usb_configuration *c, struct usb_function *f)
 
 	cdev_device_del(hidg->cdev, &hidg->dev);
 	destroy_workqueue(hidg->workqueue);
+	/* disable() only releases a request waiting for a userspace report.
+	 * The idle EP0 request still belongs to this binding, even if the
+	 * function instance is retained for a later configfs rebind.
+	 */
+	if (hidg->get_req) {
+		usb_ep_free_request(c->cdev->gadget->ep0, hidg->get_req);
+		hidg->get_req = NULL;
+	}
 	usb_free_all_descriptors(f);
 }
 
diff --git a/drivers/usb/gadget/function/test_hid_request_lifecycle.py b/drivers/usb/gadget/function/test_hid_request_lifecycle.py
new file mode 100644
index 0000000000000..91d1cd350e175
--- /dev/null
+++ b/drivers/usb/gadget/function/test_hid_request_lifecycle.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Exercise actual HID unbind across retained configfs function instances."""
+import pathlib
+import subprocess
+import tempfile
+
+source = pathlib.Path(__file__).with_name('f_hid.c').read_text()
+start = source.index('static void hidg_unbind(')
+unbind = source[start:source.index('\n}\n', start) + 3]
+harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+struct usb_request { bool live; };
+struct usb_ep { int unused; };
+struct usb_gadget { struct usb_ep *ep0; };
+struct usb_composite_dev { struct usb_gadget *gadget; };
+struct usb_configuration { struct usb_composite_dev *cdev; };
+struct usb_function { int unused; };
+struct f_hidg {
+    struct usb_function func;
+    void *cdev, *workqueue;
+    int dev;
+    struct usb_request *get_req;
+};
+#define func_to_hidg(p) ((struct f_hidg *)((char *)(p) - offsetof(struct f_hidg, func)))
+static bool worker_drained;
+static unsigned int allocated;
+static void cdev_device_del(void *cdev, int *dev) { (void)cdev; (void)dev; }
+static void destroy_workqueue(void *work) { (void)work; worker_drained = true; }
+static void usb_free_all_descriptors(struct usb_function *f) { (void)f; }
+static void usb_ep_free_request(struct usb_ep *ep, struct usb_request *req)
+{
+    assert(ep && req && req->live && worker_drained);
+    req->live = false;
+    allocated--;
+}
+'''
+checks = r'''
+int main(void)
+{
+    struct usb_ep ep = {0};
+    struct usb_gadget gadget = { .ep0 = &ep };
+    struct usb_composite_dev cdev = { .gadget = &gadget };
+    struct usb_configuration config = { .cdev = &cdev };
+    struct f_hidg hid = {0};
+    struct usb_request request = {0};
+    /* CRG has a finite request pool. Retaining the function instance must
+     * not accumulate one idle GET_REPORT request per binding.
+     */
+    for (int cycle = 0; cycle < 500; cycle++) {
+        worker_drained = false;
+        request.live = true;
+        hid.get_req = &request;
+        allocated++;
+        hidg_unbind(&config, &hid.func);
+        assert(!allocated && !hid.get_req && !request.live);
+    }
+    /* disable() may already have released a pending userspace request. */
+    hidg_unbind(&config, &hid.func);
+    assert(!allocated);
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='hid-request-test-') as directory:
+    path = pathlib.Path(directory)
+    (path / 'test.c').write_text(harness + unbind + checks)
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                    str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
+print('HID request lifecycle regressions passed')
