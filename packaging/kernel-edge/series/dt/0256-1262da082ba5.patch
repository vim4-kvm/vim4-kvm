From 1262da082ba528be27c17adc62a92d90ed18b158 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Thu, 22 Oct 2026 22:46:04 +0800
Subject: [PATCH] arm64: dts: amlogic: reserve VIM4 diagnostic RAM for ramoops

---
 .../boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts    | 8 ++++++++
 arch/arm64/configs/vim4_pstore.config                     | 3 +++
 2 files changed, 11 insertions(+)
 create mode 100644 arch/arm64/configs/vim4_pstore.config

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
index 43ad8eaffe603..d54b9af3881ae 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4.dts
@@ -73,6 +73,14 @@ secmon_reserved_bl32: secmon@5300000 {
 			no-map;
 		};
 
+		/* Keep the boot firmware's 1 MiB diagnostic RAM window. */
+		ramoops@7400000 {
+			compatible = "ramoops";
+			reg = <0x0 0x07400000 0x0 0x00100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+		};
+
 		/* 16 MiB reserved for PCIe BL31 memory-protection via SMC */
 		pcie_dma_pool: pcie-dma-pool {
 			compatible = "restricted-dma-pool";
diff --git a/arch/arm64/configs/vim4_pstore.config b/arch/arm64/configs/vim4_pstore.config
new file mode 100644
index 0000000000000..c2ca3a02707ed
--- /dev/null
+++ b/arch/arm64/configs/vim4_pstore.config
@@ -0,0 +1,3 @@
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
