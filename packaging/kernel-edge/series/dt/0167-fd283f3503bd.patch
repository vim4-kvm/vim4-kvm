From fd283f3503bd5792669c968f43508e6af6aa565f Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 09:54:39 +0800
Subject: [PATCH] dt-bindings: media: add T7 HDMI receiver bring-up resources

---
 .../bindings/media/amlogic,t7-hdmirx.yaml     | 75 +++++++++++++++++++
 .../clock/amlogic,t7-peripherals-clkc.h       | 21 ++++++
 2 files changed, 96 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/amlogic,t7-hdmirx.yaml

diff --git a/Documentation/devicetree/bindings/media/amlogic,t7-hdmirx.yaml b/Documentation/devicetree/bindings/media/amlogic,t7-hdmirx.yaml
new file mode 100644
index 0000000000000..cb580627c66a4
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/amlogic,t7-hdmirx.yaml
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/amlogic,t7-hdmirx.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic T7 HDMI receiver
+
+maintainers:
+  - localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
+
+description: |
+  Initial receiver resource and cable detection interface. The TOP register
+  window includes the input 5V and HPD request registers. PHY initialization,
+  EDID programming and VDIN capture are separate bring-up stages.
+
+properties:
+  compatible:
+    const: amlogic,t7-hdmirx
+
+  reg:
+    maxItems: 1
+
+  reg-names:
+    items:
+      - const: top
+
+  clocks:
+    maxItems: 5
+
+  clock-names:
+    items:
+      - const: pclk
+      - const: cfg
+      - const: meter
+      - const: 2m
+      - const: 5m
+
+  power-domains:
+    maxItems: 1
+
+  amlogic,input-port:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Physical receiver input port to monitor.
+    enum: [0, 1, 2]
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - power-domains
+  - amlogic,input-port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,t7-peripherals-clkc.h>
+    #include <dt-bindings/power/amlogic,t7-pwrc.h>
+
+    hdmi-receiver@fe398000 {
+        compatible = "amlogic,t7-hdmirx";
+        reg = <0xfe398000 0x4000>;
+        reg-names = "top";
+        power-domains = <&pwrc PWRC_T7_HDMIRX_ID>;
+        clocks = <&clkc_periphs CLKID_SYS_HDMIRX_PCLK>,
+                 <&clkc_periphs CLKID_HDMIRX_CFG>,
+                 <&clkc_periphs CLKID_HDMIRX_METER>,
+                 <&clkc_periphs CLKID_HDMIRX_2M>,
+                 <&clkc_periphs CLKID_HDMIRX_5M>;
+        clock-names = "pclk", "cfg", "meter", "2m", "5m";
+        amlogic,input-port = <1>;
+    };
diff --git a/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h b/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
index 32c4b62037de3..47130d0a49973 100644
--- a/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
+++ b/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
@@ -224,5 +224,26 @@
 #define CLKID_SYS_PWM_AO_CD		215
 #define CLKID_SYS_PWM_AO_EF		216
 #define CLKID_SYS_PWM_AO_GH		217
+#define CLKID_HDMIRX_5M_SEL		218
+#define CLKID_HDMIRX_5M_DIV		219
+#define CLKID_HDMIRX_5M			220
+#define CLKID_HDMIRX_2M_SEL		221
+#define CLKID_HDMIRX_2M_DIV		222
+#define CLKID_HDMIRX_2M			223
+#define CLKID_HDMIRX_CFG_SEL		224
+#define CLKID_HDMIRX_CFG_DIV		225
+#define CLKID_HDMIRX_CFG			226
+#define CLKID_HDMIRX_HDCP_SEL		227
+#define CLKID_HDMIRX_HDCP_DIV		228
+#define CLKID_HDMIRX_HDCP			229
+#define CLKID_HDMIRX_AUD_PLL_SEL		230
+#define CLKID_HDMIRX_AUD_PLL_DIV		231
+#define CLKID_HDMIRX_AUD_PLL		232
+#define CLKID_HDMIRX_ACR_SEL		233
+#define CLKID_HDMIRX_ACR_DIV		234
+#define CLKID_HDMIRX_ACR			235
+#define CLKID_HDMIRX_METER_SEL		236
+#define CLKID_HDMIRX_METER_DIV		237
+#define CLKID_HDMIRX_METER			238
 
 #endif /* __T7_PERIPHERALS_CLKC_H */
