From 96f3f1775c8c052e8b9c1ef5002461f8203439e0 Mon Sep 17 00:00:00 2001
From: deepdream <deepdream@deepdremsMinim4.lan>
Date: Tue, 20 Oct 2026 07:45:52 -0700
Subject: [PATCH] media: wave5: translate legacy AVC profiles at the firmware
 boundary

---
 .../chips-media/wave5/test_profiles.py        | 75 +++++++++++++++++++
 .../platform/chips-media/wave5/wave5-hw.c     | 14 +++-
 .../chips-media/wave5/wave5-vpu-enc.c         | 10 ++-
 3 files changed, 95 insertions(+), 4 deletions(-)
 create mode 100644 drivers/media/platform/chips-media/wave5/test_profiles.py

diff --git a/drivers/media/platform/chips-media/wave5/test_profiles.py b/drivers/media/platform/chips-media/wave5/test_profiles.py
new file mode 100644
index 0000000000000..a32d39f7766b9
--- /dev/null
+++ b/drivers/media/platform/chips-media/wave5/test_profiles.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check the actual firmware-command profile translation and control transitions."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).parent
+hardware = (root / 'wave5-hw.c').read_text()
+translation = hardware[hardware.index('static u32 wave5_enc_sps_profile('):
+                       hardware.index('int wave5_vpu_enc_init_seq(')]
+controls = (root / 'wave5-vpu-enc.c').read_text()
+profile_control = controls[controls.index('\tcase V4L2_CID_MPEG_VIDEO_H264_PROFILE:'):
+                           controls.index('\tcase V4L2_CID_MPEG_VIDEO_H264_LEVEL:')]
+defines = '\n'.join(line for line in (root / 'wave5-vpuapi.h').read_text().splitlines()
+                    if line.startswith('#define H264_PROFILE_'))
+prefix = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <errno.h>
+#include <linux/v4l2-controls.h>
+typedef uint32_t u32;
+#define W_AVC_ENC 1
+#define W_HEVC_ENC 2
+struct vpu_device { bool legacy_firmware; };
+struct vpu_instance { struct vpu_device *dev; unsigned std, bit_depth;
+    struct { u32 profile, constraint_set1_flag; } enc_param; };
+struct control { unsigned id, val; };
+'''
+checks = r'''
+int main(void)
+{
+    struct vpu_device dev = {.legacy_firmware=true};
+    struct vpu_instance inst = {.dev=&dev,.std=W_AVC_ENC};
+    /* A High request must issue legacy High, not the High10 command that
+     * produced profile_idc=110 with 8-bit pixels in the hardware regression. */
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_HIGH));
+    assert(inst.bit_depth==8);
+    assert(wave5_enc_sps_profile(&inst,inst.enc_param.profile)==3);
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_10));
+    assert(inst.bit_depth==10);
+    assert(wave5_enc_sps_profile(&inst,inst.enc_param.profile)==4);
+    for (unsigned p=1;p<=7;p++) {
+        dev.legacy_firmware=false;
+        assert(wave5_enc_sps_profile(&inst,p)==p);
+        dev.legacy_firmware=true; inst.std=W_HEVC_ENC;
+        assert(wave5_enc_sps_profile(&inst,p)==p);
+        inst.std=W_AVC_ENC;
+    }
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE));
+    assert(inst.enc_param.constraint_set1_flag==1);
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_HIGH));
+    assert(inst.enc_param.constraint_set1_flag==0);
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE));
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE));
+    assert(inst.enc_param.constraint_set1_flag==0);
+    assert(wave5_enc_sps_profile(&inst,inst.enc_param.profile)==1);
+    assert(!set_profile(&inst,V4L2_MPEG_VIDEO_H264_PROFILE_MAIN));
+    assert(wave5_enc_sps_profile(&inst,inst.enc_param.profile)==2);
+    puts("Wave5 legacy AVC profiles and constraint transitions passed");
+}
+'''
+function = ('static int set_profile(struct vpu_instance *inst, unsigned value) {\n'
+            'struct control storage={.id=V4L2_CID_MPEG_VIDEO_H264_PROFILE,.val=value};\n'
+            'struct control *ctrl=&storage; switch(ctrl->id) {\n' + profile_control +
+            'default: return -EINVAL; } return 0; }\n')
+with tempfile.TemporaryDirectory(prefix='wave5-profile-') as directory:
+    source = Path(directory) / 'profiles.c'
+    source.write_text(prefix + defines + '\n' + translation + function + checks)
+    binary = Path(directory) / 'profiles'
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-O2',
+                    str(source), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/drivers/media/platform/chips-media/wave5/wave5-hw.c b/drivers/media/platform/chips-media/wave5/wave5-hw.c
index 56b6b9180acd0..65dc5d31de9e6 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-hw.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-hw.c
@@ -1704,6 +1704,18 @@ static void wave5_set_enc_crop_info(u32 codec, struct enc_wave_param *param, int
 	}
 }
 
+static u32 wave5_enc_sps_profile(struct vpu_instance *inst, u32 profile)
+{
+	/* The T7 firmware predates Extended: its AVC High/High10 IDs are 3/4,
+	 * while the current Wave5 command ABI uses 4/5. Keep API values intact
+	 * for validation and translate only when issuing the firmware command.
+	 */
+	if (inst->dev->legacy_firmware && inst->std == W_AVC_ENC &&
+	    (profile == H264_PROFILE_HP || profile == H264_PROFILE_HIGH10))
+		return profile - 1;
+	return profile;
+}
+
 int wave5_vpu_enc_init_seq(struct vpu_instance *inst)
 {
 	u32 reg_val = 0, rot_mir_mode, fixed_cu_size_mode = 0x7;
@@ -1762,7 +1774,7 @@ int wave5_vpu_enc_init_seq(struct vpu_instance *inst)
 	dev_dbg(inst->dev->dev, "encoder setup: codec %u profile %u level %u fps %u rc %u\n",
 		inst->std, p_param->profile, p_param->level, p_open_param->frame_rate_info,
 		p_open_param->rc_enable);
-	reg_val = p_param->profile |
+	reg_val = wave5_enc_sps_profile(inst, p_param->profile) |
 		(p_param->level << 3) |
 		(p_param->internal_bit_depth << 14);
 	if (inst->std == W_HEVC_ENC)
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
index b37525e025f9e..e7b24216cf1fa 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
@@ -948,13 +948,13 @@ static int wave5_vpu_enc_s_ctrl(struct v4l2_ctrl *ctrl)
 		inst->enc_param.tmvp_enable = ctrl->val;
 		break;
 	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+		inst->enc_param.constraint_set1_flag =
+			ctrl->val == V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE;
 		switch (ctrl->val) {
 		case V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE:
 		case V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE:
 			inst->enc_param.profile = H264_PROFILE_BP;
 			inst->bit_depth = 8;
-			if (ctrl->val == V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE)
-				inst->enc_param.constraint_set1_flag = 1;
 			break;
 		case V4L2_MPEG_VIDEO_H264_PROFILE_MAIN:
 			inst->enc_param.profile = H264_PROFILE_MP;
@@ -1717,7 +1717,11 @@ static int wave5_vpu_open_enc(struct file *filp)
 
 	v4l2_ctrl_new_std_menu(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
 			       V4L2_CID_MPEG_VIDEO_H264_PROFILE,
-			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_444_PREDICTIVE, 0,
+			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_444_PREDICTIVE,
+			       dev->legacy_firmware ?
+			       BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED) |
+			       BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_422) |
+			       BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH_444_PREDICTIVE) : 0,
 			       V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE);
 	v4l2_ctrl_new_std_menu(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
 			       V4L2_CID_MPEG_VIDEO_H264_LEVEL,
