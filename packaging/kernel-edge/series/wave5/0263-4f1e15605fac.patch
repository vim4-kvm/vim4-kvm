From 4f1e15605fac8a14cd4d1e3bae2f6d867b30c050 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:23:14 +0800
Subject: [PATCH] media: wave5: bound polling thread teardown and document
 isolation

---
 .../ABI/testing/sysfs-devices-platform-wave5  | 27 +++++++++++++++++++
 .../platform/chips-media/wave5/wave5-vpu.c    |  3 ++-
 2 files changed, 29 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/ABI/testing/sysfs-devices-platform-wave5

diff --git a/Documentation/ABI/testing/sysfs-devices-platform-wave5 b/Documentation/ABI/testing/sysfs-devices-platform-wave5
new file mode 100644
index 0000000000000..e5187d4a2a5e5
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-devices-platform-wave5
@@ -0,0 +1,27 @@
+What:           /sys/bus/platform/drivers/vdec/.../isolated
+Date:           October 2026
+Contact:        linux-media@vger.kernel.org
+Description:
+                Read-only quarantine state for the Amlogic T7 encoder. 0 is
+                usable, 1 means that command/frame completion or cancellation
+                failed. All open encoder queues report errors and new opens
+                and hardware jobs are rejected. DMA memory and mappings are
+                retained because stopping DMA has not been established. The
+                module cannot be unloaded and userspace unbind is disabled.
+                Only a board reboot clears this state. No runtime reset or
+                firmware reload is attempted. A KOBJ_CHANGE uevent carries
+                WAVE5_ISOLATED=1 when quarantine is published.
+
+What:           /sys/bus/platform/drivers/vdec/.../isolation_reason
+Date:           October 2026
+Contact:        linux-media@vger.kernel.org
+Description:
+                Read-only human-readable first failure, or "none" before a
+                failure. Later failures do not replace the original cause.
+
+What:           /sys/bus/platform/drivers/vdec/.../isolation_time_ns
+Date:           October 2026
+Contact:        linux-media@vger.kernel.org
+Description:
+                Read-only decimal CLOCK_BOOTTIME nanoseconds at the first
+                failure, or 0 before failure. This is not wall-clock time.
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpu.c b/drivers/media/platform/chips-media/wave5/wave5-vpu.c
index c59d2bd9ff371..28727a2cd6565 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpu.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpu.c
@@ -183,7 +183,8 @@ static int irq_thread(void *data)
 	int irq_status, ret;
 
 	while (!kthread_should_stop()) {
-		if (down_interruptible(&dev->irq_sem))
+		/* kthread_stop() alone cannot release a semaphore waiter. */
+		if (down_timeout(&dev->irq_sem, msecs_to_jiffies(100)))
 			continue;
 
 		if (kthread_should_stop())
