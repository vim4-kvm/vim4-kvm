From ed3b631f759d140952d381169f8996adbf0c2070 Mon Sep 17 00:00:00 2001
From: deepdream <deepdream@deepdremsMinim4.lan>
Date: Tue, 20 Oct 2026 09:47:58 -0700
Subject: [PATCH] media: wave5: expose cyclic intra refresh with a bounded row
 budget

---
 .../chips-media/wave5/test_intra_refresh.py   | 69 +++++++++++++++++++
 .../chips-media/wave5/wave5-vpu-enc.c         | 49 ++++++++-----
 .../platform/chips-media/wave5/wave5-vpuapi.h |  1 +
 3 files changed, 101 insertions(+), 18 deletions(-)
 create mode 100644 drivers/media/platform/chips-media/wave5/test_intra_refresh.py

diff --git a/drivers/media/platform/chips-media/wave5/test_intra_refresh.py b/drivers/media/platform/chips-media/wave5/test_intra_refresh.py
new file mode 100644
index 0000000000000..4e0b9c4a38ca9
--- /dev/null
+++ b/drivers/media/platform/chips-media/wave5/test_intra_refresh.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise V4L2 refresh controls and firmware row budgets for both codecs."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).parent
+source = (root / 'wave5-vpu-enc.c').read_text()
+helper = source[source.index('static void wave5_set_intra_refresh('):source.index('static int wave5_set_enc_openparam(')]
+controls = source[source.index('\tcase V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD:'):source.index('\tcase V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:')]
+defines = '\n'.join(line for line in (root / 'wave5-vpuapi.h').read_text().splitlines()
+                    if line.startswith(('#define REFRESH_MODE_', '#define REFRESH_MB_MODE_')))
+prefix = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+#include <stdio.h>
+#include <linux/v4l2-controls.h>
+typedef uint32_t u32;
+#define DIV_ROUND_UP(n,d) (((n)+(d)-1)/(d))
+struct enc_wave_param {
+    u32 intra_refresh_mode, intra_refresh_arg;
+    u32 intra_mb_refresh_mode, intra_mb_refresh_arg;
+};
+struct vpu_instance { unsigned int intra_refresh_period; };
+struct control { unsigned id, val; };
+'''
+control = ('static int set_control(struct vpu_instance *inst,unsigned id,unsigned value) {\n'
+           'struct control storage={id,value}, *ctrl=&storage; switch(id) {\n'+controls+
+           'default: return -EINVAL; } return 0; }\n')
+checks = r'''
+int main(void) {
+    struct vpu_instance inst={0};
+    struct enc_wave_param param={0};
+    assert(!set_control(&inst,V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD,45));
+    assert(set_control(&inst,V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE,
+        V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_RANDOM)==-EINVAL);
+    assert(inst.intra_refresh_period==45);
+    assert(!set_control(&inst,V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE,
+        V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC));
+    wave5_set_intra_refresh(&param,2160,inst.intra_refresh_period,false);
+    assert(param.intra_mb_refresh_mode==1 && param.intra_mb_refresh_arg==3);
+    assert(!param.intra_refresh_mode && !param.intra_refresh_arg);
+    wave5_set_intra_refresh(&param,2160,inst.intra_refresh_period,true);
+    assert(param.intra_refresh_mode==1 && param.intra_refresh_arg==1);
+    assert(!param.intra_mb_refresh_mode && !param.intra_mb_refresh_arg);
+    for(unsigned height=1;height<=2160;height+=13) for(unsigned period=1;period<=4096;period+=17)
+        for(unsigned hevc=0;hevc<2;hevc++) {
+            wave5_set_intra_refresh(&param,height,period,hevc);
+            unsigned rows=DIV_ROUND_UP(height,hevc?64:16);
+            unsigned refresh=hevc?param.intra_refresh_arg:param.intra_mb_refresh_arg;
+            assert(refresh>=1 && refresh<=rows && refresh*period>=rows);
+        }
+    assert(!set_control(&inst,V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD,0));
+    wave5_set_intra_refresh(&param,1080,inst.intra_refresh_period,true);
+    assert(!param.intra_refresh_mode && !param.intra_refresh_arg);
+    assert(!param.intra_mb_refresh_mode && !param.intra_mb_refresh_arg);
+    puts("Wave5 cyclic row refresh, codec transitions and partial rows passed");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='wave5-refresh-') as directory:
+    code = Path(directory) / 'refresh.c'
+    binary = Path(directory) / 'refresh'
+    code.write_text(prefix + defines + '\n' + helper + control + checks)
+    subprocess.run(['cc', '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', str(code), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
index e7b24216cf1fa..d5d027bcf209f 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
@@ -797,6 +797,13 @@ static int wave5_vpu_enc_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_MPEG_VIDEO_GOP_SIZE:
 		inst->enc_param.avc_idr_period = ctrl->val;
 		break;
+	case V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD:
+		inst->intra_refresh_period = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE:
+		if (ctrl->val != V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC)
+			return -EINVAL;
+		break;
 	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
 		atomic_set(&inst->force_keyframe, 1);
 		break;
@@ -1181,13 +1188,26 @@ static void wave5_vpu_enc_buf_queue(struct vb2_buffer *vb)
 	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
 }
 
+static void wave5_set_intra_refresh(struct enc_wave_param *param, u32 height,
+				  u32 period, bool hevc)
+{
+	u32 rows = DIV_ROUND_UP(height, hevc ? 64 : 16);
+	u32 refresh_rows = period ? DIV_ROUND_UP(rows, period) : 0;
+
+	/* Firmware takes rows per frame. Round up to finish within the requested
+	 * period, including partial bottom rows, without enabling the other codec.
+	 */
+	param->intra_mb_refresh_mode = !hevc && period ? REFRESH_MB_MODE_CTU_ROWS : 0;
+	param->intra_mb_refresh_arg = !hevc ? refresh_rows : 0;
+	param->intra_refresh_mode = hevc && period ? REFRESH_MODE_CTU_ROWS : 0;
+	param->intra_refresh_arg = hevc ? refresh_rows : 0;
+}
+
 static int wave5_set_enc_openparam(struct enc_open_param *open_param,
 				   struct vpu_instance *inst)
 {
 	struct enc_wave_param input = inst->enc_param;
 	const struct v4l2_format_info *info;
-	u32 num_ctu_row = ALIGN(inst->dst_fmt.height, 64) / 64;
-	u32 num_mb_row = ALIGN(inst->dst_fmt.height, 16) / 16;
 
 	info = v4l2_format_info(inst->src_fmt.pixelformat);
 	if (!info)
@@ -1287,22 +1307,8 @@ static int wave5_set_enc_openparam(struct enc_open_param *open_param,
 	open_param->wave_param.independ_slice_mode_arg = input.independ_slice_mode_arg;
 	open_param->wave_param.avc_slice_mode = input.avc_slice_mode;
 	open_param->wave_param.avc_slice_arg = input.avc_slice_arg;
-	open_param->wave_param.intra_mb_refresh_mode = input.intra_mb_refresh_mode;
-	if (input.intra_mb_refresh_mode != REFRESH_MB_MODE_NONE) {
-		if (num_mb_row >= input.intra_mb_refresh_arg)
-			open_param->wave_param.intra_mb_refresh_arg =
-				num_mb_row / input.intra_mb_refresh_arg;
-		else
-			open_param->wave_param.intra_mb_refresh_arg = num_mb_row;
-	}
-	open_param->wave_param.intra_refresh_mode = input.intra_refresh_mode;
-	if (input.intra_refresh_mode != 0) {
-		if (num_ctu_row >= input.intra_refresh_arg)
-			open_param->wave_param.intra_refresh_arg =
-				num_ctu_row / input.intra_refresh_arg;
-		else
-			open_param->wave_param.intra_refresh_arg = num_ctu_row;
-	}
+	wave5_set_intra_refresh(&open_param->wave_param, inst->conf_win.height,
+			       inst->intra_refresh_period, inst->std == W_HEVC_ENC);
 	open_param->wave_param.forced_idr_header_enable = input.forced_idr_header_enable;
 
 	return 0;
@@ -1790,6 +1796,13 @@ static int wave5_vpu_open_enc(struct file *filp)
 	v4l2_ctrl_new_std(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
 			  V4L2_CID_MPEG_VIDEO_GOP_SIZE,
 			  0, 2047, 1, 0);
+	v4l2_ctrl_new_std(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD, 0, 4096, 1, 0);
+	v4l2_ctrl_new_std_menu(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
+			       V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE,
+			       V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC,
+			       BIT(V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_RANDOM),
+			       V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC);
 	v4l2_ctrl_new_std(v4l2_ctrl_hdl, &wave5_vpu_enc_ctrl_ops,
 			  V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME,
 			  0, 0, 0, 0);
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
index c271d47192504..f40fd1c8e84c6 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
@@ -843,6 +843,7 @@ struct vpu_instance {
 	unsigned int bit_depth;
 	unsigned int frame_rate;
 	unsigned int vbv_buf_size;
+	unsigned int intra_refresh_period;
 	unsigned int rc_mode;
 	unsigned int rc_enable;
 	unsigned int bit_rate;
