From 5bd23b939849f867116236b32a4ab04b9a4d00c1 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:11:25 +0800
Subject: [PATCH] media: wave5: retain encoder DMA ownership until safe
 teardown

---
 .../chips-media/wave5/test_encoder_cleanup.py | 162 ++++++++++++++++++
 .../platform/chips-media/wave5/wave5-hw.c     |  35 ++--
 .../chips-media/wave5/wave5-vpu-enc.c         |   9 +-
 3 files changed, 180 insertions(+), 26 deletions(-)
 create mode 100644 drivers/media/platform/chips-media/wave5/test_encoder_cleanup.py

diff --git a/drivers/media/platform/chips-media/wave5/test_encoder_cleanup.py b/drivers/media/platform/chips-media/wave5/test_encoder_cleanup.py
new file mode 100644
index 0000000000000..2dc74439adc2c
--- /dev/null
+++ b/drivers/media/platform/chips-media/wave5/test_encoder_cleanup.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Inject DMA/firmware failures into the actual encoder registration and close."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).parent
+hardware = (root / 'wave5-hw.c').read_text()
+register = hardware[hardware.index('static u32 calculate_luma_stride'):
+                    hardware.index('static u32 wave5_vpu_enc_validate_sec_axi')]
+api = (root / 'wave5-vpuapi.c').read_text()
+close = api[api.index('int wave5_vpu_enc_close('):
+            api.index('int wave5_vpu_enc_register_frame_buffer(')]
+# Register values and buffer sizing do not affect allocation ownership.
+registers = sorted(set(re.findall(r'\bW5_[A-Z_0-9]+', register)))
+harness = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t u32;
+#define ALIGN(x, n) (((x) + (n) - 1) & ~((n) - 1))
+#define DIV_ROUND_UP(x, n) (((x) + (n) - 1) / (n))
+#define BUFFER_MARGIN 4096
+#define VLC_BUF_NUM 2
+#define WAVE521_COMMAND_QUEUE_DEPTH 2
+#define MAX_FIRMWARE_CALL_RETRY 3
+#define WAVE5_SYSERR_VPU_STILL_RUNNING 1
+#define W_AVC_ENC 1
+#define W_HEVC_ENC 2
+#define MIRDIR_HOR_VER 3
+#define WAVE5_ENC_AVC_BUF_SIZE(w, h) ((w) * (h))
+#define WAVE5_ENC_HEVC_BUF_SIZE(w, h) ((w) * (h))
+#define WAVE5_FBC_LUMA_TABLE_SIZE(w, h) ((w) * (h))
+#define WAVE5_FBC_CHROMA_TABLE_SIZE(w, h) ((w) * (h))
+#define WAVE5_SUBSAMPLED_ONE_SIZE_AVC(w, h) ((w) * (h))
+#define WAVE5_SUBSAMPLED_ONE_SIZE(w, h) ((w) * (h))
+#define dev_dbg(...) ((void)0)
+#define dev_warn(...) ((void)0)
+enum tiled_map_type { COMPRESSED_FRAME_MAP };
+struct vpu_buf { size_t size; void *vaddr; uintptr_t daddr; };
+struct enc_open_param {
+    u32 pic_width, pic_height;
+    struct { u32 internal_bit_depth; } wave_param;
+};
+struct enc_info {
+    struct enc_open_param open_param;
+    u32 stride, rotation_angle, mirror_direction, vlc_buf_size, param_buf_size;
+    struct vpu_buf vb_work, vb_mv, vb_fbc_y_tbl, vb_fbc_c_tbl, vb_sub_sam_buf, vb_task;
+};
+struct codec_info { struct enc_info enc_info; };
+struct device { void *data; };
+struct vpu_device { struct device *dev; int hw_lock; };
+struct vpu_instance { struct vpu_device *dev; struct codec_info *codec_info; int std; };
+struct frame_buffer { uintptr_t buf_y, buf_cb; };
+static unsigned attempts, fail_at, live, commands;
+static bool firmware_owns, fail_command, fail_queue, fail_close;
+static void *dev_get_drvdata(struct device *dev) { return dev->data; }
+static int mutex_lock_interruptible(int *lock) { (void)lock; return 0; }
+static void mutex_unlock(int *lock) { (void)lock; }
+static void pm_runtime_resume_and_get(struct device *dev) { (void)dev; }
+static void pm_runtime_put_sync(struct device *dev) { (void)dev; }
+static void vpu_write_reg(struct vpu_device *dev, u32 reg, uintptr_t value)
+{ (void)dev; (void)reg; (void)value; }
+static int wave5_vdi_allocate_dma_memory(struct vpu_device *dev, struct vpu_buf *vb)
+{
+    (void)dev;
+    assert(!vb->vaddr);
+    if (++attempts == fail_at) return -ENOMEM;
+    vb->vaddr = malloc(vb->size);
+    assert(vb->vaddr);
+    vb->daddr = (uintptr_t)vb->vaddr;
+    live++;
+    return 0;
+}
+static int wave5_vdi_free_dma_memory(struct vpu_device *dev, struct vpu_buf *vb)
+{
+    (void)dev;
+    assert(!firmware_owns);
+    if (vb->vaddr) { assert(live); live--; free(vb->vaddr); }
+    memset(vb, 0, sizeof(*vb));
+    return 0;
+}
+static int send_firmware_command(struct vpu_instance *inst, int cmd, bool wait,
+                                 void *a, void *b)
+{
+    (void)inst; (void)cmd; (void)wait; (void)a; (void)b;
+    commands++;
+    firmware_owns = true;
+    return fail_command ? -ETIMEDOUT : 0;
+}
+static int wave5_vpu_firmware_command_queue_error_check(struct vpu_device *dev, void *reason)
+{ (void)dev; (void)reason; return fail_queue ? -EIO : 0; }
+static int wave5_vpu_enc_finish_seq(struct vpu_instance *inst, u32 *fail_res)
+{
+    (void)inst; (void)fail_res;
+    if (fail_close) return -ETIMEDOUT;
+    firmware_owns = false;
+    return 0;
+}
+'''
+checks = r'''
+int main(void)
+{
+    struct device dev;
+    struct vpu_device vpu = { .dev = &dev };
+    struct frame_buffer frames[10] = {0};
+    dev.data = &vpu;
+    for (int codec = W_AVC_ENC; codec <= W_HEVC_ENC; codec++)
+    for (int existing_task = 0; existing_task < 2; existing_task++)
+    for (unsigned failure = 0; failure <= 7; failure++) {
+        struct codec_info info = { .enc_info = {
+            .open_param = { .pic_width = 3840, .pic_height = 2160,
+                            .wave_param = { .internal_bit_depth = 8 } },
+            .stride = 3840, .vlc_buf_size = 256, .param_buf_size = 128,
+        } };
+        struct vpu_instance inst = { .dev = &vpu, .codec_info = &info, .std = codec };
+        u32 reason;
+        attempts = 0; fail_at = 0; commands = 0;
+        firmware_owns = false; fail_command = false; fail_queue = false;
+        if (existing_task) {
+            info.enc_info.vb_task.size = 256;
+            assert(!wave5_vdi_allocate_dma_memory(&vpu, &info.enc_info.vb_task));
+        }
+        attempts = 0;
+        fail_at = failure <= 5 ? failure : 0;
+        fail_command = failure == 6;
+        fail_queue = failure == 7;
+        int ret = wave5_vpu_enc_register_framebuffer(&dev, &inst, frames,
+                                                    COMPRESSED_FRAME_MAP, 10);
+        if (failure && !(failure == 5 && existing_task)) assert(ret < 0);
+        else assert(!ret);
+        if (commands) {
+            assert(live == 5);
+            // A failed destroy must retain every DMA allocation for hardware.
+            fail_close = true;
+            assert(wave5_vpu_enc_close(&inst, &reason) == -ETIMEDOUT);
+            assert(live == 5);
+        } else {
+            assert(live == (unsigned)existing_task);
+        }
+        fail_close = false;
+        assert(!wave5_vpu_enc_close(&inst, &reason));
+        assert(!live);
+    }
+    puts("Wave5 allocation rollback, firmware ownership and close passed (32 cases)");
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    test = Path(directory) / 'cleanup.c'
+    test.write_text(harness + '\nenum { ' + ', '.join(registers) + ' };\n'
+                    + register + close + checks)
+    executable = Path(directory) / 'cleanup'
+    subprocess.run(['cc', '-Wall', '-Wextra', '-Werror', '-Wno-unused-parameter',
+                    '-O1', '-g', '-fsanitize=address,undefined', str(test),
+                    '-o', str(executable)], check=True)
+    subprocess.run([str(executable)], check=True)
diff --git a/drivers/media/platform/chips-media/wave5/wave5-hw.c b/drivers/media/platform/chips-media/wave5/wave5-hw.c
index a728f8f444e68..56b6b9180acd0 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-hw.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-hw.c
@@ -2027,8 +2027,6 @@ int wave5_vpu_enc_register_framebuffer(struct device *dev, struct vpu_instance *
 	if (ret)
 		return ret;
 
-	p_enc_info->vb_mv = vb_mv;
-
 	fbc_y_tbl_size = ALIGN(WAVE5_FBC_LUMA_TABLE_SIZE(buf_width, buf_height), 16);
 	fbc_c_tbl_size = ALIGN(WAVE5_FBC_CHROMA_TABLE_SIZE(buf_width, buf_height), 16);
 
@@ -2038,16 +2036,12 @@ int wave5_vpu_enc_register_framebuffer(struct device *dev, struct vpu_instance *
 	if (ret)
 		goto free_vb_fbc_y_tbl;
 
-	p_enc_info->vb_fbc_y_tbl = vb_fbc_y_tbl;
-
 	vb_fbc_c_tbl.daddr = 0;
 	vb_fbc_c_tbl.size = ALIGN(fbc_c_tbl_size * count, BUFFER_MARGIN) + BUFFER_MARGIN;
 	ret = wave5_vdi_allocate_dma_memory(vpu_dev, &vb_fbc_c_tbl);
 	if (ret)
 		goto free_vb_fbc_c_tbl;
 
-	p_enc_info->vb_fbc_c_tbl = vb_fbc_c_tbl;
-
 	if (avc_encoding)
 		sub_sampled_size = WAVE5_SUBSAMPLED_ONE_SIZE_AVC(buf_width, buf_height);
 	else
@@ -2058,8 +2052,6 @@ int wave5_vpu_enc_register_framebuffer(struct device *dev, struct vpu_instance *
 	if (ret)
 		goto free_vb_sam_buf;
 
-	p_enc_info->vb_sub_sam_buf = vb_sub_sam_buf;
-
 	vb_task.size = (p_enc_info->vlc_buf_size * VLC_BUF_NUM) +
 			(p_enc_info->param_buf_size * WAVE521_COMMAND_QUEUE_DEPTH);
 	vb_task.daddr = 0;
@@ -2068,13 +2060,22 @@ int wave5_vpu_enc_register_framebuffer(struct device *dev, struct vpu_instance *
 		if (ret)
 			goto free_vb_task;
 
-		p_enc_info->vb_task = vb_task;
-
-		vpu_write_reg(inst->dev, W5_CMD_SET_FB_ADDR_TASK_BUF,
-			      p_enc_info->vb_task.daddr);
+		vpu_write_reg(inst->dev, W5_CMD_SET_FB_ADDR_TASK_BUF, vb_task.daddr);
 		vpu_write_reg(inst->dev, W5_CMD_SET_FB_TASK_BUF_SIZE, vb_task.size);
 	}
 
+	/*
+	 * Transfer ownership only after all allocations succeed. Once SET_FB is
+	 * submitted, even a command failure can leave firmware using these buffers;
+	 * enc_close must stop the instance before releasing them.
+	 */
+	p_enc_info->vb_mv = vb_mv;
+	p_enc_info->vb_fbc_y_tbl = vb_fbc_y_tbl;
+	p_enc_info->vb_fbc_c_tbl = vb_fbc_c_tbl;
+	p_enc_info->vb_sub_sam_buf = vb_sub_sam_buf;
+	if (vb_task.vaddr)
+		p_enc_info->vb_task = vb_task;
+
 	/* set sub-sampled buffer base addr */
 	vpu_write_reg(inst->dev, W5_ADDR_SUB_SAMPLED_FB_BASE, vb_sub_sam_buf.daddr);
 	/* set sub-sampled buffer size for one frame */
@@ -2127,17 +2128,11 @@ int wave5_vpu_enc_register_framebuffer(struct device *dev, struct vpu_instance *
 
 		ret = send_firmware_command(inst, W5_SET_FB, false, NULL, NULL);
 		if (ret)
-			goto free_vb_mem;
+			return ret;
 	}
 
-	ret = wave5_vpu_firmware_command_queue_error_check(vpu_dev, NULL);
-	if (ret)
-		goto free_vb_mem;
-
-	return ret;
+	return wave5_vpu_firmware_command_queue_error_check(vpu_dev, NULL);
 
-free_vb_mem:
-	wave5_vdi_free_dma_memory(vpu_dev, &vb_task);
 free_vb_task:
 	wave5_vdi_free_dma_memory(vpu_dev, &vb_sub_sam_buf);
 free_vb_sam_buf:
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
index 02a1fc6fe589d..3ca55162397b5 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpu-enc.c
@@ -1346,6 +1346,7 @@ static int prepare_fb(struct vpu_instance *inst)
 	u32 fb_height = ALIGN(inst->dst_fmt.height, 32);
 	int i, ret = 0;
 
+	/* Instance cleanup releases these only after enc_close stops firmware. */
 	for (i = 0; i < inst->fbc_buf_count; i++) {
 		u32 luma_size = fb_stride * fb_height;
 		u32 chroma_size = ALIGN(fb_stride / 2, 16) * fb_height;
@@ -1355,7 +1356,7 @@ static int prepare_fb(struct vpu_instance *inst)
 		if (ret < 0) {
 			dev_err(inst->dev->dev, "%s: failed to allocate FBC buffer %zu\n",
 				__func__, inst->frame_vbuf[i].size);
-			goto free_buffers;
+			return ret;
 		}
 
 		inst->frame_buf[i].buf_y = inst->frame_vbuf[i].daddr;
@@ -1371,14 +1372,10 @@ static int prepare_fb(struct vpu_instance *inst)
 		dev_err(inst->dev->dev,
 			"%s: wave5_vpu_enc_register_frame_buffer, fail: %d\n",
 			__func__, ret);
-		goto free_buffers;
+		return ret;
 	}
 
 	return 0;
-free_buffers:
-	for (i = 0; i < inst->fbc_buf_count; i++)
-		wave5_vpu_dec_reset_framebuffer(inst, i);
-	return ret;
 }
 
 static int wave5_vpu_enc_start_streaming(struct vb2_queue *q, unsigned int count)
