From b7e3efcb83375237881ea63d7723d04e73f0633f Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Tue, 20 Oct 2026 17:13:12 +0800
Subject: [PATCH] media: wave5: enable T7 encoding with bounded firmware
 teardown

---
 ...ogic-t7-a311d2-khadas-vim4-hdmirx-test.dts |  18 +++
 .../media/platform/chips-media/wave5/Kconfig  |   2 +-
 .../platform/chips-media/wave5/wave5-hw.c     |  16 ++-
 .../platform/chips-media/wave5/wave5-vpu.c    | 111 ++++++++++++++++--
 .../platform/chips-media/wave5/wave5-vpuapi.h |   4 +
 5 files changed, 137 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4-hdmirx-test.dts b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4-hdmirx-test.dts
index cb1fcfca2f5bc..f9c6e0b1c88b9 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4-hdmirx-test.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-khadas-vim4-hdmirx-test.dts
@@ -21,6 +21,24 @@ &hdmirx {
 };
 
 / {
+	wave_test: video-codec@fe310000 {
+		compatible = "amlogic,t7-wave521c";
+		reg = <0x0 0xfe310000 0x0 0x10000>;
+		interrupts = <GIC_SPI 94 IRQ_TYPE_EDGE_RISING>;
+		/* The secure power controller owns the NIC3 AXI bridge reset. */
+		power-domains = <&pwrc PWRC_T7_DOS_WAVE_ID>;
+		clocks = <&clkc_periphs CLKID_SYS_DOS>,
+			 <&clkc_periphs CLKID_VAPB>,
+			 <&clkc_periphs CLKID_WAVE_A>,
+			 <&clkc_periphs CLKID_WAVE_B>,
+			 <&clkc_periphs CLKID_WAVE_C>;
+		clock-names = "pclk", "apb", "axi", "bpu", "vce";
+		assigned-clocks = <&clkc_periphs CLKID_WAVE_A>,
+				  <&clkc_periphs CLKID_WAVE_B>,
+				  <&clkc_periphs CLKID_WAVE_C>;
+		assigned-clock-rates = <666666666>, <666666666>, <666666666>;
+	};
+
 	vdin_test: video-capture@ff000000 {
 		compatible = "amlogic,t7-vdin-test";
 		reg = <0x0 0xff000000 0x0 0x40000>;
diff --git a/drivers/media/platform/chips-media/wave5/Kconfig b/drivers/media/platform/chips-media/wave5/Kconfig
index f1bcef5177bdc..847f9943eeb23 100644
--- a/drivers/media/platform/chips-media/wave5/Kconfig
+++ b/drivers/media/platform/chips-media/wave5/Kconfig
@@ -3,7 +3,7 @@ config VIDEO_WAVE_VPU
 	tristate "Chips&Media Wave Codec Driver"
 	depends on V4L_MEM2MEM_DRIVERS
 	depends on VIDEO_DEV && OF
-	depends on ARCH_K3 || COMPILE_TEST
+	depends on ARCH_K3 || ARCH_MESON || COMPILE_TEST
 	select VIDEOBUF2_DMA_CONTIG
 	select VIDEOBUF2_VMALLOC
 	select V4L2_MEM2MEM_DEV
diff --git a/drivers/media/platform/chips-media/wave5/wave5-hw.c b/drivers/media/platform/chips-media/wave5/wave5-hw.c
index 2392bce8d840b..d79590e8cd700 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-hw.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-hw.c
@@ -174,6 +174,9 @@ static int wave5_wait_bus_busy(struct vpu_device *vpu_dev, unsigned int addr)
 	    vpu_dev->product_code == WAVE521E1_CODE)
 		gdi_status_check_value = 0x00ff1f3f;
 
+	/* T7's Wave521c exposes six bus-idle bits, unlike the TI integration. */
+	if (vpu_dev->bus_idle_value)
+		gdi_status_check_value = vpu_dev->bus_idle_value;
 	return wave5_wait_fio_readl(vpu_dev, addr, gdi_status_check_value);
 }
 
@@ -393,6 +396,9 @@ static int setup_wave5_properties(struct device *dev)
 							   hw_config_def0);
 	}
 
+	/* Older T7 hardware does not report encoder capability in STD_DEF1. */
+	if (vpu_dev->encoder_mask)
+		p_attr->support_encoders = vpu_dev->encoder_mask;
 	setup_wave5_interrupts(vpu_dev);
 
 	return 0;
@@ -1430,7 +1436,7 @@ int wave5_vpu_reset(struct device *dev, enum sw_reset_mode reset_mode)
 	case SW_RESET_ON_BOOT:
 	case SW_RESET_FORCE:
 	case SW_RESET_SAFETY:
-		val = W5_RST_BLOCK_ALL;
+		val = vpu_dev->reset_mask;
 		break;
 	default:
 		return -EINVAL;
@@ -1753,6 +1759,9 @@ int wave5_vpu_enc_init_seq(struct vpu_instance *inst)
 			| p_open_param->pic_width);
 	vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_CUSTOM_MAP_ENDIAN, VDI_LITTLE_ENDIAN);
 
+	dev_dbg(inst->dev->dev, "encoder setup: codec %u profile %u level %u fps %u rc %u\n",
+		inst->std, p_param->profile, p_param->level, p_open_param->frame_rate_info,
+		p_open_param->rc_enable);
 	reg_val = p_param->profile |
 		(p_param->level << 3) |
 		(p_param->internal_bit_depth << 14);
@@ -1861,6 +1870,11 @@ int wave5_vpu_enc_init_seq(struct vpu_instance *inst)
 	vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_USER_SCALING_LIST_ADDR, 0);
 	vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_NUM_UNITS_IN_TICK, 0);
 	vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_TIME_SCALE, 0);
+	if (inst->std == W_HEVC_ENC && inst->dev->legacy_firmware) {
+		vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_NUM_UNITS_IN_TICK, 1);
+		vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_TIME_SCALE,
+			      p_open_param->frame_rate_info);
+	}
 	vpu_write_reg(inst->dev, W5_CMD_ENC_SEQ_NUM_TICKS_POC_DIFF_ONE, 0);
 
 	if (inst->std == W_HEVC_ENC) {
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpu.c b/drivers/media/platform/chips-media/wave5/wave5-vpu.c
index 76d57c6b636a2..8027fd6c8ac71 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpu.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpu.c
@@ -22,11 +22,16 @@
 
 #define WAVE5_IS_ENC BIT(0)
 #define WAVE5_IS_DEC BIT(1)
+#define WAVE5_KEEP_POWER BIT(2)
 
 struct wave5_match_data {
 	int flags;
 	const char *fw_name;
 	u32 sram_size;
+	u32 bus_idle_value;
+	u32 encoder_mask;
+	bool legacy_firmware;
+	u32 reset_mask;
 };
 
 static int vpu_poll_interval = 5;
@@ -223,6 +228,9 @@ static __maybe_unused int wave5_pm_suspend(struct device *dev)
 {
 	struct vpu_device *vpu = dev_get_drvdata(dev);
 
+	/* T7 keeps clocks running until genpd completes its power-off sequence. */
+	if (vpu->legacy_firmware)
+		return 0;
 	if (pm_runtime_suspended(dev))
 		return 0;
 
@@ -240,12 +248,17 @@ static __maybe_unused int wave5_pm_resume(struct device *dev)
 	struct vpu_device *vpu = dev_get_drvdata(dev);
 	int ret = 0;
 
-	wave5_vpu_sleep_wake(dev, false, NULL, 0);
+	/* T7 probe owns the clocks before asking genpd to power the block on. */
+	if (vpu->legacy_firmware)
+		return 0;
 	ret = clk_bulk_prepare_enable(vpu->num_clks, vpu->clks);
 	if (ret) {
 		dev_err(dev, "Enabling clocks, fail: %d\n", ret);
 		return ret;
 	}
+	/* Initial runtime resume powers the domain before firmware is allocated. */
+	if (vpu->common_mem.vaddr)
+		wave5_vpu_sleep_wake(dev, false, NULL, 0);
 
 	if (vpu->irq < 0 && !hrtimer_active(&vpu->hrtimer))
 		hrtimer_start(&vpu->hrtimer, ns_to_ktime(vpu->vpu_poll_interval * NSEC_PER_MSEC),
@@ -264,6 +277,7 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 	struct vpu_device *dev;
 	const struct wave5_match_data *match_data;
 	u32 fw_revision;
+	bool power_held = false;
 
 	match_data = device_get_match_data(&pdev->dev);
 	if (!match_data) {
@@ -293,6 +307,7 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 	spin_lock_init(&dev->irq_spinlock);
 	dev_set_drvdata(&pdev->dev, dev);
 	dev->dev = &pdev->dev;
+	dev->legacy_firmware = match_data->legacy_firmware;
 
 	dev->resets = devm_reset_control_array_get_optional_exclusive(&pdev->dev);
 	if (IS_ERR(dev->resets)) {
@@ -300,10 +315,6 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 				     "Failed to get reset control\n");
 	}
 
-	ret = reset_control_deassert(dev->resets);
-	if (ret)
-		return dev_err_probe(&pdev->dev, ret, "Failed to deassert resets\n");
-
 	ret = devm_clk_bulk_get_all(&pdev->dev, &dev->clks);
 
 	/* continue without clock, assume externally managed */
@@ -318,12 +329,30 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 		dev_err(&pdev->dev, "Enabling clocks, fail: %d\n", ret);
 		goto err_reset_assert;
 	}
+	if (match_data->flags & WAVE5_KEEP_POWER) {
+		pm_runtime_enable(&pdev->dev);
+		ret = pm_runtime_resume_and_get(&pdev->dev);
+		if (ret < 0) {
+			pm_runtime_disable(&pdev->dev);
+			goto err_clk_dis;
+		}
+		power_held = true;
+	}
+	/* The T7 AXI bridge must leave reset with its domain and clocks running. */
+	ret = reset_control_deassert(dev->resets);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to deassert resets: %d\n", ret);
+		goto err_clk_dis;
+	}
 
 	dev->sram_pool = of_gen_pool_get(pdev->dev.of_node, "sram", 0);
-	if (!dev->sram_pool)
+	if (!dev->sram_pool && match_data->sram_size)
 		dev_warn(&pdev->dev, "sram node not found\n");
 
 	dev->sram_size = match_data->sram_size;
+	dev->bus_idle_value = match_data->bus_idle_value;
+	dev->encoder_mask = match_data->encoder_mask;
+	dev->reset_mask = match_data->reset_mask ?: W5_RST_BLOCK_ALL;
 
 	dev->product_code = wave5_vdi_read_register(dev, VPU_PRODUCT_CODE_REGISTER);
 	ret = wave5_vdi_init(&pdev->dev);
@@ -355,7 +384,7 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 						wave5_vpu_irq_thread, IRQF_ONESHOT, "vpu_irq", dev);
 		if (ret) {
 			dev_err(&pdev->dev, "Register interrupt handler, fail: %d\n", ret);
-			goto err_enc_unreg;
+			goto err_vdi_release;
 		}
 	}
 
@@ -380,6 +409,16 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 		}
 	}
 
+	if (match_data->flags & WAVE5_KEEP_POWER) {
+		dev_info(&pdev->dev, "T7 product %#x, previous PC %#x\n",
+			 dev->product_code, wave5_vdi_read_register(dev, W5_VCPU_CUR_PC));
+		/* A warm boot can retain the previous kernel's firmware state. */
+		ret = wave5_vpu_reset(&pdev->dev, SW_RESET_ON_BOOT);
+		if (ret) {
+			dev_err(&pdev->dev, "T7 initial reset failed: %d\n", ret);
+			goto err_enc_unreg;
+		}
+	}
 	ret = wave5_vpu_load_firmware(&pdev->dev, match_data->fw_name, &fw_revision);
 	if (ret) {
 		dev_err(&pdev->dev, "wave5_vpu_load_firmware, fail: %d\n", ret);
@@ -394,8 +433,11 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 
 	pm_runtime_set_autosuspend_delay(&pdev->dev, 500);
 	pm_runtime_use_autosuspend(&pdev->dev);
-	pm_runtime_enable(&pdev->dev);
-	wave5_vpu_sleep_wake(&pdev->dev, true, NULL, 0);
+	/* T7 retains the initial runtime reference: power collapse loses firmware. */
+	if (!(match_data->flags & WAVE5_KEEP_POWER)) {
+		pm_runtime_enable(&pdev->dev);
+		wave5_vpu_sleep_wake(&pdev->dev, true, NULL, 0);
+	}
 
 	return 0;
 
@@ -410,14 +452,30 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 err_irq_release:
 	if (dev->irq < 0)
 		kthread_destroy_worker(dev->worker);
+	else
+		devm_free_irq(&pdev->dev, dev->irq, dev);
 err_vdi_release:
 	if (dev->irq_thread) {
 		kthread_stop(dev->irq_thread);
 		up(&dev->irq_sem);
 		dev->irq_thread = NULL;
 	}
+	if (power_held) {
+		int power_ret = pm_runtime_put_sync_suspend(&pdev->dev);
+
+		pm_runtime_disable(&pdev->dev);
+		power_held = false;
+		if (power_ret < 0) {
+			dev_err(&pdev->dev, "Power-off failed; retaining DMA memory and clocks\n");
+			return ret;
+		}
+	}
 	wave5_vdi_release(&pdev->dev);
 err_clk_dis:
+	if (power_held) {
+		pm_runtime_put_sync_suspend(&pdev->dev);
+		pm_runtime_disable(&pdev->dev);
+	}
 	clk_bulk_disable_unprepare(dev->num_clks, dev->clks);
 err_reset_assert:
 	reset_control_assert(dev->resets);
@@ -428,6 +486,8 @@ static int wave5_vpu_probe(struct platform_device *pdev)
 static void wave5_vpu_remove(struct platform_device *pdev)
 {
 	struct vpu_device *dev = dev_get_drvdata(&pdev->dev);
+	const struct wave5_match_data *match_data = device_get_match_data(&pdev->dev);
+	bool stopped = true;
 
 	wave5_vpu_enc_unregister_device(dev);
 	wave5_vpu_dec_unregister_device(dev);
@@ -443,6 +503,21 @@ static void wave5_vpu_remove(struct platform_device *pdev)
 		hrtimer_cancel(&dev->hrtimer);
 		kthread_cancel_work_sync(&dev->work);
 		kthread_destroy_worker(dev->worker);
+	} else {
+		/* No handler may access registers or instance locks after teardown. */
+		devm_free_irq(&pdev->dev, dev->irq, dev);
+	}
+	if (match_data->flags & WAVE5_KEEP_POWER) {
+		/* Stop instruction fetch and drain DMA before resetting the AXI bridge. */
+		stopped = !wave5_vpu_reset(&pdev->dev, SW_RESET_ON_BOOT);
+		/* Finish the secure power-off while the functional clocks still run. */
+		if (stopped)
+			stopped = pm_runtime_put_sync_suspend(&pdev->dev) >= 0;
+		else
+			pm_runtime_put_noidle(&pdev->dev);
+		if (!stopped)
+			dev_err(&pdev->dev,
+				"T7 DMA stop failed; retaining firmware memory and clocks until reboot\n");
 	}
 
 	pm_runtime_dont_use_autosuspend(&pdev->dev);
@@ -451,9 +526,11 @@ static void wave5_vpu_remove(struct platform_device *pdev)
 	mutex_destroy(&dev->dev_lock);
 	mutex_destroy(&dev->hw_lock);
 	mutex_destroy(&dev->irq_lock);
-	reset_control_assert(dev->resets);
-	clk_bulk_disable_unprepare(dev->num_clks, dev->clks);
-	wave5_vdi_release(&pdev->dev);
+	if (stopped) {
+		reset_control_assert(dev->resets);
+		clk_bulk_disable_unprepare(dev->num_clks, dev->clks);
+		wave5_vdi_release(&pdev->dev);
+	}
 	ida_destroy(&dev->inst_ida);
 }
 
@@ -463,8 +540,18 @@ static const struct wave5_match_data ti_wave521c_data = {
 	.sram_size = (64 * 1024),
 };
 
+static const struct wave5_match_data t7_wave521c_data = {
+	.flags = WAVE5_IS_ENC | WAVE5_KEEP_POWER,
+	.fw_name = "amlogic/t7-wave521c-enc.bin",
+	.bus_idle_value = 0x3f,
+	.encoder_mask = BIT(STD_AVC) | BIT(STD_HEVC),
+	.legacy_firmware = true,
+	.reset_mask = GENMASK(26, 0),
+};
+
 static const struct of_device_id wave5_dt_ids[] = {
 	{ .compatible = "ti,j721s2-wave521c", .data = &ti_wave521c_data },
+	{ .compatible = "amlogic,t7-wave521c", .data = &t7_wave521c_data },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, wave5_dt_ids);
diff --git a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
index 7b08fef582171..57456c970cae8 100644
--- a/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
+++ b/drivers/media/platform/chips-media/wave5/wave5-vpuapi.h
@@ -761,6 +761,10 @@ struct vpu_device {
 	struct vpu_buf sram_buf;
 	void __iomem *vdb_register;
 	u32 product_code;
+	u32 bus_idle_value;
+	u32 encoder_mask;
+	bool legacy_firmware;
+	u32 reset_mask;
 	struct ida inst_ida;
 	struct clk_bulk_data *clks;
 	struct hrtimer hrtimer;
