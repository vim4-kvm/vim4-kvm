From a4198be767ce14053ba1002824f6c50e67b0a3f3 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:51:15 +0800
Subject: [PATCH] Support frequency-only OPP tables in Panfrost

Keep supply enablement in the device lifecycle when an OPP v2 table only describes clock rates. Register OPP regulators only for voltage-bearing tables, allowing platforms to retain firmware voltage settings while using devfreq.
---
 drivers/gpu/drm/panfrost/panfrost_devfreq.c | 37 +++++++++++++++++----
 drivers/gpu/drm/panfrost/panfrost_devfreq.h |  1 +
 drivers/gpu/drm/panfrost/panfrost_device.c  |  5 +--
 3 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panfrost/panfrost_devfreq.c b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
index b51c307788110..93d0e15bea1cf 100644
--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.c
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
@@ -5,6 +5,7 @@
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
 #include <linux/nvmem-consumer.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_opp.h>
 
@@ -116,6 +117,23 @@ static int panfrost_read_speedbin(struct device *dev)
 	return devm_pm_opp_set_supported_hw(dev, &val, 1);
 }
 
+static bool panfrost_opp_has_voltage(struct device *dev)
+{
+	struct device_node *opp_table __free(device_node) =
+		dev_pm_opp_of_get_opp_desc_node(dev);
+
+	/* Preserve regulator setup for platforms without an OPP v2 table. */
+	if (!opp_table)
+		return true;
+
+	for_each_available_child_of_node_scoped(opp_table, opp) {
+		if (of_property_present(opp, "opp-microvolt"))
+			return true;
+	}
+
+	return false;
+}
+
 int panfrost_devfreq_init(struct panfrost_device *pfdev)
 {
 	int ret;
@@ -140,13 +158,18 @@ int panfrost_devfreq_init(struct panfrost_device *pfdev)
 	if (ret)
 		return ret;
 
-	ret = devm_pm_opp_set_regulators(dev, pfdev->comp->supply_names);
-	if (ret) {
-		/* Continue if the optional regulator is missing */
-		if (ret != -ENODEV) {
-			if (ret != -EPROBE_DEFER)
-				DRM_DEV_ERROR(dev, "Couldn't set OPP regulators\n");
-			return ret;
+	/* Frequency-only tables leave supply enablement to the device code. */
+	if (panfrost_opp_has_voltage(dev)) {
+		ret = devm_pm_opp_set_regulators(dev, pfdev->comp->supply_names);
+		if (ret) {
+			/* Continue if the optional regulator is missing */
+			if (ret != -ENODEV) {
+				if (ret != -EPROBE_DEFER)
+					DRM_DEV_ERROR(dev, "Couldn't set OPP regulators\n");
+				return ret;
+			}
+		} else {
+			pfdevfreq->opp_regulators = true;
 		}
 	}
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_devfreq.h b/drivers/gpu/drm/panfrost/panfrost_devfreq.h
index 48dbe185f2061..d22c49849e1d4 100644
--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.h
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.h
@@ -18,6 +18,7 @@ struct panfrost_devfreq {
 	struct thermal_cooling_device *cooling;
 	struct devfreq_simple_ondemand_data gov_data;
 	bool opp_of_table_added;
+	bool opp_regulators;
 
 	unsigned long current_frequency;
 	unsigned long fast_rate;
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.c b/drivers/gpu/drm/panfrost/panfrost_device.c
index d0a23c51be39d..521ec60f7c513 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.c
+++ b/drivers/gpu/drm/panfrost/panfrost_device.c
@@ -252,8 +252,9 @@ int panfrost_device_init(struct panfrost_device *pfdev)
 		goto out_clk;
 	}
 
-	/* OPP will handle regulators */
-	if (!pfdev->pfdevfreq.opp_of_table_added) {
+	/* OPP handles supplies only when the table describes voltages. */
+	if (!pfdev->pfdevfreq.opp_of_table_added ||
+	    !pfdev->pfdevfreq.opp_regulators) {
 		err = panfrost_regulator_init(pfdev);
 		if (err)
 			goto out_devfreq;
