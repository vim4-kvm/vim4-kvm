@@ -186,6 +186,14 @@
   GstV4l2VideoEnc *self = GST_V4L2_VIDEO_ENC (encoder);
 
   GST_DEBUG_OBJECT (self, "Starting");
+
+  const GstStructure *controls = self->v4l2output->extra_controls;
+  gint gop;
+  self->wave5_avc_recovery = controls &&
+      !strcmp (GST_V4L2_VIDEO_ENC_GET_CLASS (self)->codec_name, "H264") &&
+      !strcmp ((const char *) self->v4l2output->vcap.driver, "wave5-enc") &&
+      gst_structure_get_int (controls, "video_gop_size", &gop) && gop == 0;
+  self->recovery_steps = self->wave5_avc_recovery ? 14 : 0;
 
   gst_v4l2_object_unlock (self->v4l2output);
   g_atomic_int_set (&self->active, TRUE);
@@ -847,6 +855,19 @@
   }
 
   if (frame->input_buffer) {
+    if (self->wave5_avc_recovery && GST_VIDEO_CODEC_FRAME_IS_FORCE_KEYFRAME (frame))
+      self->recovery_steps = 14;
+    if (self->recovery_steps) {
+      /* Hold 12 through IDR and P1, then release one QP per submitted picture. */
+      --self->recovery_steps;
+      struct v4l2_control floor = { V4L2_CID_MPEG_VIDEO_H264_P_FRAME_MIN_QP,
+        MIN (self->recovery_steps, 12) };
+      if (self->v4l2output->ioctl (self->v4l2output->video_fd, VIDIOC_S_CTRL, &floor) < 0) {
+        GST_ELEMENT_ERROR (encoder, RESOURCE, SETTINGS,
+            ("Cannot set Wave5 recovery P QP: %s", g_strerror (errno)), (NULL));
+        return GST_FLOW_ERROR;
+      }
+    }
     /* Process force keyframe event if it was passed */
     if (GST_VIDEO_CODEC_FRAME_IS_FORCE_KEYFRAME (frame)) {
       struct v4l2_control ctrl = { V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 1 };
