[Unit]
Description=One-KVM experimental V4L2/Wave5 video
After=network.target one-kvm-edge-usb.service video-firmware-preload-khadas.service
Wants=one-kvm-edge-usb.service video-firmware-preload-khadas.service
ConditionKernelVersion=7.3.0-rc7-vim4kvm-uhd1+
ConditionKernelCommandLine=vim4.one_kvm=1
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=khadas
Group=khadas
SupplementaryGroups=video render input
# Keep capture, encoding and delivery on T7's higher-capacity cores.
# CPUs 0-3 have capacity 1024; CPUs 4-7 have capacity 577.
CPUAffinity=0-3
StateDirectory=one-kvm-edge
RuntimeDirectory=one-kvm-edge
WorkingDirectory=/var/lib/one-kvm-edge
ExecStartPre=+/opt/vim4-onekvm-edge/one-kvm-edge-prepare
ExecStart=/opt/vim4-onekvm-edge/one-kvm-edge
ExecStopPost=+/usr/libexec/vim4-onekvm-edge usb-restore
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
