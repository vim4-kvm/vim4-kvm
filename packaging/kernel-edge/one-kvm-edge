#!/bin/sh
# A separate binary/data directory avoids changing the installed 5.15 application.
set -eu
case "$(uname -r)" in
    5.15.*)
        export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
        export LD_LIBRARY_PATH=/opt/vim4-onekvm/lib
        export GST_REGISTRY=/var/lib/one-kvm/gstreamer-registry.bin
        export VIM4_VIDEO_BACKEND=vendor
        exec /opt/vim4-onekvm/one-kvm --data-dir /var/lib/one-kvm --address 127.0.0.1 --port 8081 --auth-mode managed
        ;;
    7.3.0-rc7-vim4kvm-uhd1+|7.3.0-vim4kvm-uhd1+|7.3.0-vim4kvm-uhd2+|7.3.0-vim4kvm-uhd2-nodebug+|7.3.0-vim4kvm-uhd3+|7.3.0-vim4kvm-npu1+|7.3.0-vim4kvm-npu2+|7.3.0-vim4kvm-npu3+|7.3.0-vim4kvm-npu4+)
        export VIM4_VIDEO_BACKEND=wave5
        export GST_PLUGIN_PATH=/opt/vim4-onekvm-edge/gstreamer-1.0
        export GST_REGISTRY=/run/one-kvm-edge/gstreamer-registry.bin
        unset LD_LIBRARY_PATH
        exec /opt/vim4-onekvm-edge/one-kvm --data-dir /var/lib/one-kvm-edge --address 127.0.0.1 --port 8082 --auth-mode managed
        ;;
    *) echo 'No validated One-KVM backend for this kernel' >&2; exit 1 ;;
esac
