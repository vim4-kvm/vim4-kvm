From 7bfda5c015eaadc253da93d547bca9fa3f42f589 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:18:05 +0800
Subject: [PATCH 1/3] wifi: brcmfmac: program BCM43752 AES-CMAC keys as BIP

---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c  | 3 ++-
 drivers/net/wireless/broadcom/brcm80211/include/brcmu_wifi.h | 1 +
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index e8db49c9345f0..56f9bb2446d64 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -2894,7 +2894,8 @@ brcmf_cfg80211_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
 		brcmf_dbg(CONN, "WLAN_CIPHER_SUITE_TKIP\n");
 		break;
 	case WLAN_CIPHER_SUITE_AES_CMAC:
-		key->algo = CRYPTO_ALGO_AES_CCM;
+		key->algo = drvr->bus_if->chip == BRCM_CC_43752_CHIP_ID ?
+			    CRYPTO_ALGO_BIP : CRYPTO_ALGO_AES_CCM;
 		val = AES_ENABLED;
 		brcmf_dbg(CONN, "WLAN_CIPHER_SUITE_AES_CMAC\n");
 		break;
diff --git a/drivers/net/wireless/broadcom/brcm80211/include/brcmu_wifi.h b/drivers/net/wireless/broadcom/brcm80211/include/brcmu_wifi.h
index c465208c43318..5815cd07caa15 100644
--- a/drivers/net/wireless/broadcom/brcm80211/include/brcmu_wifi.h
+++ b/drivers/net/wireless/broadcom/brcm80211/include/brcmu_wifi.h
@@ -197,6 +197,7 @@ static inline bool ac_bitmap_tst(u8 bitmap, int prec)
 #define	CRYPTO_ALGO_TKIP		2
 #define	CRYPTO_ALGO_WEP128		3
 #define CRYPTO_ALGO_AES_CCM		4
+#define CRYPTO_ALGO_BIP			13
 #define CRYPTO_ALGO_AES_RESERVED1	5
 #define CRYPTO_ALGO_AES_RESERVED2	6
 #define CRYPTO_ALGO_NALG		7

From 492cc81f84ce549a39e7253483355839c373330d Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:18:06 +0800
Subject: [PATCH 2/3] wifi: brcmfmac: accept the BCM43752 SDPCM transmit window

---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
index 381801af3ac98..12031eaa21414 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
@@ -1373,6 +1373,7 @@ static int brcmf_sdio_hdparse(struct brcmf_sdio *bus, u8 *header,
 {
 	u16 len, checksum;
 	u8 rx_seq, fc, tx_seq_max;
+	u8 max_window = bus->ci->chip == BRCM_CC_43752_CHIP_ID ? 0x70 : 0x40;
 	u32 swheader;
 
 	trace_brcmf_sdpcm_hdr(SDPCM_RX, header);
@@ -1469,7 +1470,7 @@ static int brcmf_sdio_hdparse(struct brcmf_sdio *bus, u8 *header,
 		bus->flowcontrol = fc;
 	}
 	tx_seq_max = (swheader & SDPCM_WINDOW_MASK) >> SDPCM_WINDOW_SHIFT;
-	if ((u8)(tx_seq_max - bus->tx_seq) > 0x40) {
+	if ((u8)(tx_seq_max - bus->tx_seq) > max_window) {
 		brcmf_err("seq %d: max tx seq number error\n", rx_seq);
 		tx_seq_max = bus->tx_seq + 2;
 	}

From 923aa01fdd7d454076ea41b560afe267291b5618 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:34:52 +0800
Subject: [PATCH 3/3] wifi: brcmfmac: handle discovery BSS on AP6275S firmware
 e47f9a86

---
 .../broadcom/brcm80211/brcmfmac/test_p2p.py    | 18 ++++++++++++------
 .../broadcom/brcm80211/brcmfmac/wcc/core.c     |  7 +++++--
 2 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/test_p2p.py b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/test_p2p.py
index 556720e46c06e..c005716ba663b 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/test_p2p.py
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/test_p2p.py
@@ -301,12 +301,18 @@ int main(void) {
      */
     struct brcmf_bus bus = {.chip=BRCM_CC_43752_CHIP_ID};
     struct brcmf_mp_device settings = {.fcmode=BRCMF_FWS_FCMODE_AUTO};
-    pub.bus_if=&bus; pub.settings=&settings; pub.fwver="01-16e134aa";
-    brcmf_wcc_feat_attach(&primary);
-    assert(settings.fcmode == BRCMF_FWS_FCMODE_EXPLICIT_CREDIT);
-    assert(pub.chip_quirks & BIT(BRCMF_FEAT_QUIRK_P2P_DEV_NO_IF_EVT));
-    assert(pub.chip_quirks & BIT(BRCMF_FEAT_QUIRK_ARP_ND_PRIMARY));
-    assert(pub.feat_flags & BIT(BRCMF_FEAT_SAE_EXT));
+    pub.bus_if=&bus; pub.settings=&settings;
+    const char *sdio_firmware[] = {"01-16e134aa", "01-e47f9a86"};
+    for (int i=0; i<2; i++) {
+        pub.fwver=sdio_firmware[i];
+        pub.chip_quirks=0; pub.feat_flags=0;
+        settings.fcmode=BRCMF_FWS_FCMODE_AUTO;
+        brcmf_wcc_feat_attach(&primary);
+        assert(settings.fcmode == BRCMF_FWS_FCMODE_EXPLICIT_CREDIT);
+        assert(pub.chip_quirks & BIT(BRCMF_FEAT_QUIRK_P2P_DEV_NO_IF_EVT));
+        assert(pub.chip_quirks & BIT(BRCMF_FEAT_QUIRK_ARP_ND_PRIMARY));
+        assert(pub.feat_flags & BIT(BRCMF_FEAT_SAE_EXT));
+    }
     for (int mode=0; mode<=2; mode++) {
         settings.fcmode=mode;
         brcmf_wcc_feat_attach(&primary);
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/wcc/core.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/wcc/core.c
index 4831a75b42d01..f40618c6410ac 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/wcc/core.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/wcc/core.c
@@ -59,6 +59,7 @@ static bool brcmf_wcc_extsae(struct brcmf_pub *drvr)
 static void brcmf_wcc_feat_attach(struct brcmf_if *ifp)
 {
 	char caps[768] = {};
+	bool discovery_bss;
 	int err;
 
 	if (ifp->drvr->bus_if->chip != BRCM_CC_43752_CHIP_ID)
@@ -67,7 +68,9 @@ static void brcmf_wcc_feat_attach(struct brcmf_if *ifp)
 	 * a separate firmware interface. Query p2p_dev instead of waiting for
 	 * IF_ADD/IF_DEL; group interfaces still use their normal IF events.
 	 */
-	if (!strcmp(ifp->drvr->fwver, "01-16e134aa"))
+	discovery_bss = !strcmp(ifp->drvr->fwver, "01-16e134aa") ||
+			!strcmp(ifp->drvr->fwver, "01-e47f9a86");
+	if (discovery_bss)
 		ifp->drvr->chip_quirks |= BIT(BRCMF_FEAT_QUIRK_P2P_DEV_NO_IF_EVT) |
 					 BIT(BRCMF_FEAT_QUIRK_ARP_ND_PRIMARY) |
 					 BIT(BRCMF_FEAT_QUIRK_ND_HOSTIP_V1);
@@ -77,7 +80,7 @@ static void brcmf_wcc_feat_attach(struct brcmf_if *ifp)
 	 * queueing frames for an interface whose radio context is absent.
 	 * Keep an explicit fcmode=0/1/2 request and other firmware defaults.
 	 */
-	if (!err && !strcmp(ifp->drvr->fwver, "01-16e134aa") &&
+	if (!err && discovery_bss &&
 	    strstr(caps, "proptxstatus ") &&
 	    ifp->drvr->settings->fcmode == BRCMF_FWS_FCMODE_AUTO)
 		ifp->drvr->settings->fcmode = BRCMF_FWS_FCMODE_EXPLICIT_CREDIT;
