+/* The installed Amlogic libgstvideo adds a transfer enum entry in the middle.
+ * ISO identifiers cross that ABI boundary without interpreting runtime enum
+ * values using the build headers. Use this result only in local switch cases. */
+static GstVideoTransferFunction
+gst_v4l2_object_local_transfer (GstVideoTransferFunction transfer)
+{
+  switch (gst_video_transfer_function_to_iso (transfer)) {
+    case 6:
+      return GST_VIDEO_TRANSFER_BT601;
+    case 14:
+      return GST_VIDEO_TRANSFER_BT2020_10;
+    case 16:
+      return GST_VIDEO_TRANSFER_SMPTE2084;
+    case 17:
+      return GST_VIDEO_TRANSFER_ADOBERGB;
+    case 18:
+      return GST_VIDEO_TRANSFER_ARIB_STD_B67;
+    default:
+      return transfer;
+  }
+}
