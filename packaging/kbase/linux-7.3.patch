diff --git a/drivers/gpu/arm/midgard/platform/vim4/platform.c b/drivers/gpu/arm/midgard/platform/vim4/platform.c
new file mode 100644
index 0000000..1414a8e
--- /dev/null
+++ b/drivers/gpu/arm/midgard/platform/vim4/platform.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <mali_kbase.h>
+#include <mali_kbase_config_defaults.h>
+#include <linux/clk.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+
+int meson_gpu_fault;
+int meson_gpu_data_invalid_count;
+MODULE_DESCRIPTION("Mali r44p0 UK 11.39 for VIM4");
+
+struct vim4_platform {
+	struct reset_control *reset;
+	struct clk *bus;
+};
+
+int kbase_platform_dvfs_event(struct kbase_device *kbdev, u32 utilisation,
+			    u32 gl_share, u32 cl_share[2])
+{
+	/* The devfreq governor consumes kbase's metrics directly. */
+	return 0;
+}
+
+static int vim4_init(struct kbase_device *kbdev)
+{
+	struct vim4_platform *platform;
+	int err;
+
+	platform = devm_kzalloc(kbdev->dev, sizeof(*platform), GFP_KERNEL);
+	if (!platform)
+		return -ENOMEM;
+	platform->reset = devm_reset_control_array_get_exclusive(kbdev->dev);
+	if (IS_ERR(platform->reset))
+		return PTR_ERR(platform->reset);
+	platform->bus = devm_clk_get(kbdev->dev, "bus");
+	if (IS_ERR(platform->bus))
+		return PTR_ERR(platform->bus);
+	/* T7 must not reset its domain between jobs. Hold it until removal. */
+	pm_runtime_enable(kbdev->dev);
+	err = pm_runtime_resume_and_get(kbdev->dev);
+	if (err < 0) {
+		pm_runtime_disable(kbdev->dev);
+		return err;
+	}
+	err = clk_prepare_enable(platform->bus);
+	if (err)
+		goto power_off;
+	err = reset_control_deassert(platform->reset);
+	if (err) {
+		clk_disable_unprepare(platform->bus);
+		goto power_off;
+	}
+	kbdev->platform_context = platform;
+	return 0;
+
+power_off:
+	pm_runtime_put_sync(kbdev->dev);
+	pm_runtime_disable(kbdev->dev);
+	return err;
+}
+
+static void vim4_term(struct kbase_device *kbdev)
+{
+	struct vim4_platform *platform = kbdev->platform_context;
+
+	reset_control_assert(platform->reset);
+	clk_disable_unprepare(platform->bus);
+	pm_runtime_put_sync(kbdev->dev);
+	pm_runtime_disable(kbdev->dev);
+}
+
+struct kbase_platform_funcs_conf vim4_platform_funcs = {
+	.platform_init_func = vim4_init,
+	.platform_term_func = vim4_term,
+};
