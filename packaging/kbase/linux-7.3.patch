+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 7, 0)
+struct kbase_shrinker {
+	struct shrinker *registered;
+	unsigned long (*count_objects)(struct shrinker *, struct shrink_control *);
+	unsigned long (*scan_objects)(struct shrinker *, struct shrink_control *);
+	int seeks;
+	long batch;
+};
+
+static inline int kbase_register_shrinker(struct kbase_shrinker *s, const char *name)
+{
+	struct shrinker *registered = shrinker_alloc(0, "%s", name);
+
+	if (!registered)
+		return -ENOMEM;
+	registered->count_objects = s->count_objects;
+	registered->scan_objects = s->scan_objects;
+	registered->seeks = s->seeks;
+	registered->batch = s->batch;
+	registered->private_data = s;
+	s->registered = registered;
+	shrinker_register(registered);
+	return 0;
+}
+#define register_shrinker kbase_register_shrinker
+#define unregister_shrinker(s) shrinker_free((s)->registered)
+#define kbase_shrinker_owner(s, type, member) container_of((struct kbase_shrinker *)(s)->private_data, type, member)
+#else
+#define kbase_shrinker shrinker
+#define kbase_shrinker_owner(s, type, member) container_of(s, type, member)
+#endif
