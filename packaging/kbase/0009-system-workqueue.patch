diff --git a/drivers/gpu/arm/midgard/mali_kbase.h b/drivers/gpu/arm/midgard/mali_kbase.h
--- a/drivers/gpu/arm/midgard/mali_kbase.h
+++ b/drivers/gpu/arm/midgard/mali_kbase.h
@@ -822,7 +822,7 @@ static inline void kbase_file_dec_fops_count(struct kbase_file *kfile)
 	WARN_ON_ONCE(kfile->fops_count <= 0);
 	kfile->fops_count--;
 	if (unlikely(!kfile->fops_count && !kfile->owner && !kfile->map_count)) {
-		queue_work(system_wq, &kfile->destroy_kctx_work);
+		schedule_work(&kfile->destroy_kctx_work);
 #if IS_ENABLED(CONFIG_DEBUG_FS)
 		wake_up(&kfile->zero_fops_count_wait);
 #endif
@@ -862,7 +862,7 @@ static inline void kbase_file_dec_cpu_mapping_count(struct kbase_file *kfile)
 	WARN_ON_ONCE(kfile->map_count <= 0);
 	kfile->map_count--;
 	if (unlikely(!kfile->map_count && !kfile->owner && !kfile->fops_count))
-		queue_work(system_wq, &kfile->destroy_kctx_work);
+		schedule_work(&kfile->destroy_kctx_work);
 	spin_unlock(&kfile->lock);
 }
 
diff --git a/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_pm_driver.c b/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_pm_driver.c
