diff --git a/include/linux/version_compat_defs.h b/include/linux/version_compat_defs.h
index d6b6a5e..b25e686 100644
--- a/include/linux/version_compat_defs.h
+++ b/include/linux/version_compat_defs.h
@@ -26,6 +26,7 @@
 #include <linux/highmem.h>
 #include <linux/timer.h>
 #include <linux/hrtimer.h>
+#include <linux/workqueue.h>
 #include <linux/shrinker.h>
 
 #if (KERNEL_VERSION(7, 3, 0) <= LINUX_VERSION_CODE)
@@ -77,10 +78,48 @@ static inline int kbase_register_shrinker(struct kbase_shrinker *s, const char *
 #define no_llseek NULL
 #define del_timer timer_delete
 #define del_timer_sync timer_delete_sync
-#define hrtimer_init(timer, clock, mode) hrtimer_setup(timer, NULL, clock, mode)
-#define hrtimer_init_on_stack(timer, clock, mode) hrtimer_setup_on_stack(timer, NULL, clock, mode)
 #endif
 
+/* KBASE_RUNTIME_COMPAT_BEGIN: also exercised by the offline host harness. */
+static inline unsigned int kbase_workqueue_flags(unsigned int flags)
+{
+#if (KERNEL_VERSION(7, 3, 0) <= LINUX_VERSION_CODE)
+	/* Preserve the old bound-queue contract without the implicit-default WARN. */
+	if (!(flags & WQ_UNBOUND))
+		flags |= WQ_PERCPU;
+#endif
+	return flags;
+}
+
+#define kbase_alloc_workqueue(fmt, flags, max_active, ...) \
+	alloc_workqueue(fmt, kbase_workqueue_flags(flags), max_active, ##__VA_ARGS__)
+
+static inline void kbase_hrtimer_setup(struct hrtimer *timer,
+				       enum hrtimer_restart (*callback)(struct hrtimer *),
+				       clockid_t clock, enum hrtimer_mode mode)
+{
+#if (KERNEL_VERSION(6, 15, 0) <= LINUX_VERSION_CODE)
+	hrtimer_setup(timer, callback, clock, mode);
+#else
+	hrtimer_init(timer, clock, mode);
+	timer->function = callback;
+#endif
+}
+
+static inline void kbase_hrtimer_setup_on_stack(struct hrtimer *timer,
+						enum hrtimer_restart (*callback)(struct hrtimer *),
+						clockid_t clock, enum hrtimer_mode mode)
+{
+#if (KERNEL_VERSION(6, 15, 0) <= LINUX_VERSION_CODE)
+	hrtimer_setup_on_stack(timer, callback, clock, mode);
+#else
+	hrtimer_init_on_stack(timer, clock, mode);
+	timer->function = callback;
+#endif
+}
+
+/* KBASE_RUNTIME_COMPAT_END */
+
 #if (KERNEL_VERSION(4, 4, 267) < LINUX_VERSION_CODE)
 #include <linux/overflow.h>
 #endif
