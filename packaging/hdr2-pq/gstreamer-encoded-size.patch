 static guint
-calculate_max_sizeimage (GstV4l2Object * v4l2object, guint pixel_bitdepth)
+calculate_max_sizeimage (GstV4l2Object * v4l2object, guint pixel_bitdepth,
+    guint width, guint height)
 {
   guint max_width, max_height;
   guint sizeimage;
 
   max_width = v4l2object->max_width;
   max_height = v4l2object->max_height;
+  /* Encoders have fixed input dimensions for this negotiation. Using the
+   * device maximum can allocate tens of MiB per coded buffer at 4K. Decoders
+   * still need headroom for resolution changes in the compressed input. */
+  if (GST_IS_VIDEO_ENCODER (v4l2object->element) && width && height) {
+    max_width = MIN (max_width, width);
+    max_height = MIN (max_height, height);
+  }
   sizeimage = max_width * max_height * pixel_bitdepth / 8 / 2;
 
   return MAX (ENCODED_BUFFER_MIN_SIZE, sizeimage);
