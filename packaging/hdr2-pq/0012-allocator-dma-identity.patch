+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
@@ -10,6 +10,8 @@
 #include <linux/debugfs.h>
 #include <linux/dma-mapping.h>
 #include <linux/dma-buf.h>
+#include <linux/dma-direct.h>
