 6 files changed, 91 insertions(+), 15 deletions(-)
 create mode 100644 drivers/media/platform/amlogic/t7-hdmirx/test_export_identity.py

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-vdin-test.c
index 09969893d67ee..16edb7dcc90a2 100644
