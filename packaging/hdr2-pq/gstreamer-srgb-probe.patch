--- a/sys/v4l2/gstv4l2object.c
+++ b/sys/v4l2/gstv4l2object.c
@@ -2630,6 +2630,21 @@
         if (gst_v4l2_object_get_colorspace (v4l2object, &fmt, &cinfo))
           gst_v4l2_object_fill_colorimetry_list (&list, &cinfo);
         if (colorspace == V4L2_COLORSPACE_REC709) {
+          /* A mapped SDR capture can retain 709 primaries/matrix while using
+           * sRGB transfer. Ask the device, rather than inventing support. */
+          struct v4l2_format srgb_fmt = fmt;
+
+          if (V4L2_TYPE_IS_MULTIPLANAR (v4l2object->type)) {
+            srgb_fmt.fmt.pix_mp.xfer_func = V4L2_XFER_FUNC_SRGB;
+            srgb_fmt.fmt.pix_mp.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+          } else {
+            srgb_fmt.fmt.pix.xfer_func = V4L2_XFER_FUNC_SRGB;
+            srgb_fmt.fmt.pix.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+          }
+          if (gst_v4l2_object_try_fmt (v4l2object, &srgb_fmt) == 0 &&
+              gst_v4l2_object_get_colorspace (v4l2object, &srgb_fmt, &cinfo))
+            gst_v4l2_object_fill_colorimetry_list (&list, &cinfo);
+
           /* support for full-range variants of colorspaces V4L2_COLORSPACE_REC709
            * (such as Apple's full-range bt709 variant 1:3:5:1) */
           struct v4l2_format alt_fmt;
