#version 310 es
// SPDX-License-Identifier: MIT
precision highp float;
precision highp int;
layout(local_size_x=8, local_size_y=8) in;
layout(std430,binding=0) readonly buffer Input { uint src[]; };
layout(std430,binding=1) writeonly buffer Output { uint dst[]; };
uniform ivec2 input_size, output_size;

float code(ivec2 p, int channel) {
    ivec2 size = channel == 0 ? input_size : input_size/2;
    p = clamp(p, ivec2(0), size-1);
    int sample_index = channel == 0 ? p.y*input_size.x+p.x :
        input_size.x*input_size.y+p.y*input_size.x+2*p.x+channel-1;
    uint word = src[sample_index/2];
    return float((word >> uint(16*(sample_index%2)+6)) & 1023u);
}
float filtered(vec2 at, int channel) {
    if (channel != 0) at = (at+0.5)/2.0-0.5;
    ivec2 p=ivec2(floor(at)); vec2 f=fract(at);
    return mix(mix(code(p,channel),code(p+ivec2(1,0),channel),f.x),
               mix(code(p+ivec2(0,1),channel),code(p+ivec2(1),channel),f.x),f.y);
}
vec3 pq(vec3 v) {
    vec3 p=pow(clamp(v,0.0,1.0),vec3(32.0/2523.0));
    return 10000.0*pow(max(p-3424.0/4096.0,0.0)/
                      (2413.0/128.0-2392.0/128.0*p),vec3(16384.0/2610.0));
}
vec3 convert(ivec2 p) {
    vec2 at=(vec2(p)+0.5)*vec2(input_size)/vec2(output_size)-0.5;
    float y=(filtered(at,0)-64.0)/876.0;
    float cb=(filtered(at,1)-512.0)/896.0, cr=(filtered(at,2)-512.0)/896.0;
    float r=y+1.4746*cr, b=y+1.8814*cb;
    vec3 linear=pq(vec3(r,(y-.2627*r-.0593*b)/.6780,b));
    vec3 rgb=vec3(dot(linear,vec3(1.660491,-.587641,-.072850)),
                  dot(linear,vec3(-.124550,1.132900,-.008349)),
                  dot(linear,vec3(-.018151,-.100579,1.118730)))/203.0;
    float peak=max(max(rgb.r,rgb.g),rgb.b);
    if (peak>.95) {
        float shoulder=(peak-.95)/.05, top=(1000.0/203.0-.95)/.05;
        rgb *= (.95+.05*shoulder*(1.0+shoulder/(top*top))/(1.0+shoulder))/peak;
    }
    rgb=clamp(rgb,0.0,1.0);
    return mix(1.055*pow(rgb,vec3(1.0/2.4))-.055,12.92*rgb,lessThanEqual(rgb,vec3(.0031308)));
}
vec3 yuv(vec3 rgb) {
    float y=dot(rgb,vec3(.2126,.7152,.0722));
    return vec3(16.0+219.0*y,128.0+224.0*(rgb.b-y)/1.8556,
                128.0+224.0*(rgb.r-y)/1.5748);
}
uint byte_value(float v) { return uint(clamp(floor(v+.5),0.0,255.0)); }
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy)*ivec2(4,2);
    if (p.x>=output_size.x || p.y>=output_size.y) return;
    vec3 pixels[8];
    for (int row=0;row<2;row++) {
        uint packed_y=0u;
        for (int col=0;col<4;col++) {
            pixels[row*4+col]=yuv(convert(p+ivec2(col,row)));
            packed_y |= byte_value(pixels[row*4+col].x) << uint(col*8);
        }
        dst[((p.y+row)*output_size.x+p.x)/4]=packed_y;
    }
    uint packed_uv=0u;
    for (int pair=0;pair<2;pair++) {
        vec3 c=(pixels[pair*2]+pixels[pair*2+1]+pixels[4+pair*2]+pixels[5+pair*2])*.25;
        packed_uv |= byte_value(c.y)<<uint(pair*16);
        packed_uv |= byte_value(c.z)<<uint(pair*16+8);
    }
    dst[(output_size.x*output_size.y+(p.y/2)*output_size.x+p.x)/4]=packed_uv;
}
