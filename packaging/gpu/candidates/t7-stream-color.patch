From 8f66386161f42b27f308f8972c6982f9662cdf5d Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Sat, 31 Oct 2026 08:51:09 +0800
Subject: [PATCH] media: t7-hdmirx: expose a leased source color snapshot

---
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.c    | 28 ++++++++++++
 .../platform/amlogic/t7-hdmirx/t7-hdmirx.h    | 12 ++++++
 .../amlogic/t7-hdmirx/test_stream_color.py    | 43 +++++++++++++++++++
 3 files changed, 83 insertions(+)
 create mode 100644 drivers/media/platform/amlogic/t7-hdmirx/test_stream_color.py

diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
index 6a2184af57280..44db38d0cf913 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.c
@@ -1999,6 +1999,34 @@ int t7_hdmirx_stream_get(struct device *dev, unsigned int width, unsigned int he
 }
 EXPORT_SYMBOL_GPL(t7_hdmirx_stream_get);
 
+int t7_hdmirx_get_stream_color(struct device *dev,
+			       struct t7_hdmirx_stream_color *color)
+{
+	struct t7_hdmirx *rx = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!color)
+		return -EINVAL;
+	mutex_lock(&rx->link->lock);
+	if (!rx->link->users) {
+		ret = -ENODATA;
+	} else if (!rx->dynamic_modes) {
+		/* Legacy fixed profiles do not retain complete source metadata. */
+		ret = -EOPNOTSUPP;
+	} else {
+		*color = (struct t7_hdmirx_stream_color) {
+			.depth = rx->lease_color.depth,
+			.space = rx->lease_color.space,
+			.colorimetry = rx->lease_color.colorimetry,
+			.full_range = rx->lease_color.full,
+			.hdr10 = rx->lease_hdr,
+		};
+	}
+	mutex_unlock(&rx->link->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(t7_hdmirx_get_stream_color);
+
 bool t7_hdmirx_stream_is_hdr(struct device *dev)
 {
 	struct t7_hdmirx *rx = dev_get_drvdata(dev);
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.h b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.h
index afe9fea8257e4..6efb581d900a4 100644
--- a/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.h
+++ b/drivers/media/platform/amlogic/t7-hdmirx/t7-hdmirx.h
@@ -7,6 +7,18 @@ struct v4l2_dv_timings;
 struct v4l2_fract;
 struct v4l2_edid;
 
+/* Source classification for an active dynamic stream, not the VDIN output. */
+struct t7_hdmirx_stream_color {
+	unsigned int depth;
+	unsigned int space;
+	unsigned int colorimetry;
+	bool full_range;
+	bool hdr10;
+};
+
+int t7_hdmirx_get_stream_color(struct device *dev,
+			       struct t7_hdmirx_stream_color *color);
+
 /* EDID changes are idempotent and refused while a capture lease owns DMA. */
 int t7_hdmirx_get_edid(struct device *dev, struct v4l2_edid *edid);
 int t7_hdmirx_set_edid(struct device *dev, const struct v4l2_edid *edid);
diff --git a/drivers/media/platform/amlogic/t7-hdmirx/test_stream_color.py b/drivers/media/platform/amlogic/t7-hdmirx/test_stream_color.py
new file mode 100644
index 0000000000000..a87946fc23f6c
--- /dev/null
+++ b/drivers/media/platform/amlogic/t7-hdmirx/test_stream_color.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compile the actual stream metadata function against a locked-state fixture."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+source = Path(__file__).with_name('t7-hdmirx.c').read_text()
+start = source.index('int t7_hdmirx_get_stream_color(')
+function = source[start:source.index('\nEXPORT_SYMBOL_GPL', start)]
+fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+struct link { int lock, users; };
+struct t7_hdmirx { struct link *link; bool dynamic_modes, lease_hdr;
+ struct {unsigned depth,space,colorimetry; bool full;} lease_color; };
+struct device { struct t7_hdmirx *rx; };
+struct t7_hdmirx_stream_color { unsigned depth,space,colorimetry; bool full_range,hdr10; };
+static void *dev_get_drvdata(struct device *d) {return d->rx;}
+static void mutex_lock(int *m) {assert(!*m); *m=1;}
+static void mutex_unlock(int *m) {assert(*m); *m=0;}
+/* FUNCTION */
+int main(void) {
+ struct link link={0}; struct t7_hdmirx rx={.link=&link}; struct device dev={&rx};
+ struct t7_hdmirx_stream_color out={.depth=99};
+ assert(t7_hdmirx_get_stream_color(&dev,0)==-EINVAL && !link.lock);
+ assert(t7_hdmirx_get_stream_color(&dev,&out)==-ENODATA && out.depth==99 && !link.lock);
+ link.users=1;
+ assert(t7_hdmirx_get_stream_color(&dev,&out)==-EOPNOTSUPP && out.depth==99 && !link.lock);
+ rx.dynamic_modes=true; rx.lease_hdr=true; rx.lease_color.depth=10;
+ rx.lease_color.space=3; rx.lease_color.colorimetry=2; rx.lease_color.full=true;
+ assert(!t7_hdmirx_get_stream_color(&dev,&out));
+ assert(out.depth==10 && out.space==3 && out.colorimetry==2 && out.hdr10 && out.full_range && !link.lock);
+}
+'''
+with tempfile.TemporaryDirectory() as temp:
+    c = Path(temp) / 'test.c'
+    c.write_text(fixture.replace('/* FUNCTION */', function))
+    binary = Path(temp) / 'test'
+    subprocess.run(['cc', '-Wall', '-Wextra', '-Werror', str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+print('stream metadata admission and lease snapshot: PASS')
-- 
