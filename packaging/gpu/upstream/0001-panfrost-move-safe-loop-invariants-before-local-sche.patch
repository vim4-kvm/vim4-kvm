From 60da42380826b57436e073621101f192c3514379 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:12:13 +0000
Subject: [PATCH 1/2] panfrost: move safe loop invariants before local
 scheduling

Run non-value-numbering GCM before local scheduling on Bifrost. Keep the existing restrictions on speculative and texture operations. This removes redundant ALU work from loops without increasing the unroll threshold.
---
 src/panfrost/compiler/bifrost/bifrost_nir.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/panfrost/compiler/bifrost/bifrost_nir.c b/src/panfrost/compiler/bifrost/bifrost_nir.c
index 85ebf2a..c2e232f 100644
--- a/src/panfrost/compiler/bifrost/bifrost_nir.c
+++ b/src/panfrost/compiler/bifrost/bifrost_nir.c
@@ -370,6 +370,12 @@ bi_optimize_late(nir_shader *nir, uint64_t gpu_id,
       NIR_PASS(_, nir, nir_opt_cse);
    }
 
+   /* Keep loop-invariant expressions outside loops before local scheduling.
+    * GCM retains its normal restrictions on speculative operations.
+    */
+   if (pan_arch(gpu_id) <= 7)
+      NIR_PASS(_, nir, nir_opt_gcm, false, false);
+
    /* Backend scheduler is purely local, so do some global optimizations
     * to reduce register pressure. */
    nir_move_options move_all = nir_move_const_undef | nir_move_load_ubo |
-- 
