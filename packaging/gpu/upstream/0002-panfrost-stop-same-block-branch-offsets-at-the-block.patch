From 7b6206188c2d003f79231e2b402108494df71f27 Mon Sep 17 00:00:00 2001
From: localhost-copilot <318096335+localhost-copilot@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:12:13 +0000
Subject: [PATCH 2/2] panfrost: stop same-block branch offsets at the block
 boundary

A backward branch to its own block must count earlier clauses within that block, but not any preceding blocks. Cover self branches from the first and later clauses as well as forward and cross-block backward offsets.
---
 src/panfrost/compiler/bifrost/bi_layout.c     |  3 +++
 .../compiler/bifrost/test/test-optimizer.cpp  | 26 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/src/panfrost/compiler/bifrost/bi_layout.c b/src/panfrost/compiler/bifrost/bi_layout.c
index d674eca..c3ac46c 100644
--- a/src/panfrost/compiler/bifrost/bi_layout.c
+++ b/src/panfrost/compiler/bifrost/bi_layout.c
@@ -113,6 +113,9 @@ bi_block_offset(bi_context *ctx, bi_clause *start, bi_block *target)
       /* And jump back every clause of preceding blocks up through
        * and including the target to get to the beginning of the
        * target */
+      if (target == start->block)
+         return ret;
+
       bi_foreach_block_from_rev(ctx, start->block, blk) {
          if (blk == start->block)
             continue;
diff --git a/src/panfrost/compiler/bifrost/test/test-optimizer.cpp b/src/panfrost/compiler/bifrost/test/test-optimizer.cpp
index 2bfec07..ba6a809 100644
--- a/src/panfrost/compiler/bifrost/test/test-optimizer.cpp
+++ b/src/panfrost/compiler/bifrost/test/test-optimizer.cpp
@@ -9,6 +9,32 @@
 
 #include <gtest/gtest.h>
 
+TEST(Layout, SelfBranchExcludesPrecedingBlocks)
+{
+   void *memctx = ralloc_context(NULL);
+   bi_builder *b = bit_builder(memctx);
+   bi_context *ctx = b->shader;
+   bi_block *pre = list_first_entry(&ctx->blocks, bi_block, link);
+   bi_block *loop = bit_block(ctx);
+   bi_block *after = bit_block(ctx);
+   bi_clause clauses[4] = {};
+   bi_block *blocks[] = {pre, loop, loop, after};
+   unsigned tuples[] = {4, 2, 4, 1};
+   list_inithead(&pre->clauses);
+   list_inithead(&loop->clauses);
+   list_inithead(&after->clauses);
+   for (unsigned i = 0; i < 4; ++i) {
+      clauses[i].block = blocks[i];
+      clauses[i].tuple_count = tuples[i];
+      list_addtail(&clauses[i].link, &blocks[i]->clauses);
+   }
+   EXPECT_EQ(bi_block_offset(ctx, &clauses[1], loop), 0);
+   EXPECT_EQ(bi_block_offset(ctx, &clauses[2], loop), -2);
+   EXPECT_EQ(bi_block_offset(ctx, &clauses[3], loop), -5);
+   EXPECT_EQ(bi_block_offset(ctx, &clauses[0], loop), 3);
+   ralloc_free(memctx);
+}
+
 static void
 bi_optimizer(bi_context *ctx)
 {
