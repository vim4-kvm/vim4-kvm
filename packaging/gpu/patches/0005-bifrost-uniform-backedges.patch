+TEST_F(Optimizer, BackedgeThreadingRequiresUniformControlFlow)
+{
+   for (bool uniform : {false, true}) {
+      bi_builder *b = bit_builder(mem_ctx);
+      bi_context *ctx = b->shader;
+      ctx->uniform_control_flow = uniform;
+      bi_block *header = list_first_entry(&ctx->blocks, bi_block, link);
+      bi_block *exit = bit_block(ctx);
+      bi_block *empty = bit_block(ctx);
+      bi_block *backedge = bit_block(ctx);
+      bi_block *end = bit_block(ctx);
+
+      bi_instr *cond = bi_branchz_i16(b, bi_register(0), bi_zero(), BI_CMPF_EQ);
+      cond->branch_target = empty;
+      bi_block_add_successor(header, empty);
+      bi_block_add_successor(header, exit);
+      b->cursor = bi_after_block(exit);
+      bi_jump(b, bi_zero())->branch_target = end;
+      bi_block_add_successor(exit, end);
+      bi_block_add_successor(empty, backedge);
+      b->cursor = bi_after_block(backedge);
+      bi_jump(b, bi_zero())->branch_target = header;
+      bi_block_add_successor(backedge, header);
+      b->cursor = bi_after_block(end);
+      bi_kaboom(b, bi_register(0));
+
+      ASSERT_EQ(bi_num_successors(exit), 1u);
+      ASSERT_EQ(bi_num_predecessors(backedge), 1u);
+      bi_opt_control_flow(ctx);
+      EXPECT_EQ(list_length(&ctx->blocks), uniform ? 2u : 3u);
+      if (uniform)
+         EXPECT_EQ(cond->branch_target, header);
+   }
+}
