def collect(host, directory):
    report = json.loads(ssh(host, 'sudo -n python3 -c ' + shlex.quote(COLLECT), timeout=90))
    stamp = str(time.time_ns())
    save(directory / ('collect-' + stamp + '.json'), report)
    (directory / ('dmesg-' + stamp + '.log')).write_text(report['dmesg']['output'])
    with tarfile.open(directory / ('evidence-' + stamp + '.tar.gz'), 'w:gz') as archive:
        for path in sorted(directory.iterdir()):
            if path.is_file() and not path.name.startswith('evidence-'):
                archive.add(path, arcname=path.name)
    return report


def ready(host, timeout=120, expected=None, old_boot=None, *, deadline_bound=False):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            # The snapshot endpoint only reads cached frames. With no viewer it
            # may return 503, so wait for the API here and decoded frames after
            # the receiver creates its offer. Do not deadlock before that offer.
            script = r'''import pathlib,platform,subprocess,urllib.request
assert platform.release()==EXPECTED if EXPECTED else True
assert pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()!=OLD if OLD else True
services=['vim4-kvm-gadget']
services+=['vim4-kvm-hdmi','vim4-manager']
for service in services:
 subprocess.run(['systemctl','is-active','--quiet',service],check=True)
assert any(p.read_text().strip()=='configured' for p in pathlib.Path('/sys/class/udc').glob('*/state'))
apps=[n for n in ('one-kvm','nanokvm','vim4-kvm','vim4-pikvm') if subprocess.run(['systemctl','is-active','--quiet',n]).returncode==0]
assert len(apps)==1, 'expected exactly one active KVM application'
if apps==['one-kvm']:
 stats=__import__('json').load(urllib.request.urlopen('http://127.0.0.1:8081/api/stream/status',timeout=10))
 assert 'state' in stats and 'fps' in stats
print('ready')
'''.replace('EXPECTED', repr(expected)).replace('OLD', repr(old_boot))
            ssh(host, 'sudo -n python3 -c ' + shlex.quote(script),
                timeout=max(.01, min(30, deadline-time.monotonic())) if deadline_bound else 30)
            return
        except (OSError, subprocess.SubprocessError) as exc:
            last = exc
            time.sleep(1)
    raise TimeoutError('SSH/services/UDC/One-KVM frames not ready: ' + str(last))


def verify_baseline(expected, actual):
    """Only the audited firmware reboot reason may vary across a normal reboot."""
    if any(actual.get(k) != expected.get(k) for k in ('release', 'build_id', 'files')):
        raise RuntimeError('baseline release/build ID/protected files differ')
    for key in ('loaded_modules', 'applications', 'dt_properties'):
        if key in expected and actual.get(key) != expected[key]:
            raise RuntimeError('baseline ' + key + ' differs')
    def split(command):
        tokens = command.split()
        reason = [t for t in tokens if t.startswith('reboot_mode=')]
        if len(reason) > 1:
            raise RuntimeError('duplicate reboot_mode')
        return [t for t in tokens if not t.startswith('reboot_mode=')], reason[0] if reason else None
    before, reason_before = split(expected['cmdline'])
    after, reason_after = split(actual['cmdline'])
    if before != after:
        raise RuntimeError('baseline command line differs outside reboot_mode')
    reviewed = ('reboot_mode=normal', 'reboot_mode=watchdog_reboot')
    if reason_before != reason_after and (reason_before not in reviewed or reason_after not in reviewed):
        raise RuntimeError('unreviewed reboot_mode transition')
    return dict(before=reason_before, after=reason_after)


def receiver(url, seconds, local_ip=None):
    command = ['node', str(ROOT / 'tools/board-window-receiver.mjs'), url, str(seconds)]
    if local_ip:
        command += ['--local-ip=' + local_ip]
    return json.loads(subprocess.check_output(command, text=True, timeout=seconds + 120))


def record_candidate(directory, plan, digest):
    # Recovery must remember every payload, including the one that created
    # the module mountpoint when later payloads reuse the same kernel Image.
    identity = plan['build_id']
    if 'namespace' in plan:
        identity = hashlib.sha256('/'.join((plan['namespace'], plan['payload_id'], identity)).encode()).hexdigest()
    save(directory / ('candidate-' + identity + '.json'),
         dict(plan, archive_sha256=digest))


def recorded_candidates(directory):
    """Only record_candidate's identity filenames are module cleanup inputs."""
    return [json.loads(path.read_text()) for path in sorted(directory.glob('candidate-*.json'))
            if re.fullmatch(r'candidate-(?:[0-9a-f]{40}|[0-9a-f]{64})\.json', path.name)]


def module_cleanup_script(plans, script):
    # A full 2338-module inventory exceeds Linux's per-argument exec limit.
    # Cleanup needs only the validated directory identity and module release;
    # keep the full inventory in local recovery evidence, not an SSH argument.
    identities = [{key: plan[key] for key in ('build_id', 'release', 'namespace', 'payload_id')
                   if key in plan} for plan in plans]
    return ("import importlib.util; s=importlib.util.spec_from_file_location('once',"
            + repr(script) + "); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); "
            + '[m.cleanup_module_mountpoint(p) for p in ' + repr(identities) + ']')


def validate_bundle(bundle, *, ram_baseline_control=False):
    with tarfile.open(bundle) as archive:
        plan, metadata, entries = once.read_trial(archive, ram_baseline_control=ram_baseline_control)
        for name, expected in plan['files'].items():
            if hashlib.sha256(archive.extractfile(entries[name]).read()).hexdigest() != expected:
                raise ValueError('bundle hash mismatch: ' + name)
        if not re.fullmatch('[0-9a-f]{40}', plan['build_id']):
            raise ValueError('invalid build ID')
        prefix = str(once.candidate_prefix(plan, metadata))
        with archive.extractfile(entries['Image']) as image:
            command = once.trial_boot_command(prefix, entries['Image'].size, image.read(64))
        if plan['command'] != command:
            raise ValueError('only the existing RAM sysboot command is accepted')
        return plan


def verify_ram_baseline_runtime(plan, runtime):
    prefix = str(once.candidate_prefix(plan))
    init = [token for token in runtime['cmdline'].split() if token.startswith(('init=', 'rdinit='))]
    if init != ['init=' + prefix + '/init']:
        raise RuntimeError('RAM baseline control did not boot its private init')
    if (runtime['module_root'] != prefix + '/modules/' + plan['release'] or
            'ro' not in runtime['module_options'].split(',')):
        raise RuntimeError('RAM baseline control has the wrong module bind source or permissions')


def verify_candidate_dt(host, plan, baseline_properties=None, *, ram_baseline_control=False):
    if 'ram_baseline_control' in plan or ram_baseline_control:
        if not ram_baseline_control or plan.get('ram_baseline_control') is not True:
            raise ValueError('RAM baseline control requires explicit runtime verification')
        once.validate_ram_baseline(plan, dict(release=plan['baseline_release'],
            build_id=plan['baseline_id'], files=plan['baseline_files']))
        script = """from pathlib import Path
import json
target=str(Path(TARGET).resolve())
mounts=[line.split() for line in Path('/proc/self/mountinfo').read_text().splitlines()]
matches=[entry for entry in mounts if entry[4]==target]
if len(matches)!=1: raise RuntimeError('expected one private module bind mount')
print(json.dumps(dict(cmdline=Path('/proc/cmdline').read_text(),
                     module_root=matches[0][3],module_options=matches[0][5])))
""".replace('TARGET', repr('/lib/modules/' + plan['release']))
        verify_ram_baseline_runtime(plan, json.loads(ssh_python(host, script)))
        return
    if plan.get('baseline_id') == plan['build_id'] and not plan.get('dt_properties'):
        raise ValueError('Same Image candidate requires readable DT identity')
    if plan.get('baseline_id') == plan['build_id']:
        once.validate_distinct_dt(plan['dt_properties'], baseline_properties or plan.get('baseline_dt_properties', {}))
    for name, expected in plan.get('dt_properties', {}).items():
        path = Path(name)
        if path.is_absolute() or '..' in path.parts:
            raise ValueError('Unsafe DT property path')
        script = ('from pathlib import Path; print(Path(' +
                  repr('/sys/firmware/devicetree/base/' + name) + ').read_bytes().hex())')
        if ssh(host, 'sudo -n python3 -c ' + shlex.quote(script)).strip() != expected:
            raise RuntimeError('Running candidate DT property differs: ' + name)


@contextlib.contextmanager
def continuous_uart(device, directory, *, deadline):
    """Explicit batch opt-in; keep this context through final baseline recovery."""
    require_board()
    port = load('board_uart_port', ROOT / 'tools/uart-run.py')
    recorder = load('board_uart_evidence', ROOT / 'tools/board_uart.py')
    fd = port.open_port(device, 921600)
    try:
        with recorder.ContinuousUART(fd, directory) as stream:
            stream.deadline = deadline
            yield stream
    finally:
        os.close(fd)


def boot_recorded(host, stream, plan=None, baseline_release=None):
    """The explicit continuous path; the historical boot loop stays separate."""
    def require_budget():
        if stream.deadline - time.monotonic() < 120 + (360 if plan else 0):
            raise TimeoutError('Preserve the boot slot and final recovery budget')
    require_budget()
    old_boot = ssh(host, 'cat /proc/sys/kernel/random/boot_id').strip()
    mac = ssh(host, 'cat /sys/class/net/eth0/address').strip() if plan else None
    if plan and not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', mac):
        raise ValueError('invalid baseline ethernet MAC')
    release = plan['release'] if plan else baseline_release
    require_budget()
    cursor = stream.arm(release)
    selected = interrupted = False
    tail = b''
    process = subprocess.Popen(['ssh', '-oBatchMode=yes', '-oConnectTimeout=5', host,
                                'sudo -n reboot'], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True)
    try:
        deadline = time.monotonic() + 45
        while time.monotonic() < deadline:
            cursor, data = stream.read_since(cursor, min(.1, deadline-time.monotonic()))
            tail = (tail + data)[-65536:]
            if plan and not interrupted and (b'Hit SPACE' in tail or b'autoboot' in tail):
                stream.send(b' ')
                interrupted = True
            if interrupted and not selected and (b'kvim4#' in tail or b'kvim4n#' in tail):
                stream.send(('setenv ethaddr ' + mac + '; ' + plan['command'] + '\n').encode())
                selected = True
            if stream.events.linux_started is not None:
                break
        else:
            raise TimeoutError('No selected Linux boot within 45 seconds')
        if plan and not selected:
            raise RuntimeError('RAM candidate was not selected')
        deadline = stream.events.linux_started / 1e9 + 45
        while time.monotonic() < deadline:
            stream.check()
            try:
                ready(host, timeout=min(3, deadline-time.monotonic()), expected=release,
                      old_boot=old_boot, deadline_bound=True)
            except TimeoutError:
                continue
            stream.check()
            return
        raise TimeoutError('Selected Linux did not become ready within 45 seconds')
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=3)


def boot(host, device, directory, plan=None, baseline_release=None, *, uart=None):
    if uart is not None:
        return boot_recorded(host, uart, plan, baseline_release)
    uart = load('board_uart', ROOT / 'tools/uart-run.py')
    old_boot = ssh(host, 'cat /proc/sys/kernel/random/boot_id').strip()
    mac = None
    if plan:
        mac = ssh(host, 'cat /sys/class/net/eth0/address').strip()
        if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', mac):
            raise ValueError('invalid baseline ethernet MAC')
    fd = uart.open_port(device, 921600)
    output = b''
    selected = False
    interrupted = False
    try:
        # Drain UART immediately: waiting for SSH disconnect can overflow the
        # serial buffer and lose the short autoboot prompt. Never repeat reboot.
        # Match the prompt's tail too: the USB UART can drop its first bytes.
        rebooter = subprocess.Popen(['ssh', '-oBatchMode=yes', '-oConnectTimeout=5', host,
                                    'sudo -n reboot'], stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   start_new_session=True)
        end = time.monotonic() + 60
        while time.monotonic() < end:
            if select.select([fd], [], [], .1)[0]:
                output += os.read(fd, 65536)
                if plan and not interrupted and (b'Hit SPACE' in output or b'autoboot' in output):
                    os.write(fd, b' ')
                    interrupted = True
                if interrupted and not selected and (b'kvim4#' in output[-400:] or b'kvim4n#' in output[-400:]):
                    # Match the baseline DHCP identity, as in the reviewed HDR
                    # RAM boots. This never saves the U-Boot environment.
                    os.write(fd, ('setenv ethaddr ' + mac + '; ' + plan['command'] + '\n').encode())
                    selected = True
                if b'login:' in output:
                    break
        if plan and not selected:
            raise RuntimeError('RAM candidate was not selected; inspect UART before further action')
    finally:
        if 'rebooter' in locals() and rebooter.poll() is None:
            rebooter.terminate()
            try:
                rebooter.wait(timeout=3)
            except subprocess.TimeoutExpired:
                rebooter.kill()
                rebooter.wait(timeout=3)
        os.close(fd)
        (directory / ('uart-' + str(time.time_ns()) + '.log')).write_bytes(output)
    ready(host, expected=plan['release'] if plan else baseline_release, old_boot=old_boot)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='vim4')
    parser.add_argument('--window', default=os.environ.get('BOARD_TICKET', 'readonly'))
    parser.add_argument('--device', default='/dev/cu.usbserial-100')
    commands = parser.add_subparsers(dest='action', required=True)
    p = commands.add_parser('boot-candidate')
    p.add_argument('candidate', type=Path)
    p.add_argument('--sha256', required=True, help='trusted candidate.tar SHA256')
    p.add_argument('--reuse-staged', action='store_true', help='verify and reuse the exact immutable payload')
    p.add_argument('--ram-baseline-control', action='store_true', help='explicit unchanged-package RAM control')
    p.add_argument('--baseline-files', nargs='+', help='first HDR2 payload: original baseline recovery files')
    p = commands.add_parser('return-baseline')
    p.add_argument('--video-check', nargs=argparse.REMAINDER,
                   help='Decoded-frame check command for the retained application (required for the formal baseline)')
    p = commands.add_parser('baseline')
    p.add_argument('--files', nargs='+', required=True, help='kernel, programs and all default boot files')
    p.add_argument('--dt-properties', nargs='+', default=[],
                   help='DT identity property paths to capture on the original baseline')
    p.add_argument('--settings', type=Path, help='public source/browser/codec/settings JSON included in cache key')
    p.add_argument('--url', default='http://192.168.50.210:8080')
    p.add_argument('--local-ip')
    p.add_argument('--seconds', type=float, default=10)
    p = commands.add_parser('receiver')
    p.add_argument('--url', default='http://192.168.50.210:8080')
    p.add_argument('--local-ip')
    p.add_argument('--seconds', type=float, default=10)
    p = commands.add_parser('collect')
    p.add_argument('--readonly', action='store_true')
    p = commands.add_parser('mcp')
    p.add_argument('operation', choices=['screenshot', 'idle', 'hdr'])
    p.add_argument('--url', default='http://127.0.0.1:18081/api/mcp', help='SSH-forwarded One-KVM endpoint')
    p.add_argument('--profile', type=Path)
    p.add_argument('--m6-hdr', choices=['on', 'off'], help='verified r17/r18 M6 sequence; restores source EOTF')
    p.add_argument('--menu-pixels', type=int, default=60)
    p.add_argument('--exec', dest='command', nargs=argparse.REMAINDER, default=[])
    args = parser.parse_args()
    if not re.fullmatch(r'[\w.-]+', args.window):
        raise ValueError('window must be a directory name')
    directory = ROOT / 'logs' / args.window
    directory.mkdir(parents=True, exist_ok=True)
    if args.action != 'collect' or not args.readonly:
        require_board()
    if args.action == 'collect':
        result = collect(args.host, directory)
    elif args.action == 'receiver':
        ready(args.host)
        queue, token = require_board()
        queue.sampling(token, True)
        try:
            save(directory / ('sampling-' + str(time.time_ns()) + '.json'), queue.read(token))
            result = receiver(args.url, args.seconds, args.local_ip)
        finally:
            queue.sampling(token, False)
    elif args.action == 'baseline':
        ready(args.host)
        proof = identity(args.host, args.files, dt_properties=args.dt_properties, baseline=True)
        queue, token = require_board()
        def measure():
            queue.sampling(token, True)
            try:
                save(directory / ('sampling-' + str(time.time_ns()) + '.json'), queue.read(token))
                metrics = receiver(args.url, args.seconds, args.local_ip)
                if identity(args.host, args.files, dt_properties=args.dt_properties, baseline=True) != proof:
                    raise RuntimeError('baseline identity changed during measurement')
                return metrics
            finally:
                queue.sampling(token, False)
        cache = BaselineCache(queue.root / 'baseline-cache.json')
        settings = json.loads(args.settings.read_text()) if args.settings else None
        result = cache.get(dict(proof, host=args.host, measurement=dict(url=args.url,
                           seconds=args.seconds, local_ip=args.local_ip, settings=settings)), measure)
    elif args.action == 'mcp':
        key = os.environ.get('ONEKVM_MCP_KEY')
        if not key:
            raise ValueError('set ONEKVM_MCP_KEY (never pass credentials in command arguments)')
        client = MCP(args.url, key)
        if args.operation == 'screenshot':
            result = client.screenshot(directory / ('screenshot-' + str(time.time_ns()) + '.jpg'))
        elif args.operation == 'idle':
            result = client.idle(directory, menu_pixels=args.menu_pixels)
        else:
            command = args.command[1:] if args.command[:1] == ['--'] else args.command
            if args.m6_hdr:
                client.m6_hdr(args.m6_hdr == 'on', directory, lambda: source_hdr(args.host), command)
            elif args.profile:
                client.hdr(json.loads(args.profile.read_text()), directory, command)
            else:
                raise ValueError('hdr requires --m6-hdr on/off or a reviewed --profile')
            result = dict(restored=True)
    elif args.action == 'boot-candidate':
        bundle = args.candidate / 'candidate.tar' if args.candidate.is_dir() else args.candidate
        # A payload directory is checked against the trusted archive digest only
        # when it contains the original archive. For loose files require the
        # manifest digest and validate its complete per-file inventory.
        if args.candidate.is_dir() and not bundle.exists():
            manifest = args.candidate / 'manifest.json'
            if sha(manifest) != args.sha256:
                raise ValueError('directory manifest SHA256 mismatch')
            descriptor, archive_path = tempfile.mkstemp(suffix='.tar')
            os.close(descriptor)
            bundle = Path(archive_path)
            atexit.register(bundle.unlink, missing_ok=True)
            with tarfile.open(bundle, 'w') as archive:
                for path in sorted(args.candidate.rglob('*')):
                    if path.is_file() or path.is_symlink():
                        archive.add(path, arcname=str(path.relative_to(args.candidate)), recursive=False)
            digest = sha(bundle)
        else:
            digest = args.sha256
            if sha(bundle) != digest:
                raise ValueError('archive SHA256 mismatch')
        plan = validate_bundle(bundle, ram_baseline_control=args.ram_baseline_control)
        proof_path = directory / 'baseline-proof.json'
        if proof_path.exists():
            proof = json.loads(proof_path.read_text())
        else:
            files = plan.get('baseline_files') or args.baseline_files
            if not files:
                raise ValueError('first HDR2 payload needs --baseline-files from the retained deployment inventory')
            proof = identity(args.host, list(files), dt_properties=plan.get('dt_properties', {}), baseline=True)
            # The retained proof must cover the same original running baseline
            # as prepare; a stale bundle cannot silently change the recovery target.
            if 'baseline_files' in plan and (proof['release'] != plan['baseline_release'] or
                    proof['build_id'] != plan['baseline_id'] or proof['cmdline'] != plan['baseline_cmdline']):
                raise ValueError('candidate was prepared for a different running baseline')
            save(proof_path, proof)
        if not once.supported_baseline(proof['release']):
            raise ValueError('candidate requires a 5.15 or formal baseline proof')
        verify_persistent_files(args.host, proof)
        if plan.get('baseline_files', proof['files']) != proof['files']:
            raise ValueError('default boot/runtime files differ from retained baseline')
        record_candidate(directory, plan, digest)
        remote = '/tmp/board-window-' + plan['build_id']
        ssh(args.host, 'mkdir -p ' + remote)
        subprocess.run(['scp', str(bundle), args.host + ':' + remote + '/candidate.tar'], check=True)
        subprocess.run(['scp', str(ROOT / 'packaging/kernel/display-once.py'),
                        str(once.SOURCES), args.host + ':' + remote + '/'], check=True)
        script = """import importlib.util
s=importlib.util.spec_from_file_location('once',SCRIPT)
m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
assert m.sha(BUNDLE)==DIGEST
m.stage(BUNDLE,retained_baseline=PROOF,reuse_staged=REUSE,ram_baseline_control=CONTROL)
""".replace('SCRIPT', repr(remote + '/display-once.py')).replace('BUNDLE', repr(remote + '/candidate.tar')).replace('DIGEST', repr(digest)).replace('PROOF', repr(proof)).replace('REUSE', repr(args.reuse_staged)).replace('CONTROL', repr(args.ram_baseline_control))
        ssh_python(args.host, script)
        require_board()
        boot(args.host, args.device, directory, plan)
        running = identity(args.host, [])
        if running['build_id'] != plan['build_id']:
            raise RuntimeError('running kernel build ID differs from candidate')
        verify_candidate_dt(args.host, dict(plan, baseline_id=proof['build_id']), proof.get('dt_properties', {}),
                            ram_baseline_control=args.ram_baseline_control)
        result = collect(args.host, directory)
    else:
        proof = json.loads((directory / 'baseline-proof.json').read_text())
        if not once.supported_baseline(proof['release']):
            raise ValueError('return requires a 5.15 or formal baseline proof')
        if proof['release'] == once.formal_baseline()['release'] and not args.video_check:
            raise ValueError('formal baseline return requires --video-check for the retained application')
        verify_persistent_files(args.host, proof)
        # One normal reboot only. A timeout must retain the proof and fail;
        # never hide an Ethernet/DHCP failure behind an automatic reboot loop.
        boot(args.host, args.device, directory, baseline_release=proof['release'])
        actual = identity(args.host, list(proof['files']), dt_properties=proof.get('dt_properties', {}), baseline=True)
        reasons = verify_baseline(proof, actual)
        save(directory / 'returned-baseline-identity.json', dict(identity=actual, reboot_mode=reasons))
        cleanup = '/tmp/board-window-cleanup-' + args.window
        ssh(args.host, 'mkdir -p ' + cleanup)
        subprocess.run(['scp', str(ROOT / 'packaging/kernel/display-once.py'),
                        str(once.SOURCES), args.host + ':' + cleanup + '/'], check=True, timeout=30)
        plans = recorded_candidates(directory)
        script = module_cleanup_script(plans, cleanup+'/display-once.py')
        ssh(args.host, 'sudo -n python3 -c ' + shlex.quote(script))
        if args.video_check:
            queue, token = require_board()
            queue.sampling(token, True)
            try:
                with (directory / 'returned-video.log').open('w') as log:
                    subprocess.run(args.video_check, check=True, timeout=120,
                                   stdout=log, stderr=subprocess.STDOUT)
            finally:
                queue.sampling(token, False)
        result = collect(args.host, directory)
    save(directory / (args.action + '-' + str(time.time_ns()) + '.json'), result)
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
