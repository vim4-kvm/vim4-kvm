ROOT = Path(__file__).resolve().parents[1]


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


queue_module = load('board_queue', ROOT / 'tools/board-queue')


def sha(path):
    with Path(path).open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps(value, indent=2) + '\n')
    temp.replace(path)


def ssh(host, command, timeout=30):
    return subprocess.check_output(['ssh', '-oBatchMode=yes', '-oConnectTimeout=5',
                                    host, command], timeout=timeout, text=True)


def require_board():
    queue = queue_module.Queue(os.environ.get('BOARD_QUEUE_ROOT', '/tmp/vim4-board-queue'))
    item = queue.read(os.environ.get('BOARD_TICKET'))
    if item['state'] != 'held' or item['heavy'] or time.time() >= item['started'] + item['seconds']:
        raise RuntimeError('an unexpired board ticket is required')
    return queue, item['ticket']


def identity(host, files):
    script = """import hashlib,json,pathlib,platform,struct
files=FILES
data=pathlib.Path('/sys/kernel/notes').read_bytes(); offset=0; ids=[]
while offset+12<=len(data):
 n,d,k=struct.unpack_from('<III',data,offset); offset+=12
 start=offset+((n+3)&~3)
 if data[offset:offset+n]==b'GNU\\0' and k==3: ids.append(data[start:start+d].hex())
 offset=start+((d+3)&~3)
assert len(ids)==1, 'expected one GNU kernel build ID'
print(json.dumps(dict(release=platform.release(),build_id=ids[0],cmdline=pathlib.Path('/proc/cmdline').read_text().strip(),files={p:hashlib.file_digest(open(p,'rb'),'sha256').hexdigest() for p in files})))
""".replace('FILES', repr(files))
    return json.loads(ssh(host, 'sudo -n python3 -c ' + shlex.quote(script)))


class BaselineCache:
    def __init__(self, path):
        self.path = Path(path)

    def get(self, proof, measure, day=None):
        if not proof['release'].startswith('5.15.'):
            raise ValueError('baseline measurements require running 5.15')
        day = day or datetime.date.today().isoformat()
        key = hashlib.sha256(json.dumps(proof, sort_keys=True).encode()).hexdigest()
        entries = json.loads(self.path.read_text()) if self.path.exists() else {}
        cache_key = day + ':' + key
        if cache_key in entries:
            return dict(entries[cache_key], reused=True)
        value = dict(key=key, day=day, source_time=datetime.datetime.now().astimezone().isoformat(),
                     identity=proof, metrics=measure())
        entries[cache_key] = value
        save(self.path, entries)
        return dict(value, reused=False)


class MCP:
    """A fresh initialize for each client, with bounded session recovery.

    Current One-KVM is stateless; session headers also support sessionful builds.
    Only safe read calls retry after transport failure, avoiding duplicate HID.
    """
    def __init__(self, url, key, opener=None):
        self.url, self.key = url, key
        self.opener = opener or urllib.request.urlopen
        self.session = None
        self.sequence = 0

    def rpc(self, method, params, notification=False):
        self.sequence += 1
        headers = {'Content-Type': 'application/json', 'Accept': 'application/json',
                   'Authorization': 'Bearer ' + self.key, 'MCP-Protocol-Version': '2025-06-18'}
        if self.session:
            headers['Mcp-Session-Id'] = self.session
        payload = dict(jsonrpc='2.0', method=method, params=params, id=self.sequence)
        if notification:
            payload.pop('id')
        request = urllib.request.Request(self.url, json.dumps(payload).encode(), headers)
        with self.opener(request, timeout=30) as response:
            session = response.headers.get('Mcp-Session-Id')
            if session:
                self.session = session
            if notification:
                response.read()
                return {}
            body = json.load(response)
        if body.get('error'):
            raise RuntimeError('MCP RPC error: ' + json.dumps(body['error']))
        result = body['result']
        if result.get('isError'):
            raise RuntimeError('MCP tool error: ' + json.dumps(result))
        return result

    def initialize(self):
        self.session = None
        self.rpc('initialize', dict(protocolVersion='2025-06-18', capabilities={},
                                   clientInfo=dict(name='board-window', version='1')))
        self.rpc('notifications/initialized', {}, notification=True)

    def call(self, name, arguments=None):
        # Current One-KVM is stateless and gives no restart/session signal.
        # Initializing each action also covers a restart between two HDR steps.
        self.initialize()
        try:
            return self.rpc('tools/call', dict(name=name, arguments=arguments or {}))
        except (urllib.error.URLError, TimeoutError) as exc:
            if isinstance(exc, urllib.error.HTTPError):
                exc.close()
            self.initialize()
            if name not in ('screenshot', 'zoom', 'cursor_position'):
                raise RuntimeError('MCP restarted; action outcome unknown, initialized again; inspect screenshot')
            return self.rpc('tools/call', dict(name=name, arguments=arguments or {}))

    def screenshot(self, path):
        result = self.call('screenshot')
        images = [b for b in result['content'] if b['type'] == 'image']
        if not images:
            raise RuntimeError('MCP did not return an image')
        Path(path).write_bytes(base64.b64decode(images[0]['data']))
        return result

    def idle(self, directory, seconds=2, menu_pixels=60):
        first, second = directory / 'idle-before.jpg', directory / 'idle-after.jpg'
        self.screenshot(first)
        time.sleep(seconds)
        self.screenshot(second)
        return json.loads(subprocess.check_output(['node', str(ROOT / 'tools/board-window-receiver.mjs'),
                          '--compare', str(first), str(second), str(menu_pixels)], text=True))

    def hdr(self, profile, directory, command):
        # Coordinates depend on the display arrangement. Use a reviewed profile,
        # rather than silently sending a click from a different machine's layout.
        if not profile.get('verified_source') or not profile.get('restore'):
            raise ValueError('HDR profile needs verified_source and explicit restore sequence')
        def sequence(actions):
            for action in actions:
                if 'wait' in action:
                    time.sleep(action['wait'])
                else:
                    self.call(action['name'], action.get('arguments', {}))
        self.screenshot(directory / 'hdr-before.jpg')
        try:
            sequence(profile['apply'])
            self.screenshot(directory / 'hdr-applied.jpg')
            if command:
                subprocess.run(command, check=True)
        finally:
            try:
                sequence(profile['restore'])
            finally:
                self.screenshot(directory / 'hdr-restored.jpg')

    def m6_hdr(self, enabled, directory, read_state, command):
        """r17/r18 M6: 1920x1080 screenshot, RTK UHD HDR, English Settings.

        Apple menu -> System Settings -> Displays -> scroll to bottom -> HDR.
        The bottom scroll is essential: enabling HDR adds a brightness row.
        """
        def screen(label):
            result = self.screenshot(directory / (label + '.jpg'))
            text = ' '.join(b.get('text', '') for b in result['content'])
            if not re.search(r'Screen\s+1920\s*[x×]\s*1080', text):
                raise RuntimeError('M6 recipe requires screenshot coordinates 1920x1080')
        def click(x, y):
            self.call('left_click', dict(coordinate=[x, y]))
            time.sleep(.5)
        def set_state(target):
            def known_state(deadline):
                while True:
                    try:
                        return read_state()
                    except UnknownHDRState:
                        if time.monotonic() >= deadline:
                            raise
                        time.sleep(.5)
            if known_state(time.monotonic() + 15) == target:
                return
            click(27, 13)
            click(108, 83)
            time.sleep(.5)
            click(1092, 647)
            self.call('scroll', dict(scroll_direction='down', scroll_amount=7, coordinate=[1731, 746]))
            time.sleep(.5)
            screen('m6-displays-before-toggle')
            click(1704, 540)
            end = time.monotonic() + 15
            while time.monotonic() < end:
                if known_state(end) == target:
                    click(1039, 200)
                    return
                time.sleep(.5)
            raise RuntimeError('M6 HDR toggle did not reach the requested source EOTF')
        screen('m6-before')
        original = read_state()
        if not self.idle(directory)['idle']:
            raise RuntimeError('M6 screen is changing; defer HDR input')
        try:
            set_state(enabled)
            screen('m6-applied')
            if command:
                subprocess.run(command, check=True)
        finally:
            try:
                set_state(original)
            finally:
                screen('m6-restored')


class UnknownHDRState(RuntimeError):
    """Source metadata is not currently sufficient to decide the HDR switch."""


def source_hdr(host):
    state = json.loads(ssh(host, "curl -fsS --max-time 10 http://127.0.0.1:8081/api/vim4/video"))
    eotf = state['hdr_eotf'].strip().upper()
    if re.search(r'ST2084|PQ|HDR10', eotf):
        return True
    if eotf in ('SDR', 'SDR-GAMMA', 'TRADITIONAL GAMMA - SDR LUMINANCE RANGE'):
        return False
    raise UnknownHDRState('source HDR state is unknown: ' + eotf)


COLLECT = r'''import json,pathlib,subprocess,platform
def run(*cmd):
 r=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=15)
 return dict(status=r.returncode,output=r.stdout)
def read(p):
 try:return pathlib.Path(p).read_text().strip()
 except OSError as e:return str(e)
d=run('dmesg','--color=never')
print(json.dumps(dict(release=platform.release(),boot_id=read('/proc/sys/kernel/random/boot_id'),
 dmesg=d,alerts=[s for s in d['output'].splitlines() if any(w in s.lower() for w in ('warn','bug','oops','cma'))],
 services=run('systemctl','is-active','one-kvm','vim4-kvm-gadget','vim4-kvm-hdmi'),
 udc={str(p):read(p) for p in pathlib.Path('/sys/class/udc').glob('*/state')},
 counters={p:read(p) for p in ('/proc/meminfo','/proc/interrupts','/proc/stat','/proc/sys/kernel/tainted')},
 onekvm=run('curl','--fail','--silent','--show-error','--max-time','5','http://127.0.0.1:8081/api/info'))))
'''


def collect(host, directory):
    report = json.loads(ssh(host, 'sudo -n python3 -c ' + shlex.quote(COLLECT), timeout=90))
    stamp = str(time.time_ns())
    save(directory / ('collect-' + stamp + '.json'), report)
    (directory / ('dmesg-' + stamp + '.log')).write_text(report['dmesg']['output'])
    with tarfile.open(directory / ('evidence-' + stamp + '.tar.gz'), 'w:gz') as archive:
        for path in sorted(directory.iterdir()):
            if path.is_file() and not path.name.startswith('evidence-'):
                archive.add(path, arcname=path.name)
    return report


def ready(host, timeout=120, expected=None, old_boot=None):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            # The snapshot endpoint only reads cached frames. With no viewer it
            # may return 503, so wait for the API here and decoded frames after
            # the receiver creates its offer. Do not deadlock before that offer.
            script = r'''import pathlib,platform,subprocess,urllib.request
assert platform.release()==EXPECTED if EXPECTED else True
assert pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()!=OLD if OLD else True
services=['one-kvm','vim4-kvm-gadget']
if platform.release().startswith('5.15.'):services.append('vim4-kvm-hdmi')
for service in services:
 subprocess.run(['systemctl','is-active','--quiet',service],check=True)
assert any(p.read_text().strip()=='configured' for p in pathlib.Path('/sys/class/udc').glob('*/state'))
stats=__import__('json').load(urllib.request.urlopen('http://127.0.0.1:8081/api/stream/status',timeout=10))
assert 'state' in stats and 'fps' in stats
print('ready')
'''.replace('EXPECTED', repr(expected)).replace('OLD', repr(old_boot))
            ssh(host, 'sudo -n python3 -c ' + shlex.quote(script), timeout=30)
            return
        except (OSError, subprocess.SubprocessError) as exc:
            last = exc
            time.sleep(1)
    raise TimeoutError('SSH/services/UDC/One-KVM frames not ready: ' + str(last))


def receiver(url, seconds, local_ip=None):
    command = ['node', str(ROOT / 'tools/board-window-receiver.mjs'), url, str(seconds)]
    if local_ip:
        command += ['--local-ip=' + local_ip]
    return json.loads(subprocess.check_output(command, text=True, timeout=seconds + 120))


def record_candidate(directory, plan, digest):
    # Recovery must remember every payload, including the one that created
    # the module mountpoint when later payloads reuse the same kernel Image.
    identity = plan['build_id']
    if 'namespace' in plan:
        identity = plan['namespace'] + '-' + plan['payload_id'] + '-' + identity
    save(directory / ('candidate-' + identity + '.json'),
         dict(plan, archive_sha256=digest))


def validate_bundle(bundle):
    once = load('display_once', ROOT / 'packaging/kernel-edge/display-once.py')
    with tarfile.open(bundle) as archive:
        plan, metadata, entries = once.read_trial(archive)
        for name, expected in plan['files'].items():
            if hashlib.sha256(archive.extractfile(entries[name]).read()).hexdigest() != expected:
                raise ValueError('bundle hash mismatch: ' + name)
        if not re.fullmatch('[0-9a-f]{40}', plan['build_id']):
            raise ValueError('invalid build ID')
        prefix = str(once.candidate_prefix(plan, metadata))
        command = 'sysboot mmc 1:2 any ${pxefile_addr_r} ' + prefix + '/extlinux.conf; reset'
        if plan['command'] != command:
            raise ValueError('only the existing RAM sysboot command is accepted')
        return plan


def boot(host, device, directory, plan=None):
    uart = load('board_uart', ROOT / 'tools/uart-run.py')
    old_boot = ssh(host, 'cat /proc/sys/kernel/random/boot_id').strip()
    mac = None
    if plan:
        mac = ssh(host, 'cat /sys/class/net/eth0/address').strip()
        if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', mac):
            raise ValueError('invalid baseline ethernet MAC')
    fd = uart.open_port(device, 921600)
    output = b''
    selected = False
    interrupted = False
    try:
        # Drain UART immediately: waiting for SSH disconnect can overflow the
        # serial buffer and lose the short autoboot prompt. Never repeat reboot.
        rebooter = subprocess.Popen(['ssh', '-oBatchMode=yes', '-oConnectTimeout=5', host,
                                    'sudo -n reboot'], stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   start_new_session=True)
        end = time.monotonic() + 60
        while time.monotonic() < end:
            if select.select([fd], [], [], .1)[0]:
                output += os.read(fd, 65536)
                if plan and not interrupted and (b'Hit SPACE' in output or b'Hit any key to stop autoboot' in output):
                    os.write(fd, b' ')
                    interrupted = True
                if interrupted and not selected and (b'kvim4#' in output[-400:] or b'kvim4n#' in output[-400:]):
                    # Match the baseline DHCP identity, as in the reviewed HDR
                    # RAM boots. This never saves the U-Boot environment.
                    os.write(fd, ('setenv ethaddr ' + mac + '; ' + plan['command'] + '\n').encode())
                    selected = True
                if b'login:' in output:
                    break
        if plan and not selected:
            raise RuntimeError('RAM candidate was not selected; inspect UART before further action')
    finally:
        if 'rebooter' in locals() and rebooter.poll() is None:
            rebooter.terminate()
            try:
                rebooter.wait(timeout=3)
            except subprocess.TimeoutExpired:
                rebooter.kill()
                rebooter.wait(timeout=3)
        os.close(fd)
        (directory / ('uart-' + str(time.time_ns()) + '.log')).write_bytes(output)
    ready(host, expected=plan['release'] if plan else None, old_boot=old_boot)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='vim4')
    parser.add_argument('--window', default=os.environ.get('BOARD_TICKET', 'readonly'))
    parser.add_argument('--device', default='/dev/cu.usbserial-100')
    commands = parser.add_subparsers(dest='action', required=True)
    p = commands.add_parser('boot-candidate')
    p.add_argument('candidate', type=Path)
    p.add_argument('--sha256', required=True, help='trusted candidate.tar SHA256')
    p.add_argument('--baseline-files', nargs='+', help='first HDR2 payload: original 5.15 recovery files')
    commands.add_parser('return-baseline')
    p = commands.add_parser('baseline')
    p.add_argument('--files', nargs='+', required=True, help='kernel, programs and all default boot files')
    p.add_argument('--url', default='http://192.168.50.210:8080')
    p.add_argument('--local-ip')
    p.add_argument('--seconds', type=float, default=10)
    p = commands.add_parser('receiver')
    p.add_argument('--url', default='http://192.168.50.210:8080')
    p.add_argument('--local-ip')
    p.add_argument('--seconds', type=float, default=10)
    p = commands.add_parser('collect')
    p.add_argument('--readonly', action='store_true')
    p = commands.add_parser('mcp')
    p.add_argument('operation', choices=['screenshot', 'idle', 'hdr'])
    p.add_argument('--url', default='http://127.0.0.1:18081/api/mcp', help='SSH-forwarded One-KVM endpoint')
    p.add_argument('--profile', type=Path)
    p.add_argument('--m6-hdr', choices=['on', 'off'], help='verified r17/r18 M6 sequence; restores source EOTF')
    p.add_argument('--menu-pixels', type=int, default=60)
    p.add_argument('--exec', dest='command', nargs=argparse.REMAINDER, default=[])
    args = parser.parse_args()
    if not re.fullmatch(r'[\w.-]+', args.window):
        raise ValueError('window must be a directory name')
    directory = ROOT / 'logs' / args.window
    directory.mkdir(parents=True, exist_ok=True)
    if args.action != 'collect' or not args.readonly:
        require_board()
    if args.action == 'collect':
        result = collect(args.host, directory)
    elif args.action == 'receiver':
        ready(args.host)
        queue, token = require_board()
        queue.sampling(token, True)
        try:
            result = receiver(args.url, args.seconds, args.local_ip)
        finally:
            queue.sampling(token, False)
    elif args.action == 'baseline':
        ready(args.host)
        proof = identity(args.host, args.files)
        queue, token = require_board()
        def measure():
            queue.sampling(token, True)
            try:
                metrics = receiver(args.url, args.seconds, args.local_ip)
                if identity(args.host, args.files) != proof:
                    raise RuntimeError('baseline identity changed during measurement')
                return metrics
            finally:
                queue.sampling(token, False)
        cache = BaselineCache(queue.root / 'baseline-cache.json')
        result = cache.get(dict(proof, host=args.host, measurement=dict(url=args.url,
                           seconds=args.seconds, local_ip=args.local_ip)), measure)
    elif args.action == 'mcp':
        key = os.environ.get('ONEKVM_MCP_KEY')
        if not key:
            raise ValueError('set ONEKVM_MCP_KEY (never pass credentials in command arguments)')
        client = MCP(args.url, key)
        if args.operation == 'screenshot':
            result = client.screenshot(directory / ('screenshot-' + str(time.time_ns()) + '.jpg'))
        elif args.operation == 'idle':
            result = client.idle(directory, menu_pixels=args.menu_pixels)
        else:
            command = args.command[1:] if args.command[:1] == ['--'] else args.command
            if args.m6_hdr:
                client.m6_hdr(args.m6_hdr == 'on', directory, lambda: source_hdr(args.host), command)
            elif args.profile:
                client.hdr(json.loads(args.profile.read_text()), directory, command)
            else:
                raise ValueError('hdr requires --m6-hdr on/off or a reviewed --profile')
            result = dict(restored=True)
    elif args.action == 'boot-candidate':
        bundle = args.candidate / 'candidate.tar' if args.candidate.is_dir() else args.candidate
        # A payload directory is checked against the trusted archive digest only
        # when it contains the original archive. For loose files require the
        # manifest digest and validate its complete per-file inventory.
        if args.candidate.is_dir() and not bundle.exists():
            manifest = args.candidate / 'manifest.json'
            if sha(manifest) != args.sha256:
                raise ValueError('directory manifest SHA256 mismatch')
            descriptor, archive_path = tempfile.mkstemp(suffix='.tar')
            os.close(descriptor)
            bundle = Path(archive_path)
            atexit.register(bundle.unlink, missing_ok=True)
            with tarfile.open(bundle, 'w') as archive:
                for path in sorted(args.candidate.rglob('*')):
                    if path.is_file() or path.is_symlink():
                        archive.add(path, arcname=str(path.relative_to(args.candidate)), recursive=False)
            digest = sha(bundle)
        else:
            digest = args.sha256
        if sha(bundle) != digest:
            raise ValueError('archive SHA256 mismatch')
        plan = validate_bundle(bundle)
        proof_path = directory / 'baseline-proof.json'
        if proof_path.exists():
            proof = json.loads(proof_path.read_text())
        else:
            files = plan.get('baseline_files') or args.baseline_files
            if not files:
                raise ValueError('first HDR2 payload needs --baseline-files from the 5.15 deployment inventory')
            proof = identity(args.host, list(files))
            if not proof['release'].startswith('5.15.'):
                raise ValueError('first candidate requires a running 5.15 baseline')
            # The retained proof must cover the same original running baseline
            # as prepare; a stale bundle cannot silently change the recovery target.
            if 'baseline_files' in plan and (proof['release'] != plan['baseline_release'] or
                    proof['build_id'] != plan['baseline_id'] or proof['cmdline'] != plan['baseline_cmdline']):
                raise ValueError('candidate was prepared for a different running baseline')
            save(proof_path, proof)
        if identity(args.host, list(proof['files']))['files'] != proof['files'] or plan.get('baseline_files', proof['files']) != proof['files']:
            raise ValueError('default boot/runtime files differ from retained baseline')
        record_candidate(directory, plan, digest)
        remote = '/tmp/board-window-' + plan['build_id']
        subprocess.run(['scp', str(bundle), args.host + ':' + remote + '.tar'], check=True)
        subprocess.run(['scp', str(ROOT / 'packaging/kernel-edge/display-once.py'),
                        args.host + ':' + remote + '.py'], check=True)
        script = """import importlib.util
s=importlib.util.spec_from_file_location('once',SCRIPT)
m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
assert m.sha(BUNDLE)==DIGEST
m.stage(BUNDLE,retained_baseline=PROOF)
""".replace('SCRIPT', repr(remote + '.py')).replace('BUNDLE', repr(remote + '.tar')).replace('DIGEST', repr(digest)).replace('PROOF', repr(proof))
        ssh(args.host, 'sudo -n python3 -c ' + shlex.quote(script), timeout=180)
        require_board()
        boot(args.host, args.device, directory, plan)
        running = identity(args.host, [])
        if running['build_id'] != plan['build_id']:
            raise RuntimeError('running kernel build ID differs from candidate')
        result = collect(args.host, directory)
    else:
        proof = json.loads((directory / 'baseline-proof.json').read_text())
        if identity(args.host, list(proof['files']))['files'] != proof['files']:
            raise ValueError('default files changed; refuse automatic reboot')
        boot(args.host, args.device, directory)
        if identity(args.host, list(proof['files'])) != proof:
            raise RuntimeError('baseline release or boot-file verification failed')
        cleanup = '/tmp/board-window-cleanup.py'
        subprocess.run(['scp', str(ROOT / 'packaging/kernel-edge/display-once.py'),
                        args.host + ':' + cleanup], check=True)
        plans = [json.loads(path.read_text()) for path in directory.glob('candidate-*.json')]
        script = ("import importlib.util; s=importlib.util.spec_from_file_location('once',"
                  + repr(cleanup) + "); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); "
                  + '[m.cleanup_module_mountpoint(p) for p in ' + repr(plans) + ']')
        ssh(args.host, 'sudo -n python3 -c ' + shlex.quote(script))
        result = collect(args.host, directory)
    save(directory / (args.action + '-' + str(time.time_ns()) + '.json'), result)
    print(json.dumps(result, indent=2))


