# On VIM4, steer protocol processing to a performance core so the BCM43752
# SDIO worker can drain the next batch. CPU0 also handles the MMC interrupt.
ACTION=="add", SUBSYSTEM=="net", ENV{DEVTYPE}=="wlan", KERNEL=="wlan0", DRIVERS=="brcmfmac", ATTRS{vendor}=="0x02d0", ATTRS{device}=="0xaae8", ATTR{queues/rx-0/rps_cpus}=="00", ATTR{queues/rx-0/rps_cpus}="04"
