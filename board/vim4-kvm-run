#!/bin/sh
# Kernel-specific hardware and caches; application state stays in its usual home.
set -eu
app=${1:-}
case "$app" in
    nanokvm) state=/var/lib/vim4-nanokvm ;;
    jetkvm) state=/var/lib/jetkvm ;;
    onekvm) state=/var/lib/one-kvm ;;
    pikvm) state=/var/lib/kvmd ;;
    *) echo 'Unknown VIM4 KVM application' >&2; exit 2 ;;
esac
case "$(uname -r)" in
    7.3.1-vim4kvm-uhd7+) kernel_uhd7=1 ;;
    *) kernel_uhd7=0 ;;
esac
case "$(uname -r)" in
    5.15.*)
        export VIM4_VIDEO_BACKEND=vendor
        export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
        export GST_REGISTRY="$state/gstreamer-vendor-registry.bin"
        # GE2D and the vendor encoder import NV21 as one physical allocation.
        # Prefer the private V4L2 plugin's single-plane export for every app.
        export GST_V4L2_PREFER_CONTIGUOUS=1
        if [ -r /usr/lib/vim4-kvm/gpu/mali.json ]; then
            export VK_ICD_FILENAMES=/usr/lib/vim4-kvm/gpu/mali.json
        fi
        if [ -r /sys/module/aml_media/parameters/vdin0_native_hdr ] &&
            [ "$(cat /sys/module/aml_media/parameters/vdin0_native_hdr)" = Y ]; then
            export VIM4_SECONDARY_HDMI_CAPTURE=1
            export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/vendor-gstreamer-1.0:$GST_PLUGIN_PATH
            test -r /usr/lib/vim4-kvm/vendor-gstreamer-1.0/libgstvideo4linux2.so
        else
            unset VIM4_SECONDARY_HDMI_CAPTURE
        fi
        if [ "$app" = onekvm ]; then
            export LD_LIBRARY_PATH=/opt/vim4-onekvm/lib
            if [ -r /sys/module/aml_media/parameters/vdin0_native_hdr ] &&
                [ "$(cat /sys/module/aml_media/parameters/vdin0_native_hdr)" = Y ]; then
                export VIM4_SECONDARY_HDMI_CAPTURE=1
                export GST_PLUGIN_PATH=/opt/vim4-onekvm/lib/gstreamer-1.0:$GST_PLUGIN_PATH
                test -r /opt/vim4-onekvm/lib/gstreamer-1.0/libgstvideo4linux2.so
            fi
        fi
        ;;
    7.3.1-vim4kvm-uhd7+|7.3.0-rc7-vim4kvm-uhd1+|7.3.0-vim4kvm-uhd1+|7.3.0-vim4kvm-uhd2+|7.3.0-vim4kvm-uhd2-nodebug+|7.3.0-vim4kvm-uhd3+|7.3.0-vim4kvm-uhd4+|7.3.0-vim4kvm-uhd5+|7.3.0-vim4kvm-uhd[67]+|7.3.0-vim4kvm-npu1+|7.3.0-vim4kvm-npu2+|7.3.0-vim4kvm-npu3+|7.3.0-vim4kvm-npu4+)
        export VIM4_VIDEO_BACKEND=wave5
        export VIM4_SHARED_DATA=1
        export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/mainline-gstreamer-1.0
        export GST_REGISTRY="$state/gstreamer-mainline-registry.bin"
        unset VIM4_SECONDARY_HDMI_CAPTURE
        # Wave5 imports separate plane views. The vendor allocation preference
        # would make the V4L2 encoder expect one contiguous DMA-buf instead.
        unset GST_V4L2_PREFER_CONTIGUOUS
        unset LD_LIBRARY_PATH
        unset VK_ICD_FILENAMES
        unset VK_DRIVER_FILES OCL_ICD_VENDORS LD_PRELOAD
        unset __EGL_VENDOR_LIBRARY_FILENAMES LIBGL_DRIVERS_PATH
        # Match the validated mainline runtime's higher-capacity CPU group.
        taskset -pc 0-3 "$$" >/dev/null
        ;;
    *) echo 'No validated VIM4 application backend for this kernel' >&2; exit 1 ;;
esac
# GStreamer caches device-specific V4L2 factories. Rediscover after a reboot,
# driver update or app switch; do not delete another running application's cache.
rm -f "$GST_REGISTRY"
run_app() {
    # Video stays on Wave5; GPU userspace follows the bound GPU driver.
    if [ "$VIM4_VIDEO_BACKEND" = wave5 ]; then
        driver=$(readlink /sys/bus/platform/devices/fe400000.gpu/driver 2>/dev/null || true)
        if [ "${driver##*/}" = mali ]; then
            exec /usr/bin/python3 /usr/lib/vim4-kvm/python/vim4gpu.py --graphics direct -- "$@"
        fi
        if [ "${driver##*/}" = panfrost ] && { [ "$kernel_uhd7" = 1 ] || [ "$(uname -r)" = '7.3.0-vim4kvm-uhd6+' ] || [ "$(uname -r)" = '7.3.0-vim4kvm-uhd7+' ]; }; then
            # Native AMLY conversion was accepted with this private PanVK.
            for icd in /opt/vim4-mesa-26.2.6/share/vulkan/icd.d/*panfrost*.json; do
                if [ -r "$icd" ]; then
                    export VK_DRIVER_FILES="$icd"
                    export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
                    break
                fi
            done
            test -n "${VK_DRIVER_FILES:-}" || {
                echo 'Qualified private PanVK ICD is missing' >&2
                exit 1
            }
        fi
    fi
    exec "$@"
}
case "$app" in
    nanokvm) run_app /opt/vim4-nanokvm/NanoKVM-Server ;;
    jetkvm) run_app /opt/vim4-jetkvm/jetkvm ;;
    onekvm)
        binary=/opt/vim4-onekvm/one-kvm
        if { [ "$kernel_uhd7" = 1 ] || [ "$(uname -r)" = '7.3.0-vim4kvm-uhd6+' ] || [ "$(uname -r)" = '7.3.0-vim4kvm-uhd7+' ]; }; then
            binary=/opt/vim4-onekvm-edge/one-kvm
        fi
        run_app "$binary" --data-dir "$state" --address 127.0.0.1 --port 8081 --auth-mode managed
        ;;
    pikvm) run_app /usr/libexec/vim4-pikvm-run ;;
esac
