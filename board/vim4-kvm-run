#!/bin/sh
# Kernel-specific hardware and caches; application state stays in its usual home.
set -eu
app=${1:-}
case "$app" in
    nanokvm) state=/var/lib/vim4-nanokvm ;;
    jetkvm) state=/var/lib/jetkvm ;;
    onekvm) state=/var/lib/one-kvm ;;
    pikvm) state=/var/lib/kvmd ;;
    *) echo 'Unknown VIM4 KVM application' >&2; exit 2 ;;
esac
case "$(uname -r)" in
    5.15.*)
        export VIM4_VIDEO_BACKEND=vendor
        export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
        export GST_REGISTRY="$state/gstreamer-vendor-registry.bin"
        if [ "$app" = onekvm ]; then
            export LD_LIBRARY_PATH=/opt/vim4-onekvm/lib
        fi
        ;;
    7.3.0-rc7-vim4kvm-uhd1+)
        export VIM4_VIDEO_BACKEND=wave5
        export VIM4_SHARED_DATA=1
        export GST_PLUGIN_PATH=/usr/lib/vim4-kvm/mainline-gstreamer-1.0
        export GST_REGISTRY="$state/gstreamer-mainline-registry.bin"
        unset LD_LIBRARY_PATH
        # Match the validated mainline runtime's higher-capacity CPU group.
        taskset -pc 0-3 "$$" >/dev/null
        ;;
    *) echo 'No validated VIM4 application backend for this kernel' >&2; exit 1 ;;
esac
# GStreamer caches device-specific V4L2 factories. Rediscover after a reboot,
# driver update or app switch; do not delete another running application's cache.
rm -f "$GST_REGISTRY"
case "$app" in
    nanokvm) exec /opt/vim4-nanokvm/NanoKVM-Server ;;
    jetkvm) exec /opt/vim4-jetkvm/jetkvm ;;
    onekvm) exec /opt/vim4-onekvm/one-kvm --data-dir "$state" --address 127.0.0.1 --port 8081 --auth-mode managed ;;
    pikvm) exec /usr/libexec/vim4-pikvm-run ;;
esac
