[Unit]
Description=vim4-kvm USB gadget (HID, NCM and image media functions)
After=sys-kernel-config.mount
Conflicts=usb-gadget-khadas.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/vim4-board-runtime gadget-start
ExecStop=/usr/libexec/vim4-board-runtime gadget-stop

[Install]
WantedBy=multi-user.target
