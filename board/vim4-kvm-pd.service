[Unit]
Description=VIM4 USB-capable PD contract at boot
Requires=vim4-kvm-gadget.service
After=vim4-kvm-gadget.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vim4-board-runtime pd
RemainAfterExit=yes
TimeoutStartSec=30
# No automatic retry: a negotiation error must not become a power-reset loop.
Restart=no

[Install]
WantedBy=multi-user.target
